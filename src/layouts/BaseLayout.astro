---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import SEO from '../components/SEO.astro'
import MobileMenu from '../components/MobileMenu.astro'
import { navItems, footerItems, socialItems } from '../lib/nav'
import '../styles/global.css'
import Logo from '../components/Logo.astro'

interface Props {
  title: string
  description: string
  /**
   * Share image. A public/ path (string) is used as-is; an imported asset
   * is rendered to a 1200×630 JPEG at build time — the crop every network
   * expects — so a page can hand over its own hero/thumbnail import rather
   * than exporting a second, share-sized copy of it. Pages without a natural
   * image of their own fall back to /og-default.jpg in SEO.astro.
   */
  ogImage?: string | ImageMetadata
  noindex?: boolean
  /**
   * Homepage renders its own nav overlaid transparently on the pinned Hero
   * (per the shader-hero spec) instead of the default bordered header bar —
   * set true there and let the page's own component render the nav.
   */
  hideHeader?: boolean
  /**
   * Canvas (light grey) body background + the header divider line — the
   * treatment every existing hideHeader marketing page (Home, Agency,
   * Systems, Projects) opts into. Plain content pages (legal text, 404)
   * default to a white canvas with no divider instead — set true here to
   * opt back in. The footer no longer takes a rule either way.
   */
  bordered?: boolean
}

const { title, description, ogImage, noindex, hideHeader = false, bordered = false } = Astro.props

const ogImageUrl =
  ogImage && typeof ogImage !== 'string'
    ? (await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src
    : ogImage
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /* First thing in <head>, blocking, so it lands before any stylesheet
         is applied: the `data-anim` pre-hide in global.css only exists under
         html.js, and this is the only place that class is set. No JS, no
         class, no pre-hide — see motion.ts rule 1. */
    }
    <script is:inline>document.documentElement.classList.add('js')</script>
    {
      /* No cross-document view transitions here (parked-decisions §30). The
         browser's own page-to-page fade was removed because it paints the
         incoming page from a snapshot taken before the GSAP entrance can
         exist, which put its choreography and this site's in a race neither
         could win. Navigation still feels instant without it: §28's
         `prefetch` + `experimental.clientPrerender` in astro.config.mjs
         already prerenders the link being hovered, so the destination is
         painted before the click lands — and what the visitor then sees is
         the page's own entrance rather than a second one competing with it.
         Nothing to emit here; the config does it. */
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link
      rel="preload"
      href="/fonts/Aeonik-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Aeonik-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SEO title={title} description={description} ogImage={ogImageUrl} noindex={noindex} />

    {
      /*
        Cloudflare Web Analytics — pageviews only, no custom events (lead
        measurement is the /contact/thank-you pattern, built in Phase 3).
        Token depends on the Cloudflare Pages project, which isn't wired up
        yet. Uncomment once PUBLIC_CF_BEACON_TOKEN is set.
      */
    }
    {
      import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
        />
      )
    }
  </head>
  <body class={`min-h-screen text-ink ${bordered ? 'bg-canvas' : 'bg-surface'}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent-default focus:px-4 focus:py-2 focus:text-on-accent"
    >
      Skip to content
    </a>

    {
      !hideHeader && (
        <header class={`relative ${bordered ? 'border-b border-line-subtle' : ''}`}>
          <div class="flex items-start justify-between gap-6 px-[var(--space-gutter)] pb-5 pt-[var(--space-gutter)]">
            <a href="/" class="shrink-0">
              <Logo class="h-[var(--nav-logo-h)] w-auto" />
            </a>
            <nav aria-label="Primary">
              <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
                {navItems.map((item) => (
                  <li>
                    <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <button
              type="button"
              aria-label="Open menu"
              aria-expanded="false"
              aria-controls="mobile-menu"
              class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
              data-nav-toggle
            >
              Menu
            </button>
          </div>
        </header>
      )
    }

    <MobileMenu />

    {
      /* Carries the page background itself rather than inheriting <body>'s:
         it's the opaque sheet that slides over the pinned footer, so any
         gap between sections would otherwise show the footer through. */
    }
    <main id="main" class={`relative z-[1] ${bordered ? 'bg-canvas' : 'bg-surface'}`}>
      <slot />
    </main>

    {
      /* No top border, on any page: the footer is revealed from behind the
         last section (see the reveal below), so a rule along its top edge
         would read as a seam rather than a divider. `bordered` still drives
         the header rule and the canvas background. */
    }
    <footer class="bg-surface" data-footer-reveal>
      {
        /* Full-bleed with the fluid gutter and --space-section-y, the same
           vertical measure every <section> on the site uses — no max-width
           cap, so the footer columns line up with the section content above
           them. */
      }
      <div
        class="flex flex-col gap-16 px-[var(--space-gutter)] py-[var(--space-section-y)] lg:gap-[7.5rem]"
        data-footer-inner
      >
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {
            /* One flat palette across the whole footer: body copy and the
               nav/legal links in neutral-900 at regular weight, contact +
               social links in accent-600. Interactive items fade to 40%
               opacity on hover rather than shifting hue — the same gesture
               works on both the dark and the accent text. */
          }
          <nav aria-label="Footer">
            <ul class="flex flex-col gap-2">
              {
                footerItems.map((item) => (
                  <li>
                    <a href={item.href} class="text-body text-neutral-900 transition-opacity hover:opacity-40">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <address class="not-italic text-body text-neutral-900">
            <p class="font-medium">Virtual address</p>
            <p>Av. Vasco da Gama, 774</p>
            <p>4430-247 Vila Nova de Gaia</p>
            <p>Portugal</p>
            {
              /* inline-block + py-1 on these two only. At the footer's 17px
                 body size a bare inline link is a 19px-tall target, which
                 WCAG 2.5.8 accepts when there's spacing around it — and
                 every other link in this footer has 13px between it and its
                 neighbour, so 19 + 13 clears the 24px the rule asks for.
                 These two are adjacent block <p>s with NOTHING between
                 them: two 19px targets touching, where a tap on the seam is
                 a coin flip between opening a mail client and placing a
                 phone call. Growing the boxes to 27px satisfies the rule on
                 size alone, which doesn't depend on whatever ends up
                 rendered next to them later.

                 py-1, not a margin on the second <p>: padding grows the hit
                 area itself. Margin would only separate two targets that
                 are still too small, and would push the "regular cost" note
                 away from the number it explains. */
            }
            <p class="mt-4">
              <a
                href="mailto:hello@fesagency.pt"
                class="inline-block py-1 text-accent-600 transition-opacity hover:opacity-40"
              >
                hello@fesagency.pt
              </a>
            </p>
            <p>
              <a
                href="tel:+351913663577"
                class="inline-block py-1 text-accent-600 transition-opacity hover:opacity-40"
              >
                00351 913 663 577
              </a>
            </p>
            <p class="mt-1 text-body-sm">Portuguese number with regular cost</p>
            <p class="mt-4 text-body-sm text-neutral-600" data-partner-line>
              <span class="transition-opacity" data-partner-text>Communication Partner of </span><a
                href="https://www.startupbraga.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-900 transition-opacity"
                data-partner-link
              >Startup Braga</a><span class="transition-opacity" data-partner-text> and </span><a
                href="https://portotechhub.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-900 transition-opacity"
                data-partner-link
              >Porto Tech Hub</a>
            </p>
          </address>

          <ul class="flex flex-col items-start gap-2 lg:items-end">
            {
              socialItems.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-body text-accent-600 transition-opacity hover:opacity-40"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          /* Three groups side by side don't fit until well past `sm` — they
             stay stacked to lg rather than crowding at ~640px. */
        }
        <div class="flex flex-col gap-6 border-t border-line-subtle pt-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex items-center gap-2 text-body text-neutral-900">
            <span>© {new Date().getFullYear()} FES Agency</span>
            {
              /* Current locale only. This used to read "EN / PT" with the
                 inactive half at 40% opacity, which measured 2.37:1 against
                 the footer's white — an axe failure on all 21 pages — while
                 pointing at a PT translation that doesn't exist. Dropped
                 rather than recoloured: a disabled-looking label for a
                 locale you can't reach is a promise the site doesn't keep,
                 and the contrast question only exists because of it.

                 Restore the pair when PT lands, as a real switcher (two
                 links, the inactive one at a colour that passes 4.5:1 —
                 neutral-500 or darker, not an opacity). */
            }
            <span class="uppercase">en</span>
          </div>
          <div class="flex items-center gap-6 text-body">
            <a href="/privacy-policy/" class="text-neutral-900 transition-opacity hover:opacity-40">Privacy Policy</a>
            <a href="/cookies-policy/" class="text-neutral-900 transition-opacity hover:opacity-40">Cookies Policy</a>
          </div>
          <button
            type="button"
            data-back-to-top
            class="text-left text-body text-neutral-900 transition-opacity hover:opacity-40 lg:text-right"
          >
            back to top
          </button>
        </div>
      </div>
    </footer>

    <style>
      /*
        Footer reveal. The footer is pinned to the bottom of the viewport for
        the whole scroll (its sticky containing block is <body>, so it can be
        shifted up as far as the top of the page and only releases when the
        document runs out). <main> is opaque and one layer above, so the
        footer stays hidden behind it and is uncovered from the bottom up as
        the last section leaves the screen — no spacer needed, the footer's
        own height in flow IS the reveal distance.

        --footer-reveal (0 → 1) is written by the script below. It defaults
        to 1 so that with JS disabled the footer renders at its normal
        brightness rather than being stuck under the dark overlay.
      */
      footer {
        --footer-reveal: 1;
      }

      footer[data-reveal='on'] {
        position: sticky;
        bottom: 0;
        z-index: 0;
      }

      /* Dimming layer rather than filter: brightness() on the footer itself —
         a filter would repaint the whole subtree every frame and drop text
         off subpixel antialiasing. Caps at 85% so the footer reads as
         shadowed rather than as a black bar on the way in. */
      footer[data-reveal='on']::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: var(--color-neutral-950);
        opacity: calc((1 - var(--footer-reveal)) * 0.85);
      }

      /* The parallax proper: footer content drifts up slightly slower than
         the page sliding off above it, which is what sells "this was already
         behind there" instead of a wipe. */
      footer[data-reveal='on'] [data-footer-inner] {
        transform: translateY(calc((1 - var(--footer-reveal)) * -6%));
      }

      /* Partner line: hovering (or focusing) either link dims the rest of
         the sentence — the other words AND the other link — to 40%, leaving
         the one being pointed at at full strength. `:has()` rather than a
         JS class toggle, matching the same spotlight pattern used by the
         selected-projects rotator. */
      [data-partner-line]:has([data-partner-link]:hover, [data-partner-link]:focus-visible)
        [data-partner-text],
      [data-partner-line]:has([data-partner-link]:hover, [data-partner-link]:focus-visible)
        [data-partner-link]:not(:hover):not(:focus-visible) {
        opacity: 0.4;
      }
    </style>

    <script>
      import { onPageLoad, onPageUnload, type LoadContext } from '../lib/lifecycle'
      // Site-wide, because the `data-anim` attributes it drives are authored
      // on every page, not just the homepage.
      import { initMotion } from '../lib/motion'
      // Side-effect only: registers its own onPageLoad/onPageUnload
      // pair (see the module itself) — imported here so it runs on every
      // page rather than needing every page to remember to import it.
      import { getLenis } from '../lib/lenis'

      let backToTopHandler: (() => void) | null = null

      function setupBackToTop() {
        const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]')
        if (!button) return

        function onClick() {
          // Routed through Lenis, not native `scrollTo({behavior:'smooth'})`
          // — with Lenis active, the two would fight over the same scroll
          // position every frame. Falls back to native smooth scroll if
          // Lenis hasn't initialized (or failed to) for any reason.
          const lenis = getLenis()
          if (lenis) lenis.scrollTo(0)
          else window.scrollTo({ top: 0, behavior: 'smooth' })
        }

        button.addEventListener('click', onClick)
        backToTopHandler = () => button.removeEventListener('click', onClick)
      }

      function teardownBackToTop() {
        backToTopHandler?.()
        backToTopHandler = null
      }

      let footerRevealCleanup: (() => void) | null = null

      function setupFooterReveal() {
        const footer = document.querySelector<HTMLElement>('[data-footer-reveal]')
        const main = document.querySelector<HTMLElement>('#main')
        if (!footer || !main) return

        // Scroll-position-driven rather than autonomous, so the reveal itself
        // stays on under reduced motion — only the darkening and the drift
        // are dropped by holding progress at 1.
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        let frame = 0

        function update() {
          frame = 0

          // A footer taller than the viewport can't be pinned to the bottom:
          // sticky would park its top permanently above the viewport, where
          // <main> covers it, and that content would never become reachable.
          // Happens on mobile, where the three columns stack — those widths
          // fall back to the plain in-flow footer.
          if (footer!.offsetHeight > window.innerHeight) {
            footer!.dataset.reveal = 'off'
            footer!.style.removeProperty('--footer-reveal')
            return
          }

          footer!.dataset.reveal = 'on'
          if (reduceMotion) {
            footer!.style.setProperty('--footer-reveal', '1')
            return
          }

          // How much of the pinned footer <main> has stopped covering. Short
          // pages (404, the legal pages) are self-correcting: main's bottom
          // is already above the fold there, so this lands at 1 immediately
          // and the footer paints at full brightness.
          const uncovered = window.innerHeight - main!.getBoundingClientRect().bottom
          const progress = Math.min(Math.max(uncovered / footer!.offsetHeight, 0), 1)
          footer!.style.setProperty('--footer-reveal', progress.toFixed(3))
        }

        function schedule() {
          if (frame) return
          frame = requestAnimationFrame(update)
        }

        update()
        window.addEventListener('scroll', schedule, { passive: true })
        window.addEventListener('resize', schedule)

        // Late-arriving images and the Aeonik font swap both resize main and
        // the footer after first paint, which moves the reveal distance.
        const observer = new ResizeObserver(schedule)
        observer.observe(main)
        observer.observe(footer)

        footerRevealCleanup = () => {
          if (frame) cancelAnimationFrame(frame)
          window.removeEventListener('scroll', schedule)
          window.removeEventListener('resize', schedule)
          observer.disconnect()
        }
      }

      function teardownFooterReveal() {
        footerRevealCleanup?.()
        footerRevealCleanup = null
      }

      // Dev-only typography inspector (Shift+T). Dynamic import inside an
      // `import.meta.env.DEV` branch so neither the module nor its UI is in
      // the production bundle.
      let typeInspector: typeof import('../lib/typeInspector') | null = null

      function init({ restored }: LoadContext) {
        setupBackToTop()
        setupFooterReveal()
        if (import.meta.env.DEV) {
          void import('../lib/typeInspector').then((m) => {
            typeInspector = m
            m.initTypeInspector()
          })
        }
        // Async (it waits on document.fonts.ready before line-splitting) and
        // deliberately not awaited — the nav and footer must not sit idle
        // behind a font load.
        //
        // Fresh loads only. A bfcache restore brings back the page exactly
        // as it was left, entrance already played and any unfired
        // scroll-triggers still armed, so there is nothing to tear down on
        // pagehide and replaying the load-in would snap content the visitor
        // has already seen to opacity 0. The other setups here are stateless
        // listeners and run again as usual.
        if (!restored) void initMotion()
      }

      function teardown() {
        teardownBackToTop()
        teardownFooterReveal()
        typeInspector?.teardownTypeInspector()
      }

      onPageLoad(init)
      onPageUnload(teardown)
    </script>
  </body>
</html>
