---
/**
 * The FES wordmark, inlined rather than fetched.
 *
 * It used to be `<img src="/fes-logo-dark.svg">` (or `-white`), which cost a
 * network request per logo per page — and every page renders two of them,
 * the nav's and the mobile menu's. In production `public/_headers` caches
 * them for a week so a repeat visit pays nothing, but the FIRST view of the
 * site still blocks the nav on two round-trips, and in dev (no caching) it
 * is two conditional requests on every single navigation, ~46ms each,
 * measured. That is the nav visibly redrawing itself as you click through.
 *
 * Inlined, the wordmark is part of the document's first paint: there is
 * nothing left to load, decode or revalidate, so the nav simply appears
 * with the page. The cost is ~3.6KB gzipped per page for both copies —
 * the second is nearly free (115 bytes measured), because it is a verbatim
 * repeat and lands well inside the compression window. That is the same
 * trade §16 already makes for stylesheets.
 *
 * The two colourways were two files with byte-identical path data and
 * different `fill`, so they collapse into one `variant` here. The hexes are
 * carried over exactly rather than mapped onto theme tokens — this is a
 * brand asset, and `#101010` is not `--color-ink`.
 *
 * `public/fes-logo-dark.svg` stays on disk: SEO.astro points the
 * Organization structured data at its absolute URL, which needs a real
 * fetchable file.
 */
interface Props {
  /** `dark` = #101010 wordmark for light grounds; `light` = white, for the shader/photo heroes. */
  variant?: 'dark' | 'light'
  class?: string
}

const { variant = 'dark', class: className } = Astro.props
const fill = variant === 'light' ? '#ffffff' : '#101010'
---

{
  /* role + aria-label replace the `alt` the <img> carried. width/height stay
     as attributes so the box is right before CSS resolves, exactly as the
     <img>'s did; the callers' `h-... w-auto` still drives the rendered size. */
}
