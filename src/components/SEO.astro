---
import { socialItems, breadcrumbLabels } from '../lib/nav'

interface Props {
  title: string
  description: string
  /** Absolute or site-relative URL of the share image — BaseLayout resolves an imported asset into one. */
  ogImage?: string
  noindex?: boolean
}

const { title, description, ogImage = '/og-default.jpg', noindex = false } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL(ogImage, Astro.site)
// Suffix the brand unless the title already carries it. The guard used to
// be `title === 'FES Agency'`, an exact match written when the homepage's
// title was literally that; once it became "FES Agency — Communications for
// Portuguese tech" the guard stopped matching and the homepage shipped
// "FES Agency — Communications for Portuguese tech · FES Agency". Testing
// for containment instead fixes it for any page that leads with the brand,
// which is the only reason a title would ever want to.
const siteTitle = title.includes('FES Agency') ? title : `${title} · FES Agency`

// BreadcrumbList for anything two or more levels deep — the Systems
// sub-pages and the case studies — so search results can show the section
// path instead of the bare URL. Intermediate crumbs come from
// `breadcrumbLabels`; the last is this page's own title. A path whose
// intermediate segment has no label gets nothing: a breadcrumb that names
// the wrong parent is worse than none.
const segments = Astro.url.pathname.split('/').filter(Boolean)
let breadcrumbs: { name: string; item: string }[] | null = null
if (!noindex && segments.length >= 2) {
  const crumbs = [{ name: 'Home', item: new URL('/', Astro.site).toString() }]
  let path = ''
  let complete = true
  segments.forEach((segment, i) => {
    path += `/${segment}`
    const isLast = i === segments.length - 1
    const name = isLast ? title : breadcrumbLabels[segment]
    if (!name) complete = false
    crumbs.push({ name: name ?? segment, item: new URL(`${path}/`, Astro.site).toString() })
  })
  if (complete) breadcrumbs = crumbs
}
---

<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="FES Agency" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FES Agency',
  url: Astro.site?.toString(),
  logo: new URL('/fes-logo-dark.svg', Astro.site).toString(),
  email: 'hello@fesagency.pt',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Porto',
    addressCountry: 'PT',
  },
  // The same four profiles the footer and mobile menu link to — one list,
  // so a new network is added in nav.ts and lands here for free.
  sameAs: socialItems.map((s) => s.href),
})} />

{
  breadcrumbs && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: crumb.item,
        })),
      })}
    />
  )
}
