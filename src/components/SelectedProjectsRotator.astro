---
/**
 * "Selected projects" rotator — category pills (optional) + a project list
 * on the left, one auto-advancing image on the right. Each row's divider is
 * split into one thin slice per photo the project has (a single slice for a
 * zero/one-photo project); while that project is showing, its slices fill
 * ink-dark left-to-right in turn, one per photo, in lockstep with the photo
 * crossfade itself — so the bar's total duration is always a full pass
 * through that project's own photos rather than a fixed timer indifferent to
 * how many photos it has (Web Animations API per slice, so pause/resume/
 * reset is exact rather than reconstructed from a frozen CSS transition
 * width). Hovering/focusing a project previews it immediately, pausing the
 * OUTER cycle (advancing to the next project) but not the bar itself — the
 * same segmented fill keeps looping through that project's own photos for as
 * long as it's hovered, so the hover state still reads as "these photos are
 * about to change" rather than a stationary preview; leaving resumes the
 * outer cycle from that project. Originally built for Creative Projects
 * Blueprint → Events & Activations; shared here for reuse across Systems
 * pages.
 *
 * By default the image panel takes each PROJECT's own real photo ratio (from
 * its first image) rather than staying locked to one fixed crop — see
 * `projectAspect` below and the `<script>`'s `showProject`. Passing
 * `fixedAspect` overrides that: every project (and the placeholder) renders
 * in that one ratio instead, object-cover cropping each photo to fit, so the
 * panel's height never changes as the rotator auto-advances — the per-photo
 * ratio otherwise reflows the whole row (and everything below the section)
 * on every cycle, which reads as layout jitter on pages with several
 * differently-shaped project photos. A project with more than one image (the
 * `images` array) auto-rotates through its own photos — inside that same
 * project-shaped box, so the panel itself doesn't resize between them —
 * but only while that project is the one showing, i.e. while it's active in
 * the outer cycle or being hovered/focused. A project with zero images falls
 * back to PlaceholderBlock's flat tint at whichever ratio is in effect.
 *
 * Pills only render when there's more than one category — pass a single
 * `{ label, projects }` entry for a flat, uncategorised list (no pill bar).
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Heading from './Heading.astro'
import PlaceholderBlock from './PlaceholderBlock.astro'

export interface RotatorProject {
  title: string
  description?: string
  /** One image renders a static frame; more than one auto-rotates while the project is shown. Empty renders a placeholder. */
  images: ImageMetadata[]
}

export interface RotatorCategory {
  label: string
  projects: RotatorProject[]
}

interface Props {
  categories: RotatorCategory[]
  /** Render size cap in px for a project's widest source photo — not a forced crop, just a ceiling so oversized source files aren't requested at full resolution. */
  maxImageWidth?: number
  imageSizes?: string
  /** How long a zero/one-photo project holds before the outer cycle advances to the next, in ms. A project with multiple photos ignores this — its hold is `images.length * slideIntervalMs`, i.e. one full pass through its own photos. */
  intervalMs?: number
  /** How long each photo (and its progress-bar slice) holds before crossfading to the next, for a project with multiple images, in ms. */
  slideIntervalMs?: number
  /** `"W / H"`, e.g. `"886 / 580"`. When set, every project renders in this one ratio (object-cover crops each photo to fit) instead of each project's own photo ratio — use it wherever the source photos vary enough in shape that per-project ratio causes visible layout jitter as the rotator auto-advances. */
  fixedAspect?: string
  /** Optional link rendered beside the "Selected projects" heading, at the same text-lead size — e.g. a full/detailed portfolio that lives outside the site. Undefined renders the heading alone, as every other caller does. */
  titleAction?: { label: string; href: string }
  class?: string
}

const {
  categories,
  maxImageWidth = 1772,
  imageSizes = '(min-width: 1024px) 45vw, 100vw',
  intervalMs = 4500,
  slideIntervalMs = 1400,
  fixedAspect,
  titleAction,
  class: className,
} = Astro.props

const showPills = categories.length > 1

// This section's old fixed crop, kept as the fallback shape for
// placeholder-only projects (which have no real photo ratio to read) and
// reused as the default `fixedAspect` value by callers that want it.
const FALLBACK_ASPECT = '886 / 580'

function projectAspect(project: RotatorProject) {
  if (fixedAspect) return fixedAspect
  const first = project.images[0]
  return first ? `${first.width} / ${first.height}` : FALLBACK_ASPECT
}

function aspectRatio(aspect: string) {
  const [w, h] = aspect.split('/').map((n) => parseFloat(n))
  return w / h
}

// The panel needs a starting shape before the client script takes over.
const firstProject = categories[0]?.projects[0]
const initialAspect = fixedAspect ?? (firstProject ? projectAspect(firstProject) : FALLBACK_ASPECT)
---

<section
  class:list={['w-full bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]', className]}
  data-selected-projects-section
>
  <div class="flex flex-col gap-14" data-projects-row>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <Heading as="h2" indent={false} class="text-lead text-ink">
        Selected projects
      </Heading>
      {
        titleAction && (
          <a
            href={titleAction.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lead text-ink/50 transition-colors duration-150 hover:text-accent-default"
          >
            {titleAction.label}
            {
              /* Default inline-block vertical-align: baseline sits this
                 SVG's BOTTOM edge on the text baseline; translate-y-full
                 then shifts it down by exactly its own height, so its TOP
                 edge lands on the baseline instead — metrics-independent,
                 unlike an absolute offset guessed against line-height. */
            }
            <svg
              width="10"
              height="10"
              viewBox="0 0 16 16"
              fill="none"
              class="ml-1 inline-block translate-y-full"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M16 8L7.72093 16L6.13953 14.4776L11.814 9.13433H0V6.86567H11.814L6.13953 1.52239L7.72093 0L16 8Z"
                fill="currentColor"
                transform="rotate(90 8 8)"
              />
            </svg>
          </a>
        )
      }
    </div>

    <div
      class="flex flex-col gap-10 lg:flex-row lg:gap-16"
      data-selected-projects
      data-interval-ms={intervalMs}
      data-slide-interval-ms={slideIntervalMs}
    >
      <div class="flex flex-col gap-8 lg:w-1/2" data-projects-panel>
        {
          showPills && (
            <div class="flex flex-wrap gap-3" data-category-pills>
              {categories.map((category, ci) => (
                <button
                  type="button"
                  class:list={[
                    'rounded-full border px-[0.85rem] py-[0.425rem] text-[length:calc(var(--text-body-sm)*0.85)] leading-[1.2] transition-colors',
                    ci === 0
                      ? 'border-ink bg-ink text-white'
                      : 'border-neutral-300 text-ink-secondary hover:border-ink hover:text-ink',
                  ]}
                  data-category-pill
                  data-category-index={ci}
                  aria-current={ci === 0 ? 'true' : 'false'}
                >
                  {category.label}
                </button>
              ))}
            </div>
          )
        }

        <div data-category-lists>
          {
            categories.map((category, ci) => (
              <ul class:list={['flex flex-col', ci === 0 ? '' : 'hidden']} data-category-list data-category-index={ci}>
                {category.projects.map((project, pi) => (
                  <li class="project-row flex flex-col">
                    <button
                      type="button"
                      class="block w-full py-4 text-left text-lead text-ink"
                      data-project-item
                      data-project-index={pi}
                      data-description={project.description ?? ''}
                    >
                      {project.title}
                    </button>
                    {
                      /* Divider-as-progress, one slice per photo: same
                         `bg-line` rule every other row gets (the site's
                         standard subtle-rule token — same one SectionLabel
                         draws above e.g. "How we work"), but while its
                         project is the one auto-advancing/previewed/hovered,
                         each slice fills ink-dark left-to-right in turn as
                         that photo shows — see the <script> below. A project
                         with one photo (or none) renders a single slice, so
                         the bar still reads as a plain hold-then-advance
                         timer. `bg-line` also means this adapts correctly
                         inside `.dark-zone`/`.reveal-zone` on the pages that
                         wrap this component in one, unlike the flat
                         neutral-300 this replaced. */
                    }
                    <div class="flex w-full gap-1" data-progress-track data-project-index={pi}>
                      {Array.from({ length: Math.max(project.images.length, 1) }).map((_, si) => (
                        <div class="relative h-px flex-1 bg-line">
                          <div class="h-full w-0 bg-ink" data-progress-segment data-segment-index={si} />
                        </div>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4 self-start lg:w-1/2">
        <div
          class="relative overflow-hidden rounded-[var(--radius-card)] bg-accent-tint"
          data-image-panel
          style={{ aspectRatio: initialAspect }}
        >
          {
            categories.map((category, ci) => (
              <div class:list={['absolute inset-0', ci === 0 ? '' : 'hidden']} data-image-group data-category-index={ci}>
                {category.projects.map((project, pi) => {
                  const first = project.images[0]
                  // Cap the render size at the old crop's width rather than
                  // always requesting the source's full native resolution —
                  // still the project's own ratio (or `fixedAspect`, if set),
                  // just not an oversized file for a photo shot much bigger
                  // than this panel shows.
                  const outWidth = first ? Math.min(first.width, maxImageWidth) : maxImageWidth
                  const outHeight = fixedAspect
                    ? Math.round(outWidth / aspectRatio(fixedAspect))
                    : first
                      ? Math.round((outWidth * first.height) / first.width)
                      : Math.round((maxImageWidth * 580) / 886)
                  const outWidths = [0.5, 0.75, 1].map((m) => Math.round(outWidth * m))
                  return (
                    <div
                      class="absolute inset-0"
                      data-project-image
                      data-project-index={pi}
                      data-aspect-ratio={projectAspect(project)}
                      style={{ opacity: pi === 0 ? 1 : 0 }}
                    >
                      {project.images.length > 0 ? (
                        project.images.map((image, si) => (
                          <Image
                            src={image}
                            alt=""
                            width={outWidth}
                            height={outHeight}
                            widths={outWidths}
                            sizes={imageSizes}
                            loading={ci === 0 && pi === 0 && si === 0 ? 'eager' : 'lazy'}
                            data-project-slide
                            class="rotator-slide absolute inset-0 size-full object-cover"
                            style={{ opacity: si === 0 ? 1 : 0 }}
                          />
                        ))
                      ) : (
                        <PlaceholderBlock alt="" tone="tint" class="size-full" />
                      )}
                    </div>
                  )
                })}
              </div>
            ))
          }
        </div>
        <p class="text-body text-ink-secondary" data-project-caption hidden></p>
      </div>
    </div>
  </div>
</section>

<style>
  .rotator-slide {
    transition: opacity 400ms ease-in-out;
  }

  /* Spotlight: pointing at (or tabbing to) one row drops every OTHER row —
     its title AND its divider, hence dimming the whole <li> rather than the
     button alone — back, leaving the one being previewed at full strength.
     `:has()` rather than a JS class toggle so the dimming can't fall out of
     sync with the pointer; the row's own progress fill dims with it, which
     is correct: while a row is hovered its cycle is paused anyway. */
  .project-row {
    transition: opacity 200ms ease-out;
  }
  [data-category-list]:has(.project-row:hover, .project-row:focus-within)
    .project-row:not(:hover):not(:focus-within) {
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator-slide,
    .project-row {
      transition: none;
    }
  }
</style>

<script>
  // Staggered reveal for the projects row.
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../lib/sectionMotion'

  bindSection('[data-projects-row]', ({ root, mm }) => {
    const cards = Array.from(
      root.querySelectorAll<HTMLElement>('[data-category-pill], [data-category-list]:not(.hidden) [data-project-item]'),
    )
    if (cards.length === 0) return

    // fromTo, never from — see the shared [data-project-card] gotcha note in
    // src/styles/global.css: a `from` tween derives its end value by
    // clearing the inline style and reading computed opacity back out, and
    // ScrollTrigger.refresh() re-runs that revert-and-measure pass. Stating
    // both endpoints keeps the reveal correct no matter what CSS lands here.
    mm.add(MOTION_FULL, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: { trigger: root, start: 'top 85%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.4,
          scrollTrigger: { trigger: root, start: 'top 90%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>

<script>
  import { onPageLoad, onPageUnload } from '../lib/lifecycle'
  // Rotator wiring: category pills (if any) swap which project list/image
  // group is visible; the visible group's projects auto-advance, each one
  // filling its OWN row's progress slices — one per photo — ink-dark in
  // turn while every other row's divider stays at its plain resting
  // neutral-300 color. Hovering (or focusing) a project previews it
  // immediately: it pauses the OUTER cycle (advancing to the next project)
  // but keeps that project's own slice chain looping, so the bar (and the
  // photo it's timing) never just goes stationary while hovered; leaving
  // resumes the outer cycle from that project. Touch/no-hover devices skip
  // the pause entirely and just keep auto-advancing — tapping a project
  // still jumps straight to it via the shared click handler.
  //
  // A project's photo crossfade is driven BY its progress bar, not by a
  // separate clock racing it: `playChain` animates one slice at a time
  // (Web Animations API, so pause/resume/reset is exact rather than
  // reconstructed from a frozen CSS transition width), and each slice's
  // `onfinish` both swaps in the next photo and starts the next slice — so
  // a project's total hold is always exactly `images.length *
  // slideIntervalMs`, one full pass through its own photos, inside the same
  // project-shaped box (the panel's aspect-ratio is set once per project,
  // from its first image, and doesn't move again just because a later photo
  // in the set has a different native ratio). A zero/one-photo project gets
  // a single slice that just holds for `intervalMs`, matching the old
  // fixed-timer behavior. The chain starts the instant the project becomes
  // active (auto-advance or hover) and resets — slices back to empty, photo
  // back to the first — the instant it stops being active, so nothing runs
  // behind the scenes for a project the visitor isn't looking at.
  const ACTIVE_PILL = ['border-ink', 'bg-ink', 'text-white']
  const INACTIVE_PILL = ['border-neutral-300', 'text-ink-secondary', 'hover:border-ink', 'hover:text-ink']

  let cleanups: Array<() => void> = []

  function init() {
    // Safari fires `astro:page-load` twice on some navigations without an
    // intervening `astro:before-swap` — tearing down first keeps re-entry
    // idempotent instead of double-binding listeners and running two
    // autoplay chains at once.
    teardown()

    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-selected-projects]'))
    if (roots.length === 0) return

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const canHover = window.matchMedia('(hover: hover)').matches

    roots.forEach((root) => {
      const intervalMs = Number(root.dataset.intervalMs) || 4500
      const slideIntervalMs = Number(root.dataset.slideIntervalMs) || 1400
      const pills = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-category-pill]'))
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-project-item]'))
      if (items.length === 0) return

      // Reassigned into its own non-null const so TS doesn't re-widen it
      // back to `| null` inside the nested `function` declarations below.
      const panelMaybe = root.querySelector<HTMLElement>('[data-image-panel]')

      let activeCategory = 0
      let activeProject = 0
      let segmentAnims: Animation[] = []

      const activeList = () => root.querySelector<HTMLElement>('[data-category-list]:not(.hidden)')
      const activeGroup = () => root.querySelector<HTMLElement>('[data-image-group]:not(.hidden)')
      const caption = root.querySelector<HTMLElement>('[data-project-caption]')
      const rowSegments = (pi: number) =>
        Array.from(
          activeList()?.querySelectorAll<HTMLElement>(
            `[data-progress-track][data-project-index="${pi}"] [data-progress-segment]`,
          ) ?? [],
        )

      // Cancelling every slice reverts each one to its base `w-0` style —
      // whether a slice is still running or already sitting "finished" at
      // 100% width (WAAPI holds a finished `fill: forwards` animation's end
      // state until something clears it) — which is exactly how a just-left
      // row's bar drops back to fully empty instead of staying lit.
      function cancelChain() {
        segmentAnims.forEach((a) => a.cancel())
        segmentAnims = []
      }

      function resetGroupSlides(group: HTMLElement) {
        const slides = Array.from(group.querySelectorAll<HTMLElement>('[data-project-slide]'))
        slides.forEach((slide, si) => {
          slide.style.opacity = si === 0 ? '1' : '0'
        })
      }

      function showProject(pi: number) {
        const groups = Array.from(activeGroup()?.querySelectorAll<HTMLElement>('[data-project-image]') ?? [])
        groups.forEach((group, i) => {
          const isActive = i === pi
          group.style.opacity = isActive ? '1' : '0'
          if (!isActive) resetGroupSlides(group)
        })

        // Each project carries its own real photo ratio (see the render
        // loop in the template) — the panel itself takes that shape rather
        // than staying locked to one fixed box.
        const aspect = groups[pi]?.dataset.aspectRatio
        if (panelMaybe && aspect) panelMaybe.style.aspectRatio = aspect

        if (caption) {
          const description = activeList()?.querySelector<HTMLElement>(`[data-project-item][data-project-index="${pi}"]`)
            ?.dataset.description
          caption.textContent = description ?? ''
          caption.hidden = !description
        }
      }

      // Plays a project's progress bar one slice at a time, swapping in the
      // matching photo as each slice starts — the bar's fill IS the photo
      // timer, never a second clock racing it. `loop: true` (hover/focus)
      // restarts from the first slice forever instead of calling
      // `onComplete` once the last slice finishes.
      function playChain(pi: number, { loop, onComplete }: { loop: boolean; onComplete?: () => void }) {
        cancelChain()
        if (reducedMotion) return

        const group = activeGroup()?.querySelector<HTMLElement>(`[data-project-image][data-project-index="${pi}"]`)
        const slides = Array.from(group?.querySelectorAll<HTMLElement>('[data-project-slide]') ?? [])
        const segments = rowSegments(pi)
        if (segments.length === 0) return
        // A single slice (zero/one-photo project) just holds for
        // `intervalMs`, same as the old fixed-timer bar; a multi-photo
        // project's slices each hold for `slideIntervalMs`, so the bar's
        // total duration is exactly one full pass through its photos.
        const duration = segments.length > 1 ? slideIntervalMs : intervalMs

        let si = 0

        function playSlice() {
          if (slides.length > 1) {
            slides.forEach((slide, i) => {
              slide.style.opacity = i === si ? '1' : '0'
            })
          }
          const segAnim = segments[si].animate(
            [{ width: '0%' }, { width: '100%' }],
            { duration, easing: 'linear', fill: 'forwards' },
          )
          segmentAnims.push(segAnim)
          segAnim.onfinish = () => {
            si += 1
            if (si < segments.length) {
              playSlice()
              return
            }
            if (loop) {
              si = 0
              cancelChain()
              playSlice()
              return
            }
            onComplete?.()
          }
        }

        playSlice()
      }

      // Re-entrant: each cycle schedules the next one via the chain's own
      // completion callback, so switching category/project just needs to
      // cancel whatever's running and call this again.
      function runCycle(pi: number) {
        activeProject = pi
        showProject(pi)

        const count = activeList()?.querySelectorAll('[data-project-item]').length ?? 0
        if (count === 0) return

        playChain(pi, { loop: false, onComplete: () => runCycle((pi + 1) % count) })
      }

      function selectCategory(ci: number) {
        if (ci === activeCategory) return

        pills[activeCategory]?.setAttribute('aria-current', 'false')
        pills[activeCategory]?.classList.remove(...ACTIVE_PILL)
        pills[activeCategory]?.classList.add(...INACTIVE_PILL)
        pills[ci]?.setAttribute('aria-current', 'true')
        pills[ci]?.classList.remove(...INACTIVE_PILL)
        pills[ci]?.classList.add(...ACTIVE_PILL)

        root.querySelector(`[data-category-list][data-category-index="${activeCategory}"]`)?.classList.add('hidden')
        root.querySelector(`[data-category-list][data-category-index="${ci}"]`)?.classList.remove('hidden')
        root.querySelector(`[data-image-group][data-category-index="${activeCategory}"]`)?.classList.add('hidden')
        root.querySelector(`[data-image-group][data-category-index="${ci}"]`)?.classList.remove('hidden')

        activeCategory = ci
        runCycle(0)
      }

      function onPillClick(e: Event) {
        const ci = Number((e.currentTarget as HTMLElement).dataset.categoryIndex)
        selectCategory(ci)
      }

      function onItemClick(e: Event) {
        const pi = Number((e.currentTarget as HTMLElement).dataset.projectIndex)
        runCycle(pi)
      }

      function onItemEnter(e: Event) {
        const pi = Number((e.currentTarget as HTMLElement).dataset.projectIndex)
        activeProject = pi
        showProject(pi)
        playChain(pi, { loop: true })
      }

      function onItemLeave() {
        runCycle(activeProject)
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', onPillClick)
        cleanups.push(() => pill.removeEventListener('click', onPillClick))
      })

      // Hidden categories' items can't be hovered/focused/clicked (display:
      // none takes them out of hit-testing), so binding all of them up-front
      // — not just the active category's — needs no rebinding on switch.
      items.forEach((item) => {
        item.addEventListener('click', onItemClick)
        cleanups.push(() => item.removeEventListener('click', onItemClick))

        if (canHover) {
          item.addEventListener('mouseenter', onItemEnter)
          item.addEventListener('mouseleave', onItemLeave)
          item.addEventListener('focusin', onItemEnter)
          item.addEventListener('focusout', onItemLeave)
          cleanups.push(() => {
            item.removeEventListener('mouseenter', onItemEnter)
            item.removeEventListener('mouseleave', onItemLeave)
            item.removeEventListener('focusin', onItemEnter)
            item.removeEventListener('focusout', onItemLeave)
          })
        }
      })

      runCycle(0)
      cleanups.push(() => cancelChain())
    })
  }

  function teardown() {
    cleanups.forEach((fn) => fn())
    cleanups = []
  }

  onPageLoad(init)
  onPageUnload(teardown)
</script>
