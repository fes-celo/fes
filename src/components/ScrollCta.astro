---
/**
 * "15 minutes. Your challenge, our take." chip — position: fixed, shown and
 * hidden by two IntersectionObservers keyed off page-specific elements
 * (originally the homepage's Selected Work → Testimonials handoff; now
 * reused on the Systems pages, keyed off "Our approach" → "Selected
 * projects" instead). `showSelector`/`hideSelector` are plain CSS selectors
 * resolved client-side, so each page just points them at whatever elements
 * it already has.
 *
 * Kept as light chip colors in every context on purpose — it sits outside
 * any `.invert-zone` on the homepage and needs to read the same over both
 * light and dark backgrounds.
 */
interface Props {
  /** Selector for the element whose entry into view shows the chip. */
  showSelector: string
  /** Selector for the element whose entry into view hides the chip. */
  hideSelector: string
}

const { showSelector, hideSelector } = Astro.props as Props
---

<div
  class="fixed inset-x-0 bottom-12 z-40 flex justify-center px-[var(--space-gutter)] opacity-0"
  data-scroll-cta
  data-show-selector={showSelector}
  data-hide-selector={hideSelector}
>
  {
    /* max-w-full + a wrappable label: at 375px the nowrap label and the
       button together measured 373px of content inside a 327px column, so
       the chip ran 22px past the right edge and clipped "Book a call".
       The button keeps its nowrap (it must never break); the label is the
       part allowed to take a second line. */
  }
  <div class="flex max-w-full items-center gap-2 rounded-lg bg-neutral-100 p-2 shadow-[var(--shadow-card-hover)]">
    <span class="min-w-0 px-3.5 py-3 text-body text-accent-950 sm:whitespace-nowrap">
      15 minutes. Your challenge, our take.
    </span>
    {
      /* Straight to the booking page, not /contact/: the chip promises "15
         minutes", and a form that lands in an inbox can't deliver that —
         it needs a reply before anything is booked. The contact form is
         still the route for everything that isn't a call.

         target="_blank" because this leaves the site for a third-party
         scheduler: the visitor is mid-scroll through the work, and losing
         that position to pick a slot is a worse trade than a second tab.
         rel matches the convention in cookies-policy.astro. */
    }
    <a
      href="https://calendar.app.google/GJ5i2k73FgB9p1iE9"
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 whitespace-nowrap rounded-[var(--radius-card)] bg-accent-800 px-3.5 py-3 text-body-sm font-medium text-accent-200 transition-colors hover:bg-accent-700"
    >
      Book a call
    </a>
  </div>
</div>

<style>
  /* Base opacity-0 (Tailwind, above) already keeps it invisible; pointer-
     events still needs a hard off/on switch so the hidden chip can't eat
     clicks meant for whatever sits underneath it.

     `visibility` is the keyboard half of the same problem, and opacity
     alone doesn't solve it: an element at opacity 0 is still in the tab
     order and still in the accessibility tree. Tabbing the homepage landed
     on "Book a call" while the chip was retracted — the focus ring drew
     over empty page, and Enter navigated away with no visible cause. Only
     `visibility: hidden` (or `display: none`, which would break the tween)
     removes both.

     It sits on the class rather than in the GSAP tween because visibility
     isn't interpolable: the hide tween animates opacity to 0 over 300ms and
     only then drops .is-visible in its onComplete, so the element stays
     focusable exactly as long as it stays visible, and the two can't
     disagree. transition-behavior lets the show direction flip it to
     visible on frame 1 instead of after the fade. */
  [data-scroll-cta] {
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s;
    transition-behavior: allow-discrete;
  }
  [data-scroll-cta].is-visible {
    pointer-events: auto;
    visibility: visible;
  }
</style>

<script>
  import { onPageLoad, onPageUnload } from '../lib/lifecycle'
  import { gsap } from 'gsap'

  // Slide-up reveal instead of a plain CSS fade: the chip starts offset
  // below its resting position (translateY, set once on init) and GSAP
  // tweens it up to y:0 on show / back down on hide, rather than toggling a
  // Tailwind transition class. `overwrite: true` lets a fast up/down/up
  // scroll interrupt whichever tween is running instead of queuing them.
  const OFFSET_PX = 16

  // Hiding needs the `boundingClientRect.top > 0` branch, not just the
  // isIntersecting one: scrolling back UP past the show-element used to
  // leave the chip stranded, because the only thing that removed
  // is-visible was the hide-element's own observer further down the page.
  // Now a show-element that has left the viewport downwards (top below the
  // fold) retracts the chip, while one that left upwards keeps it shown.
  function setupScrollCta(root: HTMLElement) {
    const showSelector = root.dataset.showSelector
    const hideSelector = root.dataset.hideSelector
    const showEl = showSelector ? document.querySelector<HTMLElement>(showSelector) : null
    const hideEl = hideSelector ? document.querySelector<HTMLElement>(hideSelector) : null
    if (!showEl || !hideEl) return []

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    gsap.set(root, { y: OFFSET_PX })

    const show = () =>
      gsap.to(root, {
        y: 0,
        opacity: 1,
        duration: reduceMotion ? 0 : 0.45,
        ease: 'power3.out',
        overwrite: true,
        onStart: () => root.classList.add('is-visible'),
      })
    const hide = () =>
      gsap.to(root, {
        y: OFFSET_PX,
        opacity: 0,
        duration: reduceMotion ? 0 : 0.3,
        ease: 'power3.in',
        overwrite: true,
        onComplete: () => root.classList.remove('is-visible'),
      })

    const showObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) show()
        else if (entry.boundingClientRect.top > 0) hide()
      },
      { threshold: 0.2 }
    )
    showObserver.observe(showEl)

    const hideObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) hide()
      },
      { threshold: 0 }
    )
    hideObserver.observe(hideEl)

    return [showObserver, hideObserver]
  }

  let observers: IntersectionObserver[] = []

  function init() {
    const root = document.querySelector<HTMLElement>('[data-scroll-cta]')
    if (!root) return
    observers = setupScrollCta(root)
  }

  function teardown() {
    observers.forEach((o) => o.disconnect())
    observers = []
  }

  onPageLoad(init)
  onPageUnload(teardown)
</script>
