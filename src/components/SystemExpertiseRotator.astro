---
/**
 * Pinned funnel word list, shared by all three Systems pages (Figma node
 * 927:1280 for the Influence & Reputation instance — one accent word,
 * centered, in an otherwise empty full-height section).
 *
 * Content-driven by design: the only per-page input is `words`, so Growth
 * Communication and Creative Projects Blueprint can drop this in with their
 * own list and no edits here.
 *
 * v2 — was a scroll-scrubbed 3D flip that showed one word at a time and cost
 * `1.8 viewports × (N-1) transitions` of scroll to get through all of them
 * (5.4 viewports for 4 words). Replaced per direct feedback: the cost wasn't
 * the flip itself, it was making the visitor wait through N sequential
 * reveals for what is really one phrase. Now every word (and the arrow
 * between each pair) is laid out and legible from the first frame, in a
 * single vertical list; scroll only drives a short, ONE-TIME fill — each
 * element's color steps from `--rotator-rest` to `--rotator-fill` in order
 * as the pin's own scrub progress passes it. Total pin distance is a single
 * fixed `PIN_VH` (see the script below), not one multiplied by word count,
 * because there's no per-word transition left to multiply.
 */
interface Props {
  /** The funnel, in reading order. */
  words: string[]
  class?: string
}

const { words, class: className } = Astro.props as Props
---

<section
  class:list={[
    'expertise-rotator relative flex min-h-screen w-full items-center justify-center overflow-hidden px-[var(--space-gutter)] supports-[height:100dvh]:min-h-dvh',
    className,
  ]}
  data-expertise-rotator
>
  {
    /* Progress line — same track/fill pattern as SystemProblemCards' and
       PhasesScroll's, synced to this section's own pin ScrollTrigger. */
  }
  <div
    class="expertise-rotator__pin-progress absolute inset-x-0 top-0 mx-[var(--space-gutter)] h-px bg-line"
    aria-hidden="true"
  >
    <div class="expertise-rotator__progress-fill absolute inset-0 bg-ink" data-pin-progress-fill></div>
  </div>

  {
    /* One <p> so a screen reader reads this as the single phrase it is —
       "Visibility Engagement Demand Growth" — rather than four separate
       paragraphs with pauses between. `text-display` lives HERE, on the
       shared container, not on each word: the arrow spans are FLEX SIBLINGS
       of the words, not children of them, so an em-based size on the arrow
       only ever resolves against a font-size set at this shared level. That
       was the exact bug in the first pass at this layout — the arrow was
       sized off an inherited ~16px body font-size no matter how large
       --text-display grew the words beside it, which is what made the
       word-to-arrow spacing read as randomly unbalanced rather than
       proportional. */
  }
  <p class="rotator-stack text-display" data-rotator-stack>
    {
      words.map((word, i) => (
        <>
          <span class="rotator-word" data-word>
            {word}
          </span>
          {i < words.length - 1 && (
            <>
              {' '}
              <span class="rotator-arrow" data-arrow aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v14M6 13l6 6 6-6" />
                </svg>
              </span>{' '}
            </>
          )}
        </>
      ))
    }
  </p>
</section>

<style>
  .expertise-rotator {
    background: var(--color-surface);
    /*
      --rotator-rest/--rotator-fill are consumed, never declared, here — see
      the :root definitions in global.css for why. A dark `.dark-zone`
      wrapper (src/pages/systems/influence-reputation/index.astro and the
      sibling `/dark/` pages) redefines both further up the tree, same
      mechanism that already flips --color-surface/ink/line for every shared
      component. Both states read as "barely there" against their OWN
      surface at rest and "fully arrived" once filled — neutral-100 is close
      to invisible on a light surface the same way neutral-800 is on a
      near-black one, so the ghost→solid effect holds on either background
      without needing separate motion logic.
    */
  }

  .rotator-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* text-display's own line-height (0.98) already sits close enough to 1
       that the half-leading it leaves above/below each word is negligible
       here — nothing left to fight, unlike a looser 1.3-1.5 body line-height
       would be. */
    gap: 0.3em;
    margin: 0;
  }

  .rotator-word {
    display: block;
    color: var(--rotator-fill);
  }

  .rotator-arrow {
    display: block;
    width: 0.42em;
    height: 0.42em;
    color: var(--rotator-fill);
    /*
      A chevron's own visual weight sits in its point, at the bottom of its
      box — centering the box in the flex gap still reads bottom-heavy.
      Nudging it up very slightly balances the ink, not just the boxes.
    */
    margin-block: 0.03em -0.05em;
  }

  .rotator-arrow svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke-width: 2.2;
  }

  /*
    Fallback branch (mobile / reduced motion): no pin, so nothing to scrub in
    from a "rest" state — the section is just its resting height, holding the
    already-fully-filled list. Height collapses to a normal section instead
    of a full viewport, since without a pin there's no reason to hold one.
  */
  .expertise-rotator[data-fallback] {
    min-height: 0;
    padding-block: var(--space-section-y);
  }

  /* No pin under the fallback branch — nothing for the line to track. */
  .expertise-rotator[data-fallback] .expertise-rotator__pin-progress {
    display: none;
  }

  /*
    NOT Tailwind's `scale-x-0` / `origin-left`: Tailwind v4 implements scale
    utilities with the INDEPENDENT `scale` property, not `transform`, and the
    two compose multiplicatively — `scale: 0 1` zeroed the fill out no matter
    what GSAP wrote to `transform`. See SystemProblemCards for the full note.
  */
  .expertise-rotator__progress-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>

<script>
  import { bindSection, gsap, ScrollTrigger, MOTION_FULL, MOTION_FALLBACK, shareResizeRefresh } from '../lib/sectionMotion'

  /**
   * Total pin distance for the whole fill, in viewport heights. A single
   * fixed number now, not `VH_PER_WORD × (N-1)` — the old per-word unit
   * doesn't exist anymore because there's no per-word SWAP left to space
   * out, just one continuous scrub across every element already on screen.
   */
  const PIN_VH = 0.8

  /** Reads a custom property already resolved through whatever cascade
   * (light default or `.dark-zone` override) the element actually sits in,
   * so the fill colors never need to be duplicated into this script. */
  const cssVar = (el: Element, name: string) => getComputedStyle(el).getPropertyValue(name).trim()

  bindSection('[data-expertise-rotator]', ({ root, mm }) => {
    const stack = root.querySelector<HTMLElement>('[data-rotator-stack]')
    const progressFill = root.querySelector<HTMLElement>('[data-pin-progress-fill]')
    if (!stack) return

    const els = Array.from(stack.querySelectorAll<HTMLElement>('[data-word], [data-arrow]'))
    if (els.length < 2) return

    const rest = cssVar(root, '--rotator-rest')
    const fill = cssVar(root, '--rotator-fill')

    mm.add(MOTION_FULL, () => {
      root.removeAttribute('data-fallback')
      gsap.set(els, { color: rest })

      // One timeline, scrubbed — same principle as the old flip's single
      // source of truth, just animating color/scale per element instead of
      // rotateX per character. Each element gets a thin window on the [0,1]
      // timeline proportional to its position in the list, so scrubbing
      // through it lights the list up in reading order.
      const tl = gsap.timeline({ paused: true })
      els.forEach((el, i) => {
        const t = i / (els.length - 1)
        const isWord = el.hasAttribute('data-word')
        tl.to(el, { color: fill, scale: isWord ? 1.04 : 1, duration: 0.08, ease: 'none' }, t).to(
          el,
          { scale: 1, duration: 0.1, ease: 'none' },
          t + 0.08
        )
      })
      // Same zero-effect marker technique as the old timeline: pins the
      // timeline's own duration at exactly 1 so the scrub's [0,1] range maps
      // onto the FULL sequence, not just up to the last real tween's end
      // time (see the old file's note on this, kept for the next reader).
      tl.set(root, {}, 1)

      const st = ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: () => `+=${window.innerHeight * PIN_VH}`,
        pin: true,
        pinSpacing: true,
        invalidateOnRefresh: true,
        scrub: 0.2,
        onUpdate: (self) => {
          if (progressFill) gsap.set(progressFill, { scaleX: self.progress })
        },
        animation: tl,
      })

      const releaseResize = shareResizeRefresh()

      return () => {
        releaseResize()
        st.kill()
        tl.kill()
        gsap.set(els, { color: rest, scale: 1 })
        if (progressFill) gsap.set(progressFill, { scaleX: 0 })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      // No pin, no scroll dependency, nothing to scrub FROM — the full-motion
      // branch already shows all of them at once, so under reduced motion or
      // a narrow viewport this is just that same list, already fully lit,
      // held statically.
      root.setAttribute('data-fallback', '')
      gsap.set(els, { color: fill, scale: 1 })

      return () => {
        root.removeAttribute('data-fallback')
      }
    })
  })
</script>
