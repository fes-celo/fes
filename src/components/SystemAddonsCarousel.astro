---
/**
 * Dark-page Addons strip (Figma node 975:618, the Influence & Reputation
 * dark variant). Same draggable infinite-loop mechanics as
 * SystemAddonsMarquee (src/lib/horizontalLoop.ts), plus autoplay, which
 * that page doesn't have — the loop eases forward by exactly one card on a
 * timer instead of only responding to drag. A separate component rather than a prop on
 * SystemAddonsMarquee: the light page's marquee is deliberately the one
 * hands-only section on the site (see that component's own docstring), and
 * folding autoplay into it as an opt-in would blur that intent for every
 * future consumer.
 *
 * Card colors are dark literals (neutral-900/neutral-800), not tokens —
 * this component only ever renders inside the dark page's own dark-zone
 * wrapper, so there's no light-mode state for it to adapt to.
 */
export interface Addon {
  title: string
  description: string
}

interface Props {
  heading?: string
  addons: Addon[]
  /** Sets of cards rendered. Raise if the strip looks sparse on wide screens. */
  repeat?: number
  class?: string
}

const { heading = 'Add-ons', addons, repeat = 3, class: className } = Astro.props as Props

// Flattened so every card is a direct sibling — horizontalLoop measures and
// wraps the cells individually, and that's also what the drag/autoplay snap to.
const cells = Array.from({ length: repeat }).flatMap((_, set) =>
  addons.map((addon) => ({ addon, isDuplicate: set > 0 }))
)
---

<section class:list={['addons-carousel flex w-full flex-col gap-[var(--space-heading-gap)]', className]}>
  <div class="mx-[var(--space-gutter)] flex flex-col gap-4">
    {
      /* The rule that used to be a plain `border-t border-current/20` (same
         static-eyebrow-rule pattern as SectionLabel) now doubles as the
         drag/autoplay progress bar — bg-line track, scaleX fill from the
         left — synced to the loop's own GSAP timeline instead of a
         scrollLeft ratio, since this strip moves via horizontalLoop rather
         than native scroll (see the <script> below). Reflects both autoplay
         ticks and manual drag; normalized against `repeat` so one full fill
         is one pass through the unique set, not all `repeat` copies. */
    }
    <div class="addons-carousel__progress relative h-px w-full bg-line" aria-hidden="true">
      <div class="addons-carousel__progress-fill absolute inset-0 bg-ink" data-addons-progress-fill></div>
    </div>

    <div class="text-ink-muted-inverse">
      <h2 class="text-lead">{heading}</h2>
    </div>
  </div>

  {
    /* Same hard-clip / asymmetric-inset treatment as SystemAddonsMarquee:
       left edge lines up with the heading, right edge runs to the true
       viewport edge. */
  }
  <div class="addons-carousel__marquee relative ml-[var(--space-gutter)] overflow-hidden">
    <div
      class="addons-carousel__track flex w-max cursor-grab select-none active:cursor-grabbing"
      data-addons-track
      data-repeat={repeat}
    >
      {
        cells.map(({ addon, isDuplicate }) => (
          <article class="addons-carousel__card flex flex-col justify-between gap-10" aria-hidden={isDuplicate ? 'true' : undefined}>
            <h3 class="text-h3 text-neutral-100">{addon.title}</h3>
            <p class="text-body text-neutral-400">{addon.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
    NOT Tailwind's `scale-x-0`: Tailwind v4 implements scale utilities with
    the INDEPENDENT `scale` property, which composes multiplicatively with
    whatever is written to `transform` — it would zero the fill out no
    matter what the script sets. Same note as the Agency team-progress fill.
  */
  .addons-carousel__progress-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }

  .addons-carousel__card {
    width: 80vw;
    max-width: 26rem;
    aspect-ratio: 3 / 4;
    margin-right: 1.25rem;
    flex-shrink: 0;
    padding: var(--space-card-p);
    border-radius: var(--radius-control);
    background-color: var(--color-neutral-900);
  }

  @media (min-width: 1024px) {
    .addons-carousel__card {
      width: 22.5rem;
      max-width: none;
    }
  }
</style>

<script>
  import type { HorizontalLoop } from '../lib/horizontalLoop'
  import { pressCards } from '../lib/dragCarousel'

  const SPEED = 0.35
  /** How long each card holds in place before the next ease-forward. */
  const HOLD_S = 3.2
  const ADVANCE = { duration: 0.9, ease: 'power2.inOut' }

  let loops: HorizontalLoop[] = []
  let cleanups: Array<() => void> = []

  // Plain transform write on the loop's own timeline `onUpdate`, same
  // rationale as the Agency team-progress bar's scroll-event write: nothing
  // else needs a rendering library for one property per frame. `progress()`
  // is 0→1 across ALL `repeat` copies of the strip, so it's scaled back down
  // by `repeat` (and wrapped) to read as one fill per pass through the
  // unique set — otherwise the bar would crawl three times slower than the
  // cards actually advance. Wired before the `reducedMotion` autoplay
  // bail-out below so it still tracks manual drag when autoplay is off.
  function setupAddonsProgress(track: HTMLElement, loop: HorizontalLoop) {
    const fill = track.closest('.addons-carousel')?.querySelector<HTMLElement>('[data-addons-progress-fill]')
    if (!fill) return null

    const repeat = Math.max(1, Number(track.dataset.repeat) || 1)
    const update = () => {
      const ratio = (loop.timeline.progress() * repeat) % 1
      fill.style.transform = `scaleX(${ratio.toFixed(4)})`
    }
    loop.timeline.eventCallback('onUpdate', update)
    update()

    return () => {
      loop.timeline.eventCallback('onUpdate', null)
      fill.style.transform = ''
    }
  }

  async function init() {
    const tracks = Array.from(document.querySelectorAll<HTMLElement>('[data-addons-track]'))
    if (tracks.length === 0) return

    await new Promise<void>((resolve) => {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return
          observer.disconnect()
          resolve()
        },
        { rootMargin: '400px' }
      )
      tracks.forEach((t) => observer.observe(t))
      cleanups.push(() => {
        observer.disconnect()
        resolve()
      })
    })

    if (!document.body.contains(tracks[0]!)) return

    const { horizontalLoop } = await import('../lib/horizontalLoop')
    if (!document.body.contains(tracks[0]!)) return

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    tracks.forEach((track) => {
      const loop = horizontalLoop(track.children, {
        speed: SPEED,
        draggable: true,
        paused: true,
      })
      if (!loop) return
      loops.push(loop)

      const progressCleanup = setupAddonsProgress(track, loop)
      if (progressCleanup) cleanups.push(progressCleanup)

      // Same press-scale feedback as the testimonial/team drag carousels
      // (see src/lib/dragCarousel.ts's pressCards + PRESS_SCALE) — the cards
      // shrink toward their own center for the duration of the drag, same
      // gesture, applied here to horizontalLoop's own Draggable instead of
      // createDragCarousel's. Skipped under reduced motion, matching
      // createDragCarousel's own bail-out (transform feedback is exactly
      // what that preference asks to drop) — the loop's native drag itself
      // still works either way.
      if (!reducedMotion) {
        const cards = Array.from(track.querySelectorAll<HTMLElement>('.addons-carousel__card'))
        const onPress = () => pressCards(cards, true)
        const onRelease = () => pressCards(cards, false)
        // Release listeners on `window`, not the track: once a drag starts,
        // GSAP's Draggable tracks the pointer via document-level listeners
        // regardless of where it travels, so a release outside the track's
        // own bounds (dragging past the strip's edge, common with a fast
        // flick) must still restore scale — a track-scoped `pointerup`/
        // `pointerleave` would fire on that boundary cross mid-drag instead.
        track.addEventListener('pointerdown', onPress)
        window.addEventListener('pointerup', onRelease)
        window.addEventListener('pointercancel', onRelease)
        cleanups.push(() => {
          track.removeEventListener('pointerdown', onPress)
          window.removeEventListener('pointerup', onRelease)
          window.removeEventListener('pointercancel', onRelease)
        })
      }

      // Reduced motion: drag still works (paused: true above already
      // covers that), but nothing advances on its own.
      if (reducedMotion) return

      let timer = 0
      let hovering = false

      function tick() {
        if (hovering) return
        loop!.next(ADVANCE)
      }

      timer = window.setInterval(tick, HOLD_S * 1000)

      const onEnter = () => {
        hovering = true
      }
      const onLeave = () => {
        hovering = false
      }
      track.addEventListener('mouseenter', onEnter)
      track.addEventListener('mouseleave', onLeave)
      // Keyboard/touch focus inside the strip pauses it the same way hover
      // does — nothing here is individually focusable, but a future card
      // link shouldn't have its target yanked out from under it mid-read.
      track.addEventListener('focusin', onEnter)
      track.addEventListener('focusout', onLeave)

      cleanups.push(() => {
        window.clearInterval(timer)
        track.removeEventListener('mouseenter', onEnter)
        track.removeEventListener('mouseleave', onLeave)
        track.removeEventListener('focusin', onEnter)
        track.removeEventListener('focusout', onLeave)
      })
    })
  }

  function teardown() {
    loops.forEach((loop) => loop.destroy())
    loops = []
    cleanups.forEach((fn) => fn())
    cleanups = []
  }

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', teardown)
</script>
