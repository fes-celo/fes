---
/**
 * Addons strip (Figma node 927:1393, which lays the four cards out as a
 * static 4-column grid). Runs as an infinite draggable marquee instead —
 * deliberately the one motion section on the page that never touches
 * ScrollTrigger, so there is a stretch of the page the reader drives with
 * their hands rather than the scrollbar.
 *
 * Loop mechanics are src/lib/horizontalLoop.ts — GSAP's own documented
 * helper, already vendored for LogoMarquee. Drag is constrained to `type:
 * 'x'` inside that helper, which is what keeps a touch user's vertical
 * page scroll working when their finger starts on a card.
 */
export interface Addon {
  title: string
  description: string
}

interface Props {
  heading?: string
  addons: Addon[]
  /** Sets of cards rendered. Raise if the strip looks sparse on wide screens. */
  repeat?: number
  class?: string
}

const { heading = 'Add-ons', addons, repeat = 3, class: className } = Astro.props as Props

// Flattened so every card is a direct sibling — horizontalLoop measures and
// wraps the cells individually, and that's also what the drag snaps to.
const cells = Array.from({ length: repeat }).flatMap((_, set) =>
  addons.map((addon) => ({ addon, isDuplicate: set > 0 }))
)
---

<section class:list={['addons flex w-full flex-col gap-[var(--space-heading-gap)]', className]}>
  <div class="mx-[var(--space-gutter)] flex flex-col gap-4">
    {
      /* SectionLabel's usual static `border-t border-current/20` rule,
         replaced here with the equivalent bg-line/bg-ink pair so the same
         line can double as the drag progress bar — synced to the loop's own
         GSAP timeline instead of a scrollLeft ratio, since this strip moves
         via horizontalLoop, not native scroll (see the <script> below).
         This strip never autoplays, so the bar only ever reflects the drag
         itself — normalized against `repeat` so one full fill is one pass
         through the unique set, not all `repeat` copies. Not SectionLabel
         itself: that component is a static, reusable eyebrow primitive (see
         its own docstring) and has no notion of an animated fill. */
    }
    <div class="addons__progress relative h-px w-full bg-line" aria-hidden="true">
      <div class="addons__progress-fill absolute inset-0 bg-ink" data-addons-progress-fill></div>
    </div>
    <h2 class="text-lead text-ink-muted">{heading}</h2>
  </div>

  {
    /* Hard-clipped, not faded, and asymmetric on purpose: the LEFT edge
       matches the "Addons" heading's inset (same margin as the h2 above),
       so the strip starts exactly where the heading does — but the RIGHT
       edge runs to the true viewport edge with no padding, so cards clip
       flush against the screen there rather than stopping at the gutter. */
  }
  <div class="addons__marquee relative ml-[var(--space-gutter)] overflow-hidden">
    <div
      class="addons__track flex w-max cursor-grab select-none active:cursor-grabbing"
      data-addons-track
      data-repeat={repeat}
    >
      {
        cells.map(({ addon, isDuplicate }) => (
          <article
            class="addons__card flex flex-col justify-between gap-10"
            aria-hidden={isDuplicate ? 'true' : undefined}
          >
            <h3 class="text-h3 text-neutral-900">{addon.title}</h3>
            <p class="text-body text-neutral-900">{addon.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .addons__card {
    /* Fixed size in CSS, per horizontalLoop's measure note: the loop
       geometry has to be correct before any content reflows it. Mobile
       matches SystemProblemCards' ("Sound familiar?") own mobile card; the
       desktop rule below matches its width, which is the state the two
       sections are actually seen in next to each other. */
    width: 80vw;
    max-width: 26rem;
    aspect-ratio: 3 / 4;
    margin-right: 1.25rem;
    flex-shrink: 0;
    padding: var(--space-card-p);
    border-radius: var(--radius-control);
    background-color: var(--color-azure-50);
  }

  /* Same width as SystemProblemCards' pinned card, so both card rows on the
     page are one size. Kept as a literal rather than a shared token: this
     component is a sibling, not a child, of that one — a custom property
     can't cross between them without being promoted to a global, which
     would put page-section geometry into the token layer. */
  @media (min-width: 1024px) {
    .addons__card {
      width: 22.5rem;
      max-width: none;
    }
  }

  /*
    NOT Tailwind's `scale-x-0`: Tailwind v4 implements scale utilities with
    the INDEPENDENT `scale` property, which composes multiplicatively with
    whatever is written to `transform` — it would zero the fill out no
    matter what the script sets. Same note as the Agency team-progress fill.
  */
  .addons__progress-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>

<script>
  import { onPageLoad, onPageUnload } from '../lib/lifecycle'
  import type { HorizontalLoop } from '../lib/horizontalLoop'
  import { pressCards } from '../lib/pressCards'

  // Still passed through even with no autoplay: horizontalLoop's `speed`
  // sets the underlying timeline's total duration, which is what maps drag
  // distance to visual movement (and what the inertia/snap math is scaled
  // against) — it isn't only an autoplay pace.
  const SPEED = 0.35

  let loops: HorizontalLoop[] = []
  let cleanups: Array<() => void> = []

  // Plain transform write on the loop's own timeline `onUpdate`, same
  // rationale as the Agency team-progress bar's scroll-event write: nothing
  // else needs a rendering library for one property per frame. `progress()`
  // is 0→1 across ALL `repeat` copies of the strip, so it's scaled back down
  // by `repeat` (and wrapped) to read as one fill per pass through the
  // unique set — otherwise the bar would crawl three times slower than the
  // cards actually advance. This strip never autoplays, so the only thing
  // that ever moves it is the drag this same effect feeds off.
  function setupAddonsProgress(track: HTMLElement, loop: HorizontalLoop) {
    const fill = track.closest('.addons')?.querySelector<HTMLElement>('[data-addons-progress-fill]')
    if (!fill) return null

    const repeat = Math.max(1, Number(track.dataset.repeat) || 1)
    const update = () => {
      const ratio = (loop.timeline.progress() * repeat) % 1
      fill.style.transform = `scaleX(${ratio.toFixed(4)})`
    }
    loop.timeline.eventCallback('onUpdate', update)
    update()

    return () => {
      loop.timeline.eventCallback('onUpdate', null)
      fill.style.transform = ''
    }
  }

  /**
   * horizontalLoop pulls in Draggable + InertiaPlugin (~40KB), and this
   * strip sits near the bottom of a very long page. Loading them eagerly put
   * them on the critical path and cost the page ~4 Lighthouse mobile points
   * through CPU contention during first paint — the LCP here is TEXT, so
   * every KB of module parsing before it delays the headline.
   *
   * Imported on approach instead. The 400px rootMargin means the strip is
   * always already looping by the time it's actually on screen.
   */
  async function init() {
    const tracks = Array.from(document.querySelectorAll<HTMLElement>('[data-addons-track]'))
    if (tracks.length === 0) return

    await new Promise<void>((resolve) => {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return
          observer.disconnect()
          resolve()
        },
        { rootMargin: '400px' }
      )
      tracks.forEach((t) => observer.observe(t))
      // A teardown mid-wait must not leave this promise (and the observer)
      // dangling across a client-side navigation.
      cleanups.push(() => {
        observer.disconnect()
        resolve()
      })
    })

    // The page may have been swapped out while we waited.
    if (!document.body.contains(tracks[0]!)) return

    const { horizontalLoop } = await import('../lib/horizontalLoop')
    if (!document.body.contains(tracks[0]!)) return

    // Always paused — this strip never auto-advances, only drag moves it.
    // horizontalLoop's own drag/inertia/snap-to-nearest work identically
    // whether the underlying repeat:-1 timeline is playing or not; dragging
    // just scrubs its progress directly.
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    tracks.forEach((track) => {
      const loop = horizontalLoop(track.children, {
        speed: SPEED,
        draggable: true,
        paused: true,
      })
      if (!loop) return
      loops.push(loop)

      const progressCleanup = setupAddonsProgress(track, loop)
      if (progressCleanup) cleanups.push(progressCleanup)

      // Same press-scale feedback as the testimonial/team drag carousels
      // (see src/lib/dragCarousel.ts's pressCards + PRESS_SCALE), applied
      // to horizontalLoop's own Draggable instance — the loop's `snap`
      // already lands on the nearest card, this just adds the shrink-on-
      // press half of that mechanic. Skipped under reduced motion, same as
      // createDragCarousel's own bail-out; the drag itself still works.
      if (reducedMotion) return
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.addons__card'))
      const onPress = () => pressCards(cards, true)
      const onRelease = () => pressCards(cards, false)
      // Release listeners on `window`, not the track — see
      // SystemAddonsCarousel's identical note: a drag can end outside the
      // track's own bounds (a fast flick past the strip's edge).
      track.addEventListener('pointerdown', onPress)
      window.addEventListener('pointerup', onRelease)
      window.addEventListener('pointercancel', onRelease)
      cleanups.push(() => {
        track.removeEventListener('pointerdown', onPress)
        window.removeEventListener('pointerup', onRelease)
        window.removeEventListener('pointercancel', onRelease)
      })
    })
  }

  function teardown() {
    loops.forEach((loop) => loop.destroy())
    loops = []
    cleanups.forEach((fn) => fn())
    cleanups = []
  }

  onPageLoad(init)
  onPageUnload(teardown)
</script>
