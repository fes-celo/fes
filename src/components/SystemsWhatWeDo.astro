---
/**
 * "What we do" — Figma nodes 1024:4457 (light, systems page) and 1033:6264
 * (dark, homepage). Same content and layout in both places; only the
 * section's light/dark theming and each card's background art differ.
 *
 * Card art: all three cards now use the same base photo in both the light
 * and dark variant. Card 1 (Digital Communication) and card 2 (Influence &
 * Reputation) additionally layer a translucent grayscale swirl overlay on
 * top when dark, which is what mutes their otherwise-identical base from
 * the light variant's look to the dark homepage section's.
 */
import SectionLabel from './SectionLabel.astro'
import Button from './Button.astro'
import SystemCard from './SystemCard.astro'
import digitalCommunication from '../assets/systems/what-we-do/digital-communication-light.jpg'
import influenceReputation from '../assets/systems/what-we-do/influence-reputation.jpg'
import creativeBlueprint from '../assets/systems/what-we-do/creative-blueprint.jpg'
import digitalCommOverlayDark from '../assets/systems/what-we-do/digital-comm-overlay-dark.png'

interface Props {
  theme?: 'light' | 'dark'
  /** Hide the "Our systems" CTA — it's redundant on /systems/ itself, since that's where this section already lives. */
  showCta?: boolean
  /** Reveal each card on its own scroll position (motion.ts `data-reveal="items"`) instead of the section as one block. */
  revealItems?: boolean
  class?: string
}

const { theme = 'light', showCta = true, revealItems = false, class: className } = Astro.props
const isDark = theme === 'dark'

const cards = [
  {
    href: '/systems/digital-communication/',
    title: 'Digital Communication System',
    description: 'Communication built to generate demand, build trust, and turn attention into opportunity.',
    base: digitalCommunication,
    overlay: isDark ? digitalCommOverlayDark : null,
  },
  {
    href: '/systems/influence-reputation/',
    title: 'Influence & Reputation System',
    description: 'Reputation strong enough to turn recognition into real business opportunities.',
    base: influenceReputation,
    overlay: isDark ? digitalCommOverlayDark : null,
  },
  {
    href: '/systems/creative-projects-blueprint/',
    title: 'Creative Project Blueprint',
    description: 'Brand and creative work, scoped to the moment that needs it.',
    base: creativeBlueprint,
    overlay: null,
  },
]
---

<section
  data-nav-ink={isDark ? 'light' : 'dark'}
  class:list={[
    isDark ? 'bg-neutral-950' : 'bg-white',
    'px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-[var(--space-section-y)]',
    className,
  ]}
  data-anim="reveal"
  data-reveal={revealItems ? 'items' : undefined}
>
  <div class="flex flex-col gap-14 lg:gap-20">
    <SectionLabel dark={isDark}>What we do</SectionLabel>

    <div class="flex flex-col gap-7">
      {
        /* Two balanced lines at every desktop width. The cap is in em, not
           the old fixed 50.8125rem (813px): text-h1 grows with the viewport
           but a rem cap doesn't, so at 1440 the balanced second line
           ("business challenges that matter most", ~16.7em) no longer fit
           and "most" dropped to a line of its own. 18em clears that line
           with room to spare yet is far short of the ~32em the sentence
           needs on one line, so it always breaks after "the"; text-balance
           keeps narrower screens free of widows too. */
      }
      <p class:list={['max-w-[18em] text-balance text-h1 font-medium', isDark ? 'text-neutral-100' : 'text-neutral-950']}>
        Strategic systems built around the business challenges that matter most
      </p>
      {
        showCta && (
          <Button
            href="/systems/"
            variant="tint"
            arrow={false}
            class:list={['w-fit', isDark && '!bg-neutral-900 !text-white hover:!bg-white hover:!text-accent-default']}
          >
            Our systems
          </Button>
        )
      }

      <div class="mt-7 grid grid-cols-1 gap-7 lg:grid-cols-3" data-reveal-each>
        {
          cards.map((c) => (
            <SystemCard
              href={c.href}
              title={c.title}
              image={c.base}
              overlay={c.overlay}
              variant="dark"
              class="h-[22rem] lg:h-[26.1875rem]"
            >
              <p class="max-w-[75%] text-body text-neutral-50">{c.description}</p>
            </SystemCard>
          ))
        }
      </div>
    </div>
  </div>
</section>
