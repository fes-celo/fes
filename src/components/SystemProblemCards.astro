---
/**
 * "Sound familiar?" — the problem cards row (Figma node 959:1815).
 *
 * Built content-driven alongside SystemExpertiseRotator and PhasesScroll
 * so all three Systems pages can share it; the cards differ per page, the
 * mechanics don't.
 *
 * NOT scroll-pinned (an earlier version scrubbed the row across a locked
 * vertical scroll, GSAP-scrolljacking style — see git history). That cost a
 * full extra viewport of scroll to see four cards, and its per-frame
 * transform on an `overflow-hidden`+`border-radius` card was also the
 * source of an intermittent Safari bug that clipped the bottom edge off
 * cards mid-scroll. Replaced with a plain native horizontal strip: the
 * cards sit in normal flow (first card flush with the heading, no leading
 * offset), get a one-time GSAP slide-in from the left when the section
 * scrolls into view (see the <script> below, same tuning family as
 * src/lib/motion.ts's reveals), and are draggable via the same
 * press-scale + magnetic-snap mechanic as the testimonial carousels (see
 * src/lib/dragCarousel.ts) — no scroll distance required to reach every
 * card.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

export interface ProblemCard {
  title: string
  /** Lead-in above the statement, e.g. "Ideal for those who want to:". */
  label: string
  statement: string
  /** Optional so a page can ship layout-complete ahead of final photography — same convention as ProjectCard's own no-image state. */
  image?: ImageMetadata
}

interface Props {
  heading?: string
  cards: ProblemCard[]
  class?: string
}

const { heading = 'Sound familiar?', cards, class: className } = Astro.props as Props
---

<section class:list={['problem-cards relative w-full', className]} data-problem-cards>
  <div class="problem-cards__inner flex w-full flex-col gap-16 lg:gap-28">
    {
      /* The rule above the heading on a SEPARATE gutter-padded wrapper, not
         the h2 itself — an h2 with its own px-gutter still draws its own
         border-top edge to edge (the border sits at the OUTSIDE of the
         padding box), so the rule ran full-bleed to the true section edges
         instead of lining up with where "Sound familiar?" actually starts.
         Wrapping it pushes the rule in to the same inset the text sits at.

         That rule IS the drag progress bar — a neutral-200 track with a
         neutral-950 fill scaled from the left, exactly StatBlock's
         minimal-variant pattern, except the fill now tracks the viewport's
         own horizontal scrollLeft (see the <script> below) instead of a
         pin's scroll progress. It replaces the h2's old `border-t`: keeping
         both drew two stacked lines. At rest (no-JS, or before the script
         runs) the fill is at scaleX(0), so it reads as exactly the plain
         rule it used to be. */
    }
    <div class="px-[var(--space-gutter)]">
      <div class="problem-cards__progress relative h-px w-full bg-line" aria-hidden="true">
        <div class="problem-cards__progress-fill absolute inset-0 bg-ink" data-progress-fill></div>
      </div>
      <h2 class="pt-4 text-lead text-ink">{heading}</h2>
    </div>

    {
      /* A native horizontal scroll strip, full stop — no pinned/scrubbed
         branch takes over from here (see the file-level comment above), so
         this IS the resting state at every viewport width and what renders
         with no JS. The <script> below layers a one-time slide-in and a
         drag/press/snap mechanic on top without touching this layout. */
    }
    <div class="problem-cards__viewport" data-viewport>
      <div class="problem-cards__track" data-track>
        {
          cards.map((card) => (
            <article class="problem-card" data-card>
              <div class="problem-card__media" data-card-media>
                {card.image ? (
                  <Image
                    src={card.image}
                    alt=""
                    width={860}
                    height={916}
                    widths={[430, 860]}
                    sizes="(min-width: 1024px) 28vw, 80vw"
                    class="problem-card__img"
                  />
                ) : (
                  <div class="problem-card__img-placeholder" aria-hidden="true" />
                )}
              </div>
              <div class="problem-card__scrim" />
              <div class="relative flex h-full flex-col justify-between gap-10">
                <h3 class="text-h3 text-neutral-50">{card.title}</h3>
                {/*
                  Three tiers of content, three distinct sizes. These were
                  previously h3 + one text-lead paragraph holding both the
                  label and the statement, split by a <br> — so the label and
                  the statement rendered at the SAME size, only 2px under the
                  title, and the tier that matters least was as loud as the
                  one that matters most. The label is meta, so it drops below
                  the statement in size as well as in colour, and the two are
                  now separate elements with a real gap rather than a line
                  break inside one.
                */}
                <div class="flex flex-col gap-2">
                  <p class="text-body-sm text-neutral-400">{card.label}</p>
                  <p class="text-body font-normal text-neutral-50">{card.statement}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .problem-cards {
    padding-block: var(--space-section-y);
    --problem-card-gap: 1.75rem;
  }

  /*
    NOT Tailwind's `scale-x-0` / `origin-left`: Tailwind v4 implements scale
    utilities with the INDEPENDENT `scale` property, not `transform`. The two
    compose multiplicatively, so `scale: 0 1` zeroed the fill out no matter
    what GSAP wrote to `transform` — the bar never appeared. Setting the
    resting state via `transform` puts it on the same property GSAP animates.
  */
  .problem-cards__progress-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }

  .problem-cards__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* Sits inside the gutter so the first card lines up with the heading,
       while the strip itself still runs full-bleed to the right edge. */
    padding-inline: var(--space-gutter);
    /* Without this, `scroll-snap-align: start` on the first card snaps PAST
       the leading padding on load (scrollLeft settles at the padding's own
       value instead of 0), so the card renders flush against the true
       viewport edge despite the padding above — this is what matches it to
       that padding instead of treating it as scrollable overscroll. */
    scroll-padding-inline: var(--space-gutter);
    /* Firefox/legacy: keep the scrollbar from adding height under the row. */
    scrollbar-width: none;
  }

  .problem-cards__viewport::-webkit-scrollbar {
    display: none;
  }

  .problem-cards__track {
    display: flex;
    gap: var(--problem-card-gap);
    width: max-content;
  }

  .problem-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 80vw;
    max-width: 26rem;
    height: 28.625rem;
    padding: var(--space-card-p);
    overflow: hidden;
    border-radius: var(--radius-control);
    background-color: var(--color-neutral-900);
    scroll-snap-align: start;
    flex: 0 0 auto;
  }

  .problem-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .problem-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Tailwind's preflight sets `img { max-width: 100% }`, which is exactly
       right here now (no oversized/offset crop to fight — see git history
       for the parallax version this replaced), but stated explicitly since
       this class also drives the `<div>` placeholder variant, which has no
       preflight rule of its own to inherit. */
    max-width: none;
  }

  /* Stand-in for photography not shot yet. A fixed neutral-700, not
     --color-accent-tint: the card itself is always a literal neutral-900
     (see .problem-card above, not page-themed), and a page whose dark-zone
     redefines --color-accent-tint to that same neutral-900 would make the
     placeholder invisible against its own card — this stays visible on
     every consuming page regardless of how it themes that token. */
  .problem-card__img-placeholder {
    position: absolute;
    inset: 0;
    background-color: var(--color-neutral-700);
  }

  .problem-card__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(from var(--color-black) r g b / 0.5), transparent);
  }
</style>

<script>
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../lib/sectionMotion'
  import { createDragCarousel } from '../lib/dragCarousel'

  // Same tuning family as src/lib/motion.ts's REVEAL (0.8s/power2.out/0.08
  // stagger, `start: 'top 85%'`) — this is that same entrance, just sliding
  // in on x instead of y since the row is horizontal.
  const ENTRANCE = { x: -80, duration: 0.8, stagger: 0.08, ease: 'power2.out', start: 'top 85%' }

  bindSection('[data-problem-cards]', ({ root, mm }) => {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.problem-card'))
    const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]')
    if (!viewport || cards.length === 0) return

    // Progress bar now reads the row's own horizontal scroll position — a
    // plain function (not itself GSAP-tracked) so each branch below can
    // bind/unbind it as part of its own returned cleanup, same as the drag
    // carousel it sits alongside.
    function bindProgress() {
      if (!progressFill) return () => {}
      const maxScroll = () => Math.max(1, viewport!.scrollWidth - viewport!.clientWidth)
      const update = () => gsap.set(progressFill, { scaleX: viewport!.scrollLeft / maxScroll() })
      viewport!.addEventListener('scroll', update, { passive: true })
      update()
      return () => {
        viewport!.removeEventListener('scroll', update)
        gsap.set(progressFill, { scaleX: 0 })
      }
    }

    mm.add(MOTION_FULL, () => {
      const dragCleanup = createDragCarousel(viewport, { cardSelector: '.problem-card' })
      const progressCleanup = bindProgress()

      const tween = gsap.from(cards, {
        opacity: 0,
        x: ENTRANCE.x,
        duration: ENTRANCE.duration,
        stagger: ENTRANCE.stagger,
        ease: ENTRANCE.ease,
        scrollTrigger: { trigger: root, start: ENTRANCE.start, once: true },
      })

      return () => {
        dragCleanup?.()
        progressCleanup()
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      // Reduced motion and/or narrow viewport: drag still works (unless
      // reduced motion, which createDragCarousel itself bails on), the
      // entrance drops to a plain cross-fade — no travel — same split
      // src/lib/motion.ts's own reveals make.
      const dragCleanup = createDragCarousel(viewport, { cardSelector: '.problem-card' })
      const progressCleanup = bindProgress()

      const tween = gsap.from(cards, {
        opacity: 0,
        duration: 0.4,
        scrollTrigger: { trigger: root, start: 'top 90%', once: true },
      })

      return () => {
        dragCleanup?.()
        progressCleanup()
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>
