---
/**
 * Homepage hero (Figma node 770:390). Pinned via CSS `position: sticky` so
 * later sections scroll up and cover it — no JS needed for the pin itself.
 * The nav is part of this section's own content (overlaid, transparent,
 * light text) rather than BaseLayout's default bordered header — see
 * hideHeader on BaseLayout.
 *
 * Background is the paper-design Heatmap shader (@paper-design/shaders),
 * live only on this page — other pages use stills exported from the same
 * Paper project instead of paying the WebGL cost everywhere. The shape
 * (public/hero/hero-heatmap-shape.webp) and the uniform values below are
 * copied from the Paper editor. Speed is intentionally low (0.15) since
 * ShaderMount halts its rAF loop entirely at speed 0, and pauses whenever
 * the section is offscreen or the tab is hidden either way.
 */
import { navItems } from '../lib/nav'
import Heading from './Heading.astro'
---

{
  /* CSS dvh should track the live viewport as mobile browser chrome shows
     and hides, but in practice iOS Safari's 100dvh on the very first paint
     doesn't reliably match what's actually visible yet (the address bar
     hasn't "settled"), which let a strip of the next section show through
     before any scroll happened. Measuring the viewport in JS and writing
     it to --hero-vh is the reliable fix; the inline script below runs
     synchronously (blocking) before the section paints, so there's no
     flash. The 100lvh fallback only matters with JS disabled.

     Two different heights matter here, and using one for both is what
     produced the white band under the hero on iOS Safari:

     - window.innerHeight is the *layout* viewport — everything the page
       paints into. iOS 26 Safari floats its bottom toolbar on top of that
       area rather than shrinking it, so painting only as far as the
       visible area leaves the next (white) section showing through in the
       strip around the toolbar.
     - visualViewport.height is what's actually *visible* right now. Bottom
       content laid out past it disappears behind the browser chrome.

     So the section is sized to the layout viewport (--hero-vh) so its
     background bleeds behind the toolbar, and the gap between the two
     (--hero-chrome) is added to the bottom padding so the headline and
     lead still sit above it. The gap is clamped because an open keyboard
     shrinks the visual viewport dramatically, and that shouldn't crush the
     hero's content into the top half of the screen. */
}
{
  /* data-astro-rerun: ClientRouter skips any script (inline included) whose
     exact text already ran once, and swapping the document also wipes the
     <html> style attribute this writes --hero-vh into — so without the flag
     the variable is gone the moment you navigate back here and the hero
     silently falls back to 100lvh. The listeners are bound once behind a
     window flag, since only the property write needs repeating. */
}
<script is:inline data-astro-rerun>
  ;(function () {
    function setHeroVh() {
      const visible = window.visualViewport ? window.visualViewport.height : window.innerHeight
      const layout = Math.max(window.innerHeight, visible)
      const chrome = Math.min(Math.max(0, layout - visible), layout * 0.25)
      const style = document.documentElement.style
      style.setProperty('--hero-vh', layout + 'px')
      style.setProperty('--hero-chrome', chrome + 'px')
    }
    setHeroVh()
    if (!window.__fesHeroVhBound) {
      window.__fesHeroVhBound = true
      window.addEventListener('resize', setHeroVh)
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', setHeroVh)
      }
    }
  })()
</script>
<section
  class="sticky top-0 z-0 flex min-h-[720px] w-full flex-col justify-between overflow-hidden bg-[linear-gradient(to_right,#4A40F2,#0E004D)] px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-[calc(4rem+var(--hero-chrome,0px))] lg:pb-[calc(120px+var(--hero-chrome,0px))]"
  style="height: var(--hero-vh, 100lvh)"
>
  <div id="hero-shader" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full"></div>
  {
    /* Stops follow an ease-out curve (via larsenwork.com/easing-gradients)
       rather than a plain 2-stop linear-gradient, whose constant alpha
       ramp reads as a harsh band before fading to nothing. */
  }
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-12 lg:hidden"
    style="background: linear-gradient(to top, rgba(255,255,255,1) 0%, rgba(255,255,255,0.738) 19%, rgba(255,255,255,0.541) 34%, rgba(255,255,255,0.382) 47%, rgba(255,255,255,0.278) 56.5%, rgba(255,255,255,0.194) 65%, rgba(255,255,255,0.126) 73%, rgba(255,255,255,0.075) 80.2%, rgba(255,255,255,0.042) 86.1%, rgba(255,255,255,0.021) 91%, rgba(255,255,255,0.008) 95.2%, rgba(255,255,255,0.002) 98.2%, rgba(255,255,255,0) 100%)"
  >
  </div>

  <nav aria-label="Primary" class="relative z-10">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="shrink-0">
        <img src="/fes-logo-white.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
      </a>
      <ul class="hidden items-center lg:flex lg:gap-[var(--space-gutter)]">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-body text-azure-50 hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/30 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
        data-nav-toggle
      >
        Menu
      </button>
    </div>
  </nav>

  <div class="relative z-10">
    {
      /* max-w in ch, not a fixed px value: text-display's font-size is
         fluid (see global.css), so a fixed px cap wraps progressively
         tighter as the viewport (and font) grows past the 1440 reference —
         2 lines at 1440 became 4 at 2560. ch scales with the element's own
         font-size, so the wrap point stays proportional. */
    }
    <Heading as="h1" indent={false} class="max-w-[22ch] text-display text-neutral-50 lg:max-w-[50vw]" data-anim="split-text">
      We make tech companies impossible to ignore
    </Heading>
    <p class="mt-6 max-w-2xl text-lead text-neutral-50" data-anim="reveal">
      We help startups, tech companies and disruptive businesses effectively communicate their brand and their
      people.
    </p>
  </div>
</section>

<script>
  import {
    ShaderMount,
    heatmapFragmentShader,
    toProcessedHeatmap,
    getShaderColorFromString,
    ShaderFitOptions,
  } from '@paper-design/shaders'

  // The shape's soft-edge framing inside the fragment shader is a fixed
  // fraction of the box regardless of aspect ratio, so on a narrow portrait
  // viewport "cover" fit exposes it as visible top/bottom margins. Zooming
  // in and panning toward the left lobe (tuned by eye at 375 and 768px)
  // crops past that margin instead of trying to fill it.
  const MOBILE_QUERY = '(max-width: 1023px)'
  const desktopParams = { u_scale: 1, u_offsetX: 0 }
  const mobileParams = { u_scale: 1.45, u_offsetX: -0.2 }

  // Processed once per full page load and reused for every later mount:
  // toProcessedHeatmap fetches and re-encodes the shape, which would be a
  // visible delay before the shader appears each time you return here.
  let shapePromise: Promise<HTMLImageElement> | null = null

  function loadShape() {
    shapePromise ??= (async () => {
      const { blob } = await toProcessedHeatmap('/hero/hero-heatmap-shape.webp')
      const image = new Image()
      // The `load` event, not image.decode(): browsers defer decoding for a
      // document that isn't visible, and the decode() promise then simply
      // never settles — open the homepage in a background tab and the shader
      // would stay unmounted even after you switched to it. `load` is enough
      // for a WebGL texture upload, and it fires either way.
      const ready = new Promise<void>((resolve, reject) => {
        image.addEventListener('load', () => resolve(), { once: true })
        image.addEventListener('error', () => reject(new Error('Hero shader shape failed to load')), {
          once: true,
        })
      })
      image.src = URL.createObjectURL(blob)
      await ready
      return image
    })().catch((error) => {
      // Don't cache a rejection: a one-off failure would otherwise keep the
      // shader off for the rest of the session, since every later mount
      // awaits this same promise.
      shapePromise = null
      throw error
    })
    return shapePromise
  }

  let mount: ShaderMount | null = null
  let mobileQuery: MediaQueryList | null = null
  let onQueryChange: ((event: MediaQueryListEvent) => void) | null = null
  let onContextLost: ((event: Event) => void) | null = null
  let contextRetried = false
  // Bumped by every teardown so an in-flight mount (loading the shape is
  // async) can tell it was superseded and drop its result instead of
  // attaching a canvas to a section that has already been swapped out.
  let generation = 0

  async function init() {
    const container = document.getElementById('hero-shader')
    // Only the homepage renders it; astro:page-load fires on every page.
    if (!container || mount) return

    const token = generation
    const image = await loadShape()
    if (token !== generation || !container.isConnected) return

    mobileQuery = window.matchMedia(MOBILE_QUERY)

    mount = new ShaderMount(
      container,
      heatmapFragmentShader,
      {
        u_image: image,
        // Fill is set to a gradient in Paper (4A40F2 → 0E004D), and the shader
        // itself only takes a solid u_colorBack — so colorBack is transparent
        // here and the section's own CSS background gradient shows through
        // wherever the heatmap's opacity is less than 1.
        u_colorBack: [0, 0, 0, 0],
        u_colors: [
          getShaderColorFromString('#0E004D'),
          getShaderColorFromString('#4A40F2'),
          getShaderColorFromString('#2E0EB2'),
          getShaderColorFromString('#0E004D'),
        ],
        u_colorsCount: 4,
        u_angle: 90,
        u_noise: 0,
        u_innerGlow: 0.22,
        u_outerGlow: 0.29,
        u_contour: 0.309,
        u_fit: ShaderFitOptions.cover,
        u_rotation: 0,
        u_originX: 0.5,
        u_originY: 0.5,
        u_offsetY: 0,
        u_worldWidth: 0,
        u_worldHeight: 0,
        ...(mobileQuery.matches ? mobileParams : desktopParams),
      },
      undefined,
      0.5,
    )

    onQueryChange = (event) => {
      mount?.setUniforms(event.matches ? mobileParams : desktopParams)
    }
    mobileQuery.addEventListener('change', onQueryChange)

    // Mobile Safari drops WebGL contexts under memory pressure (backgrounding
    // the tab is enough), which leaves the canvas blank and the section
    // showing only its CSS gradient. preventDefault marks the loss as
    // recoverable; one remount is enough, and the retry is one-shot so a
    // device that simply can't hold a context doesn't loop.
    onContextLost = (event) => {
      event.preventDefault()
      if (contextRetried) return
      contextRetried = true
      teardown()
      start()
    }
    mount.canvasElement.addEventListener('webglcontextlost', onContextLost)
  }

  function teardown() {
    generation += 1
    if (mobileQuery && onQueryChange) mobileQuery.removeEventListener('change', onQueryChange)
    if (mount && onContextLost) mount.canvasElement.removeEventListener('webglcontextlost', onContextLost)
    // Frees the GL program/textures and removes the canvas — without it a
    // client-side navigation would leak a context per visit, and browsers
    // cap how many can be live at once.
    mount?.dispose()
    mount = null
    mobileQuery = null
    onQueryChange = null
    onContextLost = null
  }

  // Setup/teardown pair per feature (see docs/conventions.md). Mounting from
  // module top-level instead would run exactly once per full page load: with
  // <ClientRouter /> the module is already in the browser's registry when you
  // navigate back to the homepage, so the shader never remounted and the
  // section fell back to its bare CSS gradient.
  // A failed mount is survivable — the section keeps its CSS gradient — so
  // the rejection is swallowed rather than left to surface as an unhandled
  // promise error in the console.
  function start() {
    void init().catch(() => {})
  }

  document.addEventListener('astro:page-load', () => {
    // A fresh navigation gets a fresh retry budget; the recovery path itself
    // doesn't, so a device that can't hold a context stops after one attempt.
    contextRetried = false
    start()
  })
  document.addEventListener('astro:before-swap', teardown)
</script>
