---
/**
 * variant="card": ported from the old React prototype's StatsBlock.tsx,
 * reskinned onto the token system.
 *
 * variant="minimal": pulled from the homepage "We drive results" frame
 * (node 770:341) — borderless, a bottom rule doubling as an auto-rotate
 * progress track (see index.astro's stats-cycle script), value dims/brightens
 * for the inactive/active state instead of a card background.
 *
 * The track/fill line is two stacked `absolute inset-x-0 bottom-0 h-px`
 * layers, not a `border-b` (track) plus an absolutely-positioned overlay
 * (fill) — that combination measured the fill's `bottom: 0` against the
 * track element's padding box while the border painted outside it, landing
 * the fill's line one border-width above the track's, i.e. exactly the
 * "blue line sits a pixel above" bug. Two layers using the same
 * positioning are guaranteed to land on the same pixel. Per user request,
 * the unplayed (track) portion no longer follows this item's own
 * active/inactive rotation state — it's a fixed muted tone (still
 * responsive to the section's light/dark invert though, see
 * --stat-line-track in index.astro) — and the played (fill) portion reuses
 * --stat-value-active directly rather than a separate accent color, so it
 * always matches the highlighted number's own color in both schemes.
 */
interface Props {
  value: string
  label: string
  variant?: 'card' | 'minimal'
  active?: boolean
  class?: string
}

const { value, label, variant = 'card', active = false, class: className } = Astro.props
---

{
  variant === 'minimal' ? (
    <div
      class:list={['group/stat stat-minimal flex flex-col items-start pb-8', className]}
      data-active={active ? 'true' : 'false'}
    >
      <div class="stat-minimal__track relative w-full pb-4">
        <dd
          class="text-h1 tracking-tight transition-colors duration-300 [color:var(--stat-value-inactive,var(--color-neutral-700))] group-data-[active=true]/stat:[color:var(--stat-value-active,var(--color-neutral-200))]"
        >
          {value}
        </dd>
        <span class="stat-minimal__line absolute inset-x-0 bottom-0 h-px [background-color:var(--stat-line-track,var(--color-neutral-700))]" />
        <span class="stat-minimal__fill absolute inset-x-0 bottom-0 h-px origin-left [background-color:var(--stat-value-active,var(--color-neutral-200))]" />
      </div>
      <dt class="pt-4 text-body-sm leading-[1.2] [color:var(--stat-label,var(--color-neutral-400))]">{label}</dt>
    </div>
  ) : (
    <div class:list={['flex flex-col gap-6 rounded-[var(--radius-card)] bg-surface p-[var(--space-card-p)] shadow-[var(--shadow-card)]', className]}>
      <dd class="text-h1 text-ink">{value}</dd>
      <dt class="text-body text-ink-secondary">{label}</dt>
    </div>
  )
}

<style>
  .stat-minimal__fill {
    transform: scaleX(0);
  }
  .stat-minimal[data-active='true'] .stat-minimal__fill {
    animation: stat-fill 4000ms linear forwards;
  }
  @keyframes stat-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-minimal[data-active='true'] .stat-minimal__fill {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
