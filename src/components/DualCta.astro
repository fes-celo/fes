---
/**
 * Dual CTA block — "Get in touch" / "Our work" pair, extracted from the
 * bottom of the Systems pages (src/pages/systems/index.astro and
 * src/pages/systems/influence-reputation/index.astro), which previously
 * duplicated this markup verbatim. Both pages now consume this component;
 * the Projects case study template is the third consumer.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import UnderlineLink from './UnderlineLink.astro'

interface Props {
  leftHeading: string
  leftHref: string
  leftLabel: string
  rightHeading: string
  rightHref: string
  rightLabel: string
  /** Required for the default 'image' variant; unused (and skippable) for 'outline'. */
  rightImage?: ImageMetadata
  /** 'outline' swaps the photo card for the borderless-card treatment from
   * the homepage's "Know more about our systems" link (border-accent-200,
   * no image) — for a right-hand CTA that isn't a portfolio/work preview. */
  rightVariant?: 'image' | 'outline'
  class?: string
}

const {
  leftHeading,
  leftHref,
  leftLabel,
  rightHeading,
  rightHref,
  rightLabel,
  rightImage,
  rightVariant = 'image',
  class: className,
} = Astro.props
---

<section class:list={['relative z-10 w-full bg-surface px-[var(--space-gutter)] pb-16', className]} data-anim="reveal">
  <div class="grid grid-cols-1 gap-7 lg:grid-cols-2">
    <a
      href={leftHref}
      class="group flex min-h-[360px] flex-col items-start justify-between gap-10 rounded-[var(--radius-card)] bg-accent-950 p-[var(--space-card-p)] lg:min-h-[480px]"
      data-underline-trigger
    >
      <p class="max-w-sm text-h3 text-accent-50">{leftHeading}</p>
      <UnderlineLink as="span" class="text-display text-accent-50">{leftLabel}</UnderlineLink>
    </a>
    {
      rightVariant === 'outline' ? (
        <a
          href={rightHref}
          class="group flex min-h-[360px] flex-col justify-between gap-10 rounded-[var(--radius-card)] border border-accent-200 p-[var(--space-card-p)] lg:min-h-[480px]"
          data-underline-trigger
        >
          <p class="max-w-sm text-h3 font-normal text-accent-400">{rightHeading}</p>
          <UnderlineLink as="span" wrap class="self-start text-h2 text-accent-400">
            {rightLabel}
          </UnderlineLink>
        </a>
      ) : (
        <a
          href={rightHref}
          class="group relative flex min-h-[360px] flex-col items-start justify-between gap-10 overflow-hidden rounded-[var(--radius-card)] p-[var(--space-card-p)] lg:min-h-[480px]"
          data-underline-trigger
        >
          <Image
            src={rightImage!}
            alt=""
            width={2000}
            height={1618}
            widths={[640, 1000, 2000]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-black/20"></div>
          <p class="relative max-w-sm text-h3 text-accent-50">{rightHeading}</p>
          <UnderlineLink as="span" class="relative text-display text-accent-50">{rightLabel}</UnderlineLink>
        </a>
      )
    }
  </div>
</section>
