---
/**
 * Big CTA verb ("Let's talk", "See our Systems", "Get in touch", "Our work")
 * with a GSAP underline that wipes in left→right on hover, replacing the
 * opacity fade these CTAs used before.
 *
 * Two shapes, because the CTA pairs are built two different ways:
 *  - `as="a"` — the CTA is its own link (homepage cards), so it is both the
 *    hover trigger and the underlined text.
 *  - `as="span"` — the whole card is one <a> (Systems / Careers CTA pair).
 *    Put `data-underline-trigger` on that outer anchor and the underline
 *    reacts to hovering anywhere on the card, matching the old
 *    `group-hover:` behaviour.
 */
interface Props {
  href?: string
  as?: 'a' | 'span'
  /**
   * For CTA text that can wrap onto multiple lines — draws the underline as
   * a duplicated text-decoration overlay wiped in via clip-path, instead of
   * the single scaleX line below. That line is one box spanning the CTA's
   * widest line, so on wrapped text it draws under the short second line at
   * the long first line's width — floating well past the actual word. Same
   * technique (and the same reasoning) as SystemCard.astro's title
   * underline; see that component's docstring for the full case against a
   * background-wipe alternative too.
   */
  wrap?: boolean
  class?: string
}

const { href, as = 'a', wrap = false, class: className = '' }: Props = Astro.props
const Tag = as
---

<Tag
  {...as === 'a' ? { href } : {}}
  class={`cta-underline ${className}`}
  {...wrap ? { 'data-underline-wrap': true } : { 'data-underline': true }}
>
  <slot />
  {
    wrap ? (
      <span class="cta-underline__rule" aria-hidden="true">
        <slot />
      </span>
    ) : (
      <span class="cta-underline__line" data-underline-line aria-hidden="true" />
    )
  }
</Tag>

<style>
  .cta-underline {
    position: relative;
    display: inline-block;
  }

  /* Sits below the descenders — `text-display` runs a 0.98 line-height, so
     the line box bottom lands above the font's descent and a `bottom: 0`
     rule would strike through the tail of a "p" or "y" ("Apply now"). */
  .cta-underline__line {
    position: absolute;
    inset-inline: 0;
    bottom: -0.12em;
    height: max(2px, 0.045em);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  /* wrap variant: a duplicate of the CTA text stacked exactly over the real
     one, glyphs knocked out and a real `text-decoration` underline drawn
     instead — it inherits the same box and font, so it wraps identically,
     giving every line its own underline at its own width. clip-path wipes
     the whole block from the right so a multi-line CTA reveals as one
     left-to-right sweep rather than each line racing to its own width. */
  .cta-underline__rule {
    position: absolute;
    inset: 0;
    -webkit-text-fill-color: transparent;
    text-decoration-line: underline;
    text-decoration-thickness: max(2px, 0.045em);
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: auto;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.45s ease-out;
    pointer-events: none;
    user-select: none;
  }

  .cta-underline__rule.is-visible {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-underline__rule {
      transition: none;
    }
  }
</style>

<script>
  import { onPageLoad, onPageUnload } from '../lib/lifecycle'
  import { gsap } from 'gsap'

  let cleanups: Array<() => void> = []

  function setupUnderlines() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    document.querySelectorAll<HTMLElement>('[data-underline]').forEach((el) => {
      const line = el.querySelector<HTMLElement>('[data-underline-line]')
      if (!line) return

      // Card-level hover for the `as="span"` shape; otherwise the CTA itself.
      const trigger = el.closest<HTMLElement>('[data-underline-trigger]') ?? el

      gsap.set(line, { scaleX: 0, transformOrigin: 'left center' })

      const show = () => {
        gsap.killTweensOf(line)
        gsap.set(line, { transformOrigin: 'left center' })
        gsap.to(line, {
          scaleX: 1,
          duration: prefersReducedMotion ? 0 : 0.45,
          ease: 'power2.out',
        })
      }

      const hide = () => {
        gsap.killTweensOf(line)
        // Only flip the origin once the line is fully drawn — at scaleX 1 the
        // swap is visually a no-op, so the exit can sweep out to the right.
        // Retracting a partial line keeps the left origin, which avoids the
        // jump a mid-tween origin change would cause.
        if (gsap.getProperty(line, 'scaleX') === 1) {
          gsap.set(line, { transformOrigin: 'right center' })
        }
        gsap.to(line, {
          scaleX: 0,
          duration: prefersReducedMotion ? 0 : 0.35,
          ease: 'power2.in',
        })
      }

      trigger.addEventListener('mouseenter', show)
      trigger.addEventListener('mouseleave', hide)
      trigger.addEventListener('focusin', show)
      trigger.addEventListener('focusout', hide)

      cleanups.push(() => {
        gsap.killTweensOf(line)
        trigger.removeEventListener('mouseenter', show)
        trigger.removeEventListener('mouseleave', hide)
        trigger.removeEventListener('focusin', show)
        trigger.removeEventListener('focusout', hide)
      })
    })

    document.querySelectorAll<HTMLElement>('[data-underline-wrap]').forEach((el) => {
      const rule = el.querySelector<HTMLElement>('.cta-underline__rule')
      if (!rule) return

      // Blink resolves a `currentColor` decoration through the glyph-hiding
      // -webkit-text-fill-color above, so the underline needs an explicit
      // color of its own — read once from the real, visible text (see
      // SystemCard.astro's docstring for the same quirk).
      rule.style.textDecorationColor = getComputedStyle(el).color

      const trigger = el.closest<HTMLElement>('[data-underline-trigger]') ?? el

      const show = () => rule.classList.add('is-visible')
      const hide = () => rule.classList.remove('is-visible')

      trigger.addEventListener('mouseenter', show)
      trigger.addEventListener('mouseleave', hide)
      trigger.addEventListener('focusin', show)
      trigger.addEventListener('focusout', hide)

      cleanups.push(() => {
        trigger.removeEventListener('mouseenter', show)
        trigger.removeEventListener('mouseleave', hide)
        trigger.removeEventListener('focusin', show)
        trigger.removeEventListener('focusout', hide)
      })
    })
  }

  function teardownUnderlines() {
    cleanups.forEach((fn) => fn())
    cleanups = []
  }

  onPageLoad(setupUnderlines)
  onPageUnload(teardownUnderlines)
</script>
