---
/**
 * Contact page — plain white canvas, same hideHeader + inline <nav> pattern
 * as the legal pages (src/pages/privacy-policy/index.astro), since this page
 * is a single centered form rather than a marketing layout that needs the
 * bordered/canvas treatment.
 *
 * The form posts to /api/contact and expects a redirect to
 * /contact/thank-you on success — that's the lead-measurement contract
 * frozen in docs/measurement.md (Pages Function: validates, sends via
 * Resend, logs the record, then 302s). The Function itself, Turnstile, and
 * /contact/thank-you are Phase 3 build items and don't exist yet; this page
 * only wires up the markup/contract so that phase is a backend task, not a
 * markup one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import { navItems } from '../../lib/nav'
---

<BaseLayout title="Contact" description="Get in touch with FES Agency — tell us about your project and we'll get back to you." hideHeader>
  <nav aria-label="Primary" class="relative z-10 bg-surface px-[var(--space-gutter)] pt-[var(--space-gutter)]">
    <div class="flex items-start justify-between gap-6">
      <a href="/" class="shrink-0">
        <img src="/fes-logo-dark.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
      </a>
      <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/30 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
        data-nav-toggle
      >
        Menu
      </button>
    </div>
  </nav>

  <section class="bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]">
    <div class="mx-auto flex w-full max-w-[800px] flex-col items-center gap-16" data-anim="reveal">
      <Heading as="h1" indent={false} class="text-center text-h1 text-ink">
        Let's <span class="text-accent-default">talk</span>
      </Heading>

      <form action="/api/contact" method="POST" class="flex w-full flex-col gap-6">
        <div class="rounded-[var(--radius-card)] border border-line">
          <label class="block">
            <span class="sr-only">Your name</span>
            <input
              type="text"
              name="name"
              placeholder="Your name *"
              required
              class="w-full bg-transparent p-6 text-body text-ink placeholder:text-ink-disabled focus:outline-none"
            />
          </label>
        </div>

        <div class="rounded-[var(--radius-card)] border border-line">
          <label class="block">
            <span class="sr-only">Your e-mail</span>
            <input
              type="email"
              name="email"
              placeholder="Your e-mail *"
              required
              class="w-full bg-transparent p-6 text-body text-ink placeholder:text-ink-disabled focus:outline-none"
            />
          </label>
        </div>

        <div class="rounded-[var(--radius-card)] border border-line">
          <label class="block">
            <span class="sr-only">Your message</span>
            <textarea
              name="message"
              placeholder="Your message*"
              required
              rows="7"
              class="w-full resize-none bg-transparent p-6 text-body text-ink placeholder:text-ink-disabled focus:outline-none"
            ></textarea>
          </label>
        </div>

        <button
          type="submit"
          class="mx-auto mt-4 rounded-[var(--radius-button)] bg-accent-default px-[22px] py-[14px] text-h4 font-medium text-on-accent transition-colors hover:bg-accent-hover"
        >
          Send message
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
