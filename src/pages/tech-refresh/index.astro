---
/**
 * Tech Refresh — editorial hub for the podcast + video series. Not linked
 * from the primary nav yet (see lib/nav.ts's header comment: Resources/Tech
 * Refresh are footer-only until the /resources/ nav question is resolved),
 * only from the footer's "Tech Refresh" link.
 *
 * Hero reuses the Agency page's sticky, full-viewport hero verbatim (see
 * src/pages/agency/index.astro) — same hero-light.jpg background, same
 * structure — with Tech Refresh's own copy, per direct request.
 *
 * Podcast embed is Spotify's official iframe snippet as supplied; the video
 * is YouTube's standard embed (converted from the watch URL to /embed/).
 */
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import SectionLabel from '../../components/SectionLabel.astro'
import { navItems } from '../../lib/nav'
import heroLight from '../../assets/hero/hero-light.jpg'

const YOUTUBE_VIDEO_ID = 'LpGxyG6kEHQ'
const SPOTIFY_SHOW_ID = '2lcqtft2WniXHrHs9WInDW'
---

<BaseLayout
  title="Tech Refresh"
  description="Tech Refresh — where we celebrate the pioneers, the dreamers, and the disruptors who dare to push the boundaries of what's possible."
  hideHeader
  bordered
>
  <section class="sticky top-0 z-0 flex h-screen min-h-[720px] supports-[height:100dvh]:h-dvh w-full flex-col justify-between overflow-hidden bg-white px-[var(--space-gutter)] pt-[var(--space-page-top)] pb-[var(--space-section-y)]">
    <Image
      src={heroLight}
      alt=""
      width={2560}
      height={1440}
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <nav aria-label="Primary" class="relative z-10">
      <div class="flex items-center justify-between gap-6">
        <a href="/" class="shrink-0">
          <img src="/fes-logo-dark.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
        </a>
        <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/30 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
          data-nav-toggle
        >
          Menu
        </button>
      </div>
    </nav>

    <div class="relative z-10">
      <Heading as="h1" indent={false} class="max-w-[22ch] text-display text-ink lg:max-w-[50vw]" data-anim="split-text">Tech Refresh</Heading>
      <p class="mt-7 max-w-[820px] text-lead text-neutral-950" data-anim="reveal">
        Buckle up and get ready for an exhilarating journey through the heart of the tech world. This is Tech
        Refresh - where we celebrate the pioneers, the dreamers, and the disruptors who dare to push the boundaries
        of what's possible.
      </p>
    </div>
  </section>

  <section class="relative z-10 w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10">
      <SectionLabel>Tech Refresh Podcast</SectionLabel>
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col items-start gap-8">
          <p class="text-lead text-ink">
            Welcome to Tech Refresh, where we dive into the dynamic world of entrepreneurship, exploring the stories
            behind the innovations that shape our digital landscape. Every episode reveals the journeys of visionary
            entrepreneurs who are revolutionizing industries through technology.
          </p>
          <a
            href={`https://open.spotify.com/show/${SPOTIFY_SHOW_ID}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[var(--radius-button)] bg-accent-tint px-[22px] py-[14px] text-h4 font-medium text-ink transition-colors hover:bg-accent-tint-hover"
          >
            Listen all episodes
          </a>
        </div>
        <iframe
          data-testid="embed-iframe"
          style="border-radius:12px"
          src={`https://open.spotify.com/embed/show/${SPOTIFY_SHOW_ID}?utm_source=generator`}
          width="100%"
          height="352"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="relative z-10 w-full bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10">
      <SectionLabel>Tech Refresh Video Series</SectionLabel>
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="relative w-full overflow-hidden rounded-[var(--radius-card)]" style="padding-top: 56.25%">
          <iframe
            class="absolute inset-0 size-full"
            src={`https://www.youtube.com/embed/${YOUTUBE_VIDEO_ID}`}
            title="Tech Refresh - Video Series Teaser"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="flex flex-col items-start gap-8">
          <p class="text-lead text-ink">
            The ultimate destination for an exclusive peek behind the curtain of the most innovative tech companies
            in Portugal. Through this immersive video-series we uncover the untold stories of entrepreneurs and
            companies. In each episode, we'll take you inside the vibrant headquarters of leading tech companies,
            where innovation thrives and ambition knows no bounds.
          </p>
          <a
            href={`https://www.youtube.com/watch?v=${YOUTUBE_VIDEO_ID}`}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-[var(--radius-button)] bg-accent-tint px-[22px] py-[14px] text-h4 font-medium text-ink transition-colors hover:bg-accent-tint-hover"
          >
            Watch the full series
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
