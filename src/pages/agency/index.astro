---
/**
 * Agency page (Figma desktop node 770:565 / mobile node 855:240). Hero
 * nav is overlaid on its own light background image rather than
 * BaseLayout's bordered header — same hideHeader pattern as the homepage
 * Hero, see BaseLayout's hideHeader prop and docs/conventions.md.
 *
 * Hero is `position: sticky` with `h-screen` (was `relative` with a
 * content-driven `min-h-[720px] lg:min-h-[1080px]`) — ported from the
 * homepage Hero (see Hero.astro) per user request, so it always occupies
 * the full viewport and every section below scrolls up and covers it on
 * the z-axis, exactly like the homepage and Careers page
 * (src/pages/careers/index.astro).
 */
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Heading from '../../components/Heading.astro'
import SectionLabel from '../../components/SectionLabel.astro'
import LogoMarquee from '../../components/LogoMarquee.astro'
import SectionIntro from '../../components/SectionIntro.astro'
import { navItems, isNavActive } from '../../lib/nav'
import heroLight from '../../assets/hero/hero-light.jpg'

import behaviourSystems from '../../assets/behaviours/Systems, not scattered services.png'
import behaviourAnticipation from '../../assets/behaviours/Anticipation over reaction.png'
import behaviourJudgment from '../../assets/behaviours/A decade of judgment.webp'

import liliana from '../../assets/people/FES_Liliana.png'
import helder from '../../assets/people/FES_Helder.png'
import abigail from '../../assets/people/FES_Abigail.png'
import ricardo from '../../assets/people/FES_Ricardo.png'
import joana from '../../assets/people/FES_joana.png'
import manuel from '../../assets/people/FES_Manuel.png'
import beatriz from '../../assets/people/FES_Beatriz.png'
import marcelo from '../../assets/people/FES_Marcelo.png'
import claudia from '../../assets/people/FES_Cláudia.png'
import diana from '../../assets/people/FES_Diana.png'
import maria from '../../assets/people/FES_Maria.png'
import Logo from '../../components/Logo.astro'

const team = [
  { name: 'Liliana Castro', role: 'Founder & CEO', src: liliana },
  { name: 'Helder Soares', role: 'Account Manager', src: helder },
  { name: 'Abigail Baptista', role: 'Project Manager', src: abigail },
  { name: 'Ricardo Caldas', role: 'PR & Communication Manager', src: ricardo },
  { name: 'Joana Nunes', role: 'PR & Communication Manager', src: joana },
  { name: 'Manuel Faria', role: 'Social Media Manager', src: manuel },
  { name: 'Beatriz Ventura', role: 'Intern', src: beatriz },
  { name: 'Marcelo Nunes', role: 'Communication Designer', src: marcelo },
  { name: 'Cláudia Barros', role: 'Communication Designer', src: claudia },
  { name: 'Diana Maia', role: 'Strategist', src: diana },
  { name: 'Maria Dias', role: 'Events Manager', src: maria },
]

const behaviours = [
  {
    title: 'Systems, not scattered services',
    body: 'We design a system where each service knows what others do, built that way from day one.',
    image: behaviourSystems,
  },
  {
    title: 'Anticipation over reaction',
    body: 'We recognize what a company needs before it names it.',
    image: behaviourAnticipation,
  },
  {
    title: 'A decade of judgment',
    body: "We've seen enough of the Portuguese tech ecosystem to recognize patterns",
    image: behaviourJudgment,
  },
]

const pillars = [
  {
    title: 'Direct',
    body: "We don't reach for jargon to sound smarter than the message requires. If something isn't going to work, we say so before it happens, not after. Our voice is direct, no detours.",
  },
  {
    title: 'Accountable',
    body: "What we do affects someone else's reputation, not just ours. We own that — in the wins, and when something goes wrong. Our voice takes responsibility. It doesn't hide behind abstract results.",
  },
  {
    title: 'Close',
    body: "We're a distributed team with no physical office. That doesn't make us colder — it means communicating better and showing up more, not less. Our voice stays close, even when the work is remote.",
  },
  {
    title: 'Result-focused',
    body: 'After a decade, we know creativity without results is just decoration. We talk about what a communication system changes inside a company — not the effort we put into it. Our voice talks about outcomes, not effort.',
  },
]

// Same client logos as the homepage "Trusted by" marquee (see
// src/lib/clients.ts) — Figma renders them monochrome here (grayscale
// filter) in a static bordered row instead of the homepage's animated
// marquee.
---

<BaseLayout
  title="Agency"
  ogImage={heroLight}
  description="Ten years inside Portugal's tech ecosystem: the team and systems behind FES Agency's PR, digital, design and events work."
  hideHeader
  bordered
>
  <section class="sticky top-0 z-0 flex h-screen min-h-[min(45rem,100svh)] supports-[height:100dvh]:h-dvh w-full flex-col justify-between overflow-hidden bg-white px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-16 lg:pb-[var(--space-gutter)]">
    <Image
      src={heroLight}
      alt=""
      width={2560}
      height={1440}
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <nav aria-label="Primary" class="relative z-10">
      <div class="flex items-start justify-between gap-6">
        <a href="/" class="shrink-0">
          <Logo class="h-[var(--nav-logo-h)] w-auto" />
        </a>
        <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(Astro.url.pathname, item.href) ? 'page' : undefined}
                  class:list={[
                    'text-body',
                    isNavActive(Astro.url.pathname, item.href) ? 'text-ink' : 'text-ink-secondary hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg transition-transform active:scale-[0.97] lg:hidden"
          data-nav-toggle
        >
          Menu
        </button>
      </div>
    </nav>

    <div class="relative z-10">
      <Heading as="h1" indent={false} class="text-display text-balance text-ink" data-anim="split-text">We close the gaps other agencies leave open</Heading>
      <p class="mt-7 max-w-[51.25rem] text-lead text-neutral-950" data-anim="reveal">
        Ten years inside Portugal's tech ecosystem, spent making sure PR, brand, digital and events never work as
        separate pieces.
      </p>
    </div>
  </section>

  <section class="relative z-10 bg-surface pt-[var(--space-gutter)]" data-anim="reveal">
    {
      /* Drag progress bar for the team strip — the same rule-as-progress-bar
         pattern as SystemProblemCards' "Sound familiar?" row: a neutral-200
         track with a neutral-950 fill scaled from the left, tracking the
         strip's own horizontal scrollLeft. It lives on its own gutter-padded
         wrapper so it lines up with where the first photo starts instead of
         running full-bleed. At rest (no-JS, or before the script runs) the
         fill is at scaleX(0), so it reads as a plain rule. */
    }
    <div class="px-[var(--space-gutter)] pb-8 lg:pb-10">
      <div class="team-progress relative h-px w-full bg-line" aria-hidden="true">
        <div class="team-progress__fill absolute inset-0 bg-ink" data-team-progress-fill></div>
      </div>
    </div>

    <div
      id="team"
      class="flex cursor-grab gap-4 overflow-x-auto scroll-smooth px-[var(--space-gutter)] pb-2 [-ms-overflow-style:none] [scrollbar-width:none] active:cursor-grabbing lg:gap-6 [&::-webkit-scrollbar]:hidden"
      data-team-track
    >
      {
        team.map((member) => (
          <figure class="w-[13.75rem] shrink-0 lg:w-[25rem]">
            <Image
              src={member.src}
              alt={`Portrait of ${member.name}, ${member.role} at FES Agency`}
              width={800}
              height={1048}
              draggable={false}
              class="aspect-[400/524] w-full rounded-[var(--radius-card)] object-cover"
            />
            <figcaption class="flex flex-col items-center pt-6 text-center">
              <p class="text-h4 text-ink">{member.name}</p>
              <p class="pt-1 text-h4 font-normal text-neutral-300">{member.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="relative z-10 bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <SectionIntro eyebrow="About us">
      We're a 100% remote comms agency wired into Portugal's tech scene, PR, digital, design, and events running as
      one.
      <Fragment slot="aside">
        <p class="max-w-[var(--measure-prose)] text-body text-ink" data-anim="reveal">
          FES started at a cowork table in Porto, when Portugal's tech scene was just beginning to need communication
          built for it, not borrowed from bigger, slower agencies. Ten years on, we're still filling the same kind of
          space, just at a different scale: not the gap between a startup and its first press release, but the gap
          between the specialists any growing company hires: PR, design, digital comms and events. That usually
          don't talk to each other. We built our Systems to close that gap on purpose, not by accident.
        </p>
      </Fragment>
    </SectionIntro>
  </section>

  <section class="relative z-10 bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-8">
      <SectionLabel>How we work</SectionLabel>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          behaviours.map((item) => (
            <div class="relative flex min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[var(--radius-control)] bg-neutral-900 p-[var(--space-card-p)] lg:min-h-[25rem]">
              <Image
                src={item.image}
                alt=""
                width={1600}
                height={1200}
                widths={[400, 640, 880, 1200, 1600]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                class="absolute inset-0 size-full object-cover"
              />
              {
                /* Eased vignette instead of a flat linear from/via/to: alpha
                   falls off quadratically (ease-out) from each edge toward a
                   fully transparent middle band, which reads as a soft glow
                   rather than the visible seam a linear 3-stop gradient
                   leaves where the `via` stop sits. */
              }
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,0,0,0.58)_0%,rgba(0,0,0,0.54)_9%,rgba(0,0,0,0.43)_18%,rgba(0,0,0,0.26)_28%,rgba(0,0,0,0)_38%,rgba(0,0,0,0)_58%,rgba(0,0,0,0.34)_69%,rgba(0,0,0,0.59)_80%,rgba(0,0,0,0.73)_90%,rgba(0,0,0,0.78)_100%)]" />
              <h3 class="relative z-10 text-h3 font-medium text-ink-inverse">{item.title}</h3>
              <p class="relative z-10 pt-6 text-body text-white/85 lg:pt-0">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative z-10 bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10 lg:grid lg:grid-cols-3 lg:items-start lg:gap-6">
      <h2 class="text-h2 text-ink lg:hidden" data-anim="split-text">We're frisky, focused &amp; funky</h2>
      <h2 class="hidden text-h2 text-ink lg:block" data-anim="split-text">We're frisky, focused<br />&amp; funky</h2>
      <div class="flex flex-col gap-8">
        {
          pillars.slice(0, 2).map((pillar) => (
            <div class="flex flex-col items-start">
              <div class="w-full border-b border-neutral-200 pb-2 lg:pb-4">
                <h3 class="text-lead font-medium text-neutral-950">{pillar.title}</h3>
              </div>
              <p class="pt-4 text-body text-neutral-400 lg:pt-6">{pillar.body}</p>
            </div>
          ))
        }
      </div>
      <div class="flex flex-col gap-8">
        {
          pillars.slice(2, 4).map((pillar) => (
            <div class="flex flex-col items-start">
              <div class="w-full border-b border-neutral-200 pb-2 lg:pb-4">
                <h3 class="text-lead font-medium text-neutral-950">{pillar.title}</h3>
              </div>
              <p class="pt-4 text-body text-neutral-400 lg:pt-6">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative z-10 bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-8 lg:gap-10">
      <SectionLabel>Some of our favourite clients</SectionLabel>
      {
        /* Was a static bordered grid. Now the same scrolling strip as the
           homepage — the per-cell borders are gone because they can't tile
           cleanly in a moving track. */
      }
      <LogoMarquee grayscale rules="none" />
    </div>
  </section>
</BaseLayout>

<style>
  /*
    NOT Tailwind's `scale-x-0`: Tailwind v4 implements scale utilities with
    the INDEPENDENT `scale` property, which composes multiplicatively with
    whatever is written to `transform` — it would zero the fill out no
    matter what the script sets. Same note as SystemProblemCards.
  */
  .team-progress__fill {
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>

<script>
  import { onPageLoad, onPageUnload } from '../../lib/lifecycle'
  // Team-photo drag mirrors the homepage/Careers testimonial carousels: same
  // press-scale + magnetic snap-to-nearest-card mechanic (see
  // src/lib/dragCarousel.ts) instead of a plain mousedown/mousemove scroll.
  import { createDragCarousel } from '../../lib/dragCarousel'

  let teamDragCleanup: (() => void) | null = null
  let teamProgressCleanup: (() => void) | null = null

  function setupTeamDrag() {
    const track = document.querySelector<HTMLElement>('[data-team-track]')
    if (!track) return null
    return createDragCarousel(track, { cardSelector: 'figure' })
  }

  // Plain transform write rather than a GSAP tween: nothing else animates
  // this element, so there's no timeline to share and no reason to pull the
  // library into this page's bundle just to set one property per scroll
  // event.
  function setupTeamProgress() {
    const track = document.querySelector<HTMLElement>('[data-team-track]')
    const fill = document.querySelector<HTMLElement>('[data-team-progress-fill]')
    if (!track || !fill) return null

    const update = () => {
      const maxScroll = Math.max(1, track.scrollWidth - track.clientWidth)
      const ratio = Math.min(Math.max(track.scrollLeft / maxScroll, 0), 1)
      fill.style.transform = `scaleX(${ratio.toFixed(4)})`
    }

    track.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update)
    update()

    return () => {
      track.removeEventListener('scroll', update)
      window.removeEventListener('resize', update)
      fill.style.transform = ''
    }
  }

  function init() {
    teamDragCleanup = setupTeamDrag()
    teamProgressCleanup = setupTeamProgress()
  }

  function teardown() {
    teamDragCleanup?.()
    teamDragCleanup = null
    teamProgressCleanup?.()
    teamProgressCleanup = null
  }

  onPageLoad(init)
  onPageUnload(teardown)
</script>
