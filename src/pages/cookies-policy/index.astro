---
/**
 * Plain text legal page — white canvas, no header/footer dividers (see
 * BaseLayout's `bordered` prop). Nav is the same hideHeader + inline <nav>
 * pattern as the Projects page (same padding/margins), not BaseLayout's
 * default bordered header.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { navItems, isNavActive } from '../../lib/nav'
import Logo from '../../components/Logo.astro'
---

<BaseLayout
  title="Cookies Policy"
  description="What this website stores on your device — no advertising or analytics cookies — and how to manage cookies in your browser."
  hideHeader
>
  <nav aria-label="Primary" class="relative z-10 bg-surface px-[var(--space-gutter)] pt-[var(--space-gutter)]">
    <div class="flex items-start justify-between gap-6">
      <a href="/" class="shrink-0">
        <Logo class="h-[var(--nav-logo-h)] w-auto" />
      </a>
      <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isNavActive(Astro.url.pathname, item.href) ? 'page' : undefined}
                class:list={[
                  'text-body',
                  isNavActive(Astro.url.pathname, item.href) ? 'text-ink' : 'text-ink-secondary hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg transition-transform active:scale-[0.97] lg:hidden"
        data-nav-toggle
      >
        Menu
      </button>
    </div>
  </nav>

  <section class="bg-surface px-[var(--space-gutter)] pt-10 pb-[var(--space-section-y)]">
    <div class="mx-auto flex max-w-[47.5rem] flex-col gap-10">
      <h1 class="text-h1 text-ink">Cookies Policy</h1>

      {/* This page is an inventory, not a template: every entry below is
          something the site really stores or loads. The site has no consent
          banner because nothing here needs one — adding an analytics or
          advertising tag, or an embed that loads without a click, changes
          that. See parked-decisions §55 before doing either. */}
      <div class="flex flex-col gap-10 text-body text-ink-secondary [&_a]:text-ink [&_a]:underline [&_a:hover]:text-ink-secondary">
        <div class="flex flex-col gap-4">
          <p>
            This Cookies Policy explains what this website (the "Website") stores on, or reads from, your device.
            It is issued by Press Play, Unipessoal, Lda., trading as FES Agency, and should be read together with
            our <a href="/privacy-policy/">Privacy Policy</a>, which identifies us in full. For any questions, write
            to <a href="mailto:hello@fesagency.pt">hello@fesagency.pt</a>.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">What are cookies?</h2>
          <p>
            Cookies are small text files that a website stores in your browser. Similar technologies, such as the
            browser's local or session storage, work in the same way, and this policy covers them too.
          </p>
          <p>
            Under Portuguese law (Law no. 41/2004, article 5), a website may only store or read this information
            with your consent, unless it is strictly necessary to provide the service you asked for.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">In short</h2>
          <p>
            FES Agency does not use advertising cookies, analytics cookies or any other technology that tracks you.
            That is why this Website does not show a cookie banner: there is nothing to ask your consent for until
            you choose to play a video or a podcast from a third party, as described below.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">What this Website stores or loads</h2>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Logo animation (session storage)</h3>
            <p>
              On larger screens, the FES logo plays a short animation once per visit. To avoid repeating it on every
              page, we save one entry in your browser's session storage, <code class="text-ink">fes:logo-motion-played</code>,
              with the value "1". It contains no personal data, is never sent to us or anyone else, and is deleted
              automatically when you close the tab.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Security (Cloudflare)</h3>
            <p>
              The Website is hosted on Cloudflare. To protect it from automated abuse, Cloudflare may set strictly
              necessary security cookies, such as <code class="text-ink">__cf_bm</code>, which expires after 30
              minutes. On the contact page, Cloudflare Turnstile checks that the form is being sent by a person.
              These tools are needed to deliver the Website securely, are not used for advertising, and do not
              require consent.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Statistics (Cloudflare Web Analytics)</h3>
            <p>
              We count page views with Cloudflare Web Analytics, which does not use cookies or store anything on your
              device.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Videos and podcasts (YouTube and Spotify)</h3>
            <p>
              Some pages show videos from YouTube and a podcast player from Spotify. These players are not loaded
              when you open the page: nothing is sent to YouTube or Spotify until you click "Play". When you do,
              the provider may set its own cookies, which are governed by its own policy. YouTube videos are played
              in Google's privacy-enhanced mode.
            </p>
            <ul class="list-disc pl-6">
              <li><a href="https://policies.google.com/technologies/cookies" target="_blank" rel="noopener noreferrer">How Google (YouTube) uses cookies</a></li>
              <li><a href="https://www.spotify.com/legal/cookies-policy/" target="_blank" rel="noopener noreferrer">Spotify Cookies Policy</a></li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Managing cookies in your browser</h2>
          <p>
            You can see, delete and block cookies and site data at any time in your browser's settings. Blocking the
            security cookies described above may prevent the contact form from working.
          </p>
          <ul class="list-disc pl-6">
            <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer">Google Chrome</a></li>
            <li><a href="https://support.mozilla.org/kb/clear-cookies-and-site-data-firefox" target="_blank" rel="noopener noreferrer">Mozilla Firefox</a></li>
            <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" target="_blank" rel="noopener noreferrer">Safari on Mac</a></li>
            <li><a href="https://support.apple.com/en-us/105082" target="_blank" rel="noopener noreferrer">Safari on iPhone and iPad</a></li>
            <li><a href="https://support.microsoft.com/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer">Microsoft Edge</a></li>
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Updates to this Cookies Policy</h2>
          <p>
            If we change what the Website stores on your device, we will update this page before the change takes
            effect, and ask for your consent where the law requires it.
          </p>
          <p class="text-ink-muted">Date of last update: 28/09/2026</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
