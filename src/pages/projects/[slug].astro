---
/**
 * Case study detail template (/projects/[slug]/) — the page a visitor lands
 * on from a project card on the homepage, the Systems pages, or the
 * /projects/ listing. Content is static/hardcoded for now; see
 * src/lib/caseStudies.ts for the shape.
 *
 * Two columns, and the split IS the design:
 *
 *  - LEFT rail — client, title, intro, systems — is `position: sticky` at
 *    full viewport height, so it holds still for the entire scroll. Same
 *    mechanism as the sticky heroes on Agency/Systems/Careers, not a JS pin:
 *    nothing here needs to measure or transform, so CSS does it for free and
 *    it survives a View Transitions swap without re-initialising.
 *    `self-start` matters — a grid item stretches to the row height by
 *    default, and a stretched item has no free space to stick within.
 *
 *  - RIGHT column is an ordered list of blocks (`media` | `text`) rather
 *    than fixed sections, so each case study composes its own rhythm.
 *
 * Below `lg` the rail un-sticks and the two columns stack: a viewport-tall
 * pinned rail on a phone would spend the whole scroll covering the content.
 *
 * Images resolve by BASENAME through import.meta.glob (see `resolveImage`)
 * instead of per-entry `import` statements, so adding photography to a case
 * study is a drag-and-drop into src/assets/case-studies/<slug>/ with no code
 * change. A basename with nothing behind it yet falls back to
 * PlaceholderBlock labelled with the path it wants — the same "photography
 * not shot yet" pattern ProjectCard uses.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PlaceholderBlock from '../../components/PlaceholderBlock.astro'
import { caseStudies, getCaseStudy } from '../../lib/caseStudies'

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const caseStudy = getCaseStudy(slug!)!

/* Eager, so the resolved ImageMetadata is available during the SSG render.
   The glob literal has to be statically analysable — hence the `**` over all
   case studies rather than a per-slug pattern. */
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/case-studies/**/*.{jpg,jpeg,png,webp,avif,svg}',
  { eager: true },
)

/* Keyed by `<slug>/<basename>` with the extension dropped, so caseStudies.ts
   says `file: '01'` and picks up whichever of 01.webp/.jpg/.png is actually
   in the folder. Two files sharing a basename is a conflict — last one wins,
   which the folder README warns about. */
const bySlugAndName = new Map<string, ImageMetadata>()
for (const [path, mod] of Object.entries(assets)) {
  const match = path.match(/case-studies\/([^/]+)\/([^/]+)\.[^./]+$/)
  if (match) bySlugAndName.set(`${match[1]}/${match[2]}`, mod.default)
}

const resolveImage = (file: string) => bySlugAndName.get(`${caseStudy.slug}/${file}`)

const logo = caseStudy.logo ? resolveImage(caseStudy.logo.file) : undefined
// Share image: the first picture in the study, which is also the first
// thing a visitor sees on the page. Falls back to the site default when the
// photography for that block hasn't been dropped in yet.
const firstMedia = caseStudy.blocks.find((b) => b.type === 'media')
const ogImage = firstMedia?.type === 'media' ? resolveImage(firstMedia.items[0]!.file) : undefined
const dropPath = `src/assets/case-studies/${caseStudy.slug}/`
---

<BaseLayout
  title={`${caseStudy.clientName} — ${caseStudy.title}`}
  description={caseStudy.seoDescription ?? caseStudy.intro[0]}
  noindex={caseStudy.draft}
  ogImage={ogImage}
>
  {
    /*
      --cs-gap is the RIGHT column's internal gutter — between a pair of
      pictures, and between one media block and the next. Deliberately much
      tighter than --space-gutter (the page margin): the design reads those
      blocks as one contact sheet rather than as separate sections. Declared
      here rather than in global.css until a second surface wants the same
      measure.
    */
  }
  <div
    class="grid grid-cols-1 gap-12 px-[var(--space-gutter)] pb-[var(--space-section-y)] pt-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-[var(--space-gutter)]"
    style="--cs-gap: 0.875rem;"
  >
    {/* ---------- Left rail (fixed for the whole scroll) ---------- */}
    <div
      class="flex flex-col lg:sticky lg:top-12 lg:h-[calc(100vh-6rem)] lg:self-start"
    >
      {
        caseStudy.logo &&
          (logo ? (
            <Image src={logo} alt={caseStudy.logo.alt} widths={[120, 240]} sizes="120px" class="mb-8 h-8 w-auto" />
          ) : (
            <PlaceholderBlock
              tone="neutral"
              alt={`[${caseStudy.clientName} logo — drop ${caseStudy.logo.file} into ${dropPath}]`}
              class="mb-8 h-8 w-24 rounded-[var(--radius-card)]"
            />
          ))
      }

      <h1 class="text-h2 text-balance text-ink">
        {caseStudy.clientName}<br />{caseStudy.title}
      </h1>

      <div class="mt-8 flex flex-col gap-5 lg:mt-20">
        {caseStudy.intro.map((paragraph) => <p class="text-body text-ink">{paragraph}</p>)}
      </div>

      {
        /* mt-auto, so the systems line sits on the bottom edge of the pinned
           rail at lg and simply follows the intro on a stacked phone layout. */
      }
      <p class="mt-10 text-body-sm text-ink lg:mt-auto">{caseStudy.systems.join(' + ')}</p>
    </div>

    {/* ---------- Right column (scrolls past the rail) ---------- */}
    <div class="flex flex-col gap-[var(--cs-gap)]">
      {
        caseStudy.blocks.map((block) =>
          block.type === 'media' ? (
            <div
              class:list={[
                'grid gap-[var(--cs-gap)]',
                block.items.length > 1 && 'grid-cols-1 sm:grid-cols-2',
              ]}
            >
              {block.items.map((item) => {
                const image = resolveImage(item.file)
                const aspect = item.aspect ?? (block.items.length > 1 ? '3 / 4' : '3 / 2')
                /* One picture fills the 9/12 column; a pair splits it. Both
                   go full-bleed once the columns stack. */
                const sizes = block.items.length > 1
                  ? '(min-width: 1024px) 37vw, (min-width: 640px) 48vw, 100vw'
                  : '(min-width: 1024px) 74vw, 100vw'
                return (
                  <figure
                    class="overflow-hidden rounded-[var(--radius-card)] bg-neutral-100"
                    style={`aspect-ratio: ${aspect};`}
                  >
                    {image ? (
                      <Image
                        src={image}
                        alt={item.alt}
                        widths={[640, 1024, 1440, 1920]}
                        sizes={sizes}
                        class="size-full object-cover"
                      />
                    ) : (
                      <PlaceholderBlock
                        tone="neutral"
                        alt={`[${item.alt} — drop ${item.file} into ${dropPath}]`}
                        class="size-full"
                      />
                    )}
                  </figure>
                )
              })}
            </div>
          ) : block.variant === 'full' ? (
            /* The wide beat: one passage across the whole column at
               --text-lead. Extra bottom space on both text variants —
               pictures butt up against each other at --cs-gap, but copy
               running that tight into the next picture reads as a caption
               for it rather than as its own section. */
            <div class="flex flex-col gap-10 pt-1.5 pb-14 last:pb-0 lg:pb-20">
              {block.items.map((passage) => (
                <div class="flex flex-col gap-2">
                  {passage.label && <h2 class="text-body-sm text-neutral-400">{passage.label}</h2>}
                  <p class="text-lead text-neutral-950">{passage.body}</p>
                </div>
              ))}
            </div>
          ) : (
            <div
              class="grid grid-cols-1 gap-10 pt-1.5 pb-14 last:pb-0 sm:grid-cols-2 sm:gap-[var(--cs-gap)] lg:pb-20"
            >
              {block.items.map((passage) => (
                <div class="flex flex-col gap-2">
                  {passage.label && <h2 class="text-body-sm text-neutral-400">{passage.label}</h2>}
                  <p class="text-body text-neutral-950">{passage.body}</p>
                </div>
              ))}
            </div>
          ),
        )
      }
    </div>
  </div>
</BaseLayout>

