    title: 'Content Development',
    description:
      'We turn strategy into a production-ready plan: research, scripts, host and guest prep, and the recording setup.',
  },
  {
    number: '— 04',
    title: 'Production',
    description:
      'We run the full production — up to two days of filming, direction, audio and video capture. Up to six episodes, 45 minutes each.',
  },
  {
    number: '— 05',
    title: 'Content Repurposing',
    description:
      'One episode becomes many: edits, subtitling, thumbnails, graphics and clips — plus a teaser and twelve short videos.',
  },
  {
    number: '— 06',
    title: 'Review & Next Season',
    description:
      "We assess the series' performance — a report, the best-performing formats, the themes with the most interest, and recommendations for the next season.",
  },
]

// Straight from the source doc's "O que entregamos" — one phrase per bullet.
const builtForPhrases = [
  'Editorial strategy',
  'Series concept',
  'Episode planning',
  'Guest preparation',
  'Full production',
  'Editing',
  'Content repurposing',
  'Series evolution plan',
]

const addons = [
  {
    title: 'Distribution & Amplification',
    description: 'An organic and paid distribution plan to maximise the reach of the episodes.',
  },
  {
    title: 'Host / Spokesperson Positioning',
    description:
      'Reinforcing the positioning of the host or spokespeople involved, by amplifying the content produced. (This add-on connects directly with the Influence & Reputation System.)',
  },
]

// Page-local, same reasoning as the other two System pages: reuse whichever
// real project thumbnails already exist and fit the subject matter.
const selectedProjects = [
  {
    href: '/projects/blip-tedx/',
    title: 'Blip x TEDx',
    description: 'A video series built around a single day, turned into a recurring content engine.',
    thumbnail: blipThumb,
  },
  {
    href: '/projects/coverflex/',
    title: 'Coverflex',
    description: 'A brand film produced to carry a single narrative across every channel.',
    thumbnail: coverflexThumb,
  },
  {
    href: '/projects/startup-portugal/',
    title: 'Startup Portugal',
    description: 'Editorial content supporting the visibility of its ongoing initiatives.',
    thumbnail: startupPortugalThumb,
