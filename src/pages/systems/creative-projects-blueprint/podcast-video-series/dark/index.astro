            selectedProjects.map((project) => (
              <li class="w-[80vw] shrink-0 sm:w-[60vw] lg:w-auto" data-project-card>
                <ProjectCard
                  href={project.href}
                  title={project.title}
                  description={project.description}
                  variant="featured"
                  size="sm"
                  image={project.thumbnail}
                  imageAspect="aspect-[430/294]"
                  imageWidth={430}
                  imageHeight={294}
