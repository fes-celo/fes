---
/**
 * Creative Projects Blueprint → Podcast & Video-Series.
 *
 * LIGHT variant — ported from the original dark build (now preserved as-is
 * at ./dark/, per the same light/dark pairing convention used by the other
 * Creative Projects Blueprint pages).
 * See ../branding/index.astro's header comment for the full rationale
 * shared across all three Creative Projects Blueprint pages (no
 * `.dark-zone`/`.reveal-zone`, flat `bg-white` hero with no photo/scrim,
 * SystemAddonsMarquee instead of SystemAddonsCarousel, no Selected Projects
 * arrows) — not repeated here.
 *
 * COPY: rewritten from the client-supplied source doc "Creative Projects
 * Blueprint - Podcast & Video Series.md" (Portuguese, 2026 revision) — see
 * the dark variant's header comment for the full sourcing/mapping notes.
 * Not client-approved yet.
 */
import { Image } from 'astro:assets'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { navItems } from '../../../../lib/nav'
import Heading from '../../../../components/Heading.astro'
import SectionIntro from '../../../../components/SectionIntro.astro'
import SystemExpertiseRotator from '../../../../components/SystemExpertiseRotator.astro'
import SystemProblemCards from '../../../../components/SystemProblemCards.astro'
import PhasesScroll from '../../../../components/PhasesScroll.astro'
import ScrollCta from '../../../../components/ScrollCta.astro'
import BuiltForRotator from '../../../../components/BuiltForRotator.astro'
import SystemAddonsMarquee from '../../../../components/SystemAddonsMarquee.astro'
import DualCta from '../../../../components/DualCta.astro'

import ourWorkCta from '../../../../assets/systems/our-work-cta.jpg'
import heroBg from '../../../../assets/systems/creative-projects-blueprint/podcast-video-series/hero-bg.jpg'
import builtForBg from '../../../../assets/systems/built-for-bg.webp'

const expertiseWords = ['Knowledge', 'Content', 'Authority', 'Influence']

const problemCards = [
  {
    title: 'Specialists with real expertise and little visibility',
    label: 'Ideal for those who want to:',
    statement: 'Position leaders as industry experts. Reinforce thought leadership.',
  },
  {
    title: 'Content produced in bursts, with no continuity',
    label: 'Ideal for those who want to:',
    statement: 'Launch a podcast or video series.',
  },
  {
    title: 'Complex topics explained in an overly technical way',
    label: 'Ideal for those who want to:',
    statement: 'Communicate innovation consistently.',
  },
  {
    title: 'Reach that depends on social media alone',
    label: 'Ideal for those who want to:',
    statement: 'Bring clients, partners and community closer.',
  },
  {
    title: 'Internal knowledge that could build reputation for months goes to waste',
    label: 'Ideal for those who want to:',
    statement: 'Celebrate a milestone through an editorial series. Feed multiple communication channels.',
  },
]

// Fed to PhasesScroll only — bullet lists from the source doc's "Como
// implementamos" condensed into one sentence per phase. Six phases, matching
// the doc: Editorial Strategy and Concept & Identity are two distinct steps.
//
// LENGTH BUDGET: PhasesScroll's pinned rows are a FIXED height by design
// (--phase-row-h keeps the active row parked in a constant slot), which
// leaves descriptions ~3 rendered lines — about 125 characters at the
// desktop column width — before `overflow: hidden` shears the last line.
// Titles get 2 lines in a ~317px column. Keep new copy inside that budget
// rather than growing the row: the fixed height is what the slide depends on.
const approachSteps = [
  {
    number: '— 01',
    title: 'Editorial Strategy',
    description:
      "We define the series' positioning: a strategic diagnostic session, objectives, audience and key messages, episode structure and format, themes, guests, editorial calendar and distribution plan.",
  },
  {
    number: '— 02',
    title: 'Concept & Identity',
    description:
      'We give the series its own personality: discovery brainstorming, creative concept, naming, verbal identity, tone of voice, key messages and, where relevant, visual identity.',
  },
  {
    number: '— 03',
    title: 'Content Development',
    description:
      'We turn strategy into a production-ready plan: research, scripts, host and guest prep, and the recording setup.',
  },
  {
    number: '— 04',
    title: 'Production',
    description:
      'We run the full production — up to two days of filming, direction, audio and video capture. Up to six episodes, 45 minutes each.',
  },
  {
    number: '— 05',
    title: 'Content Repurposing',
    description:
      'One episode becomes many: edits, subtitling, thumbnails, graphics and clips — plus a teaser and twelve short videos.',
  },
  {
    number: '— 06',
    title: 'Review & Next Season',
    description:
      "We assess the series' performance — a report, the best-performing formats, the themes with the most interest, and recommendations for the next season.",
  },
]

// Straight from the source doc's "O que entregamos" — one phrase per bullet.
const builtForPhrases = [
  'Editorial strategy',
  'Series concept',
  'Episode planning',
  'Guest preparation',
  'Full production',
  'Editing',
  'Content repurposing',
  'Series evolution plan',
]

const addons = [
  {
    title: 'Distribution & Amplification',
    description: 'An organic and paid distribution plan to maximise the reach of the episodes.',
  },
  {
    title: 'Host / Spokesperson Positioning',
    description:
      'Reinforcing the positioning of the host or spokespeople involved, by amplifying the content produced. (This add-on connects directly with the Influence & Reputation System.)',
  },
]

// Page-local: client-supplied Podcast & Video-Series examples, each backed
// by its own YouTube episode/trailer rather than a static thumbnail.
const selectedProjects = [
  {
    title: 'FES Agency | Tech Refresh',
    description:
      "Over 100 episodes turning conversations about technology and innovation into FES Agency's own editorial platform.",
    youtubeId: 'LpGxyG6kEHQ',
  },
  {
    title: 'STCP | Cidade em Movimento',
    description: 'Urban mobility explained through the people, projects and ideas helping transform the city.',
    youtubeId: 'YZq9idWnFKg',
  },
  {
    title: 'Startup Braga | 10X Forward',
    description:
      'Ten episodes celebrating ten years of Startup Braga through the voices of those who helped build its ecosystem.',
    youtubeId: 'At7npN5tRNg',
  },
