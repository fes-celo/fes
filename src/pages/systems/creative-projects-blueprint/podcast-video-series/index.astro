---

<BaseLayout
  title="Podcast & Video-Series"
  description="Turn expertise into influence. A Blueprint that turns knowledge into an editorial platform, produced once and repurposed into dozens of assets."
  hideHeader
>
  {/* ---------- 1. Hero ---------- */}
  <section
    class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-white px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-16 lg:pb-[var(--space-gutter)] supports-[height:100dvh]:min-h-dvh"
  >
    <Image
      src={heroBg}
      alt=""
      width={2560}
      height={1440}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <nav aria-label="Primary" class="relative z-10">
      <div class="flex items-start justify-between gap-6">
        <a href="/" class="shrink-0">
          <img src="/fes-logo-dark.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
        </a>
        <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
          data-nav-toggle
        >
          Menu
        </button>
      </div>
    </nav>

    <div class="hero-copy relative z-10 mt-16 grid gap-x-4 gap-y-6 lg:flex-1 lg:gap-x-16 lg:gap-y-9">
      <Heading as="h1" indent={false} class="hero-copy__title text-display text-balance text-ink" data-anim="split-text">
        Turn expertise into influence
      </Heading>
      <p class="hero-copy__desc max-w-[48ch] text-lead text-ink" data-anim="reveal">
        Most companies have knowledge. Few turn it into a consistent communication platform.
      </p>
      <p class="hero-copy__name text-body-sm text-ink lg:text-body" data-anim="reveal">Creative Projects Blueprint · Podcast & Video-Series</p>
      <p class="hero-copy__duration text-right text-body-sm text-ink lg:text-body" data-anim="reveal">Duration: 3–6 months</p>
    </div>
  </section>

  <style>
    /* Mobile: title, then description, then a two-column name/duration row.
       Desktop keeps the original layout — description floating mid-hero,
       title pinned to the bottom with the name/duration row beneath it —
       via two flexible spacer rows standing in for the old justify-between. */
    .hero-copy {
      justify-content: space-between;
      grid-template-areas:
        'title title'
        'desc desc'
        'name duration';
    }
    .hero-copy__title {
      grid-area: title;
    }
    .hero-copy__desc {
      grid-area: desc;
    }
    .hero-copy__name {
      grid-area: name;
    }
    .hero-copy__duration {
      grid-area: duration;
    }

    @media (min-width: 1024px) {
      .hero-copy {
        grid-template-rows: 1fr auto 1fr auto auto;
        grid-template-areas:
          '. .'
          'desc desc'
          '. .'
          'title .'
          'name duration';
      }
    }
  </style>

  {/* ---------- 2. Expertise ---------- */}
  <SystemExpertiseRotator words={expertiseWords} />

  {/* ---------- 3. Introduction ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-7">
      <Heading as="p" indent={false} class="text-h2 text-ink lg:w-1/2">
        More than producing episodes, we design an editorial narrative that affirms your positioning and builds a
        consistent presence in your field.
      </Heading>
      <div class="flex flex-col gap-6 text-lead text-ink lg:w-1/2">
        <p>
          This Blueprint helps you create a podcast or video series that strengthens your positioning, increases
          visibility, and produces content that keeps generating value long after it's recorded.
        </p>
        <p>Because an episode should never live just once.</p>
      </div>
    </div>
  </section>

  {/* ---------- 3b. Sound familiar ---------- */}
  <SystemProblemCards cards={problemCards} class="bg-surface" />

  {/* ---------- 4. Our approach ---------- */}
  <PhasesScroll steps={approachSteps} class="bg-surface" />

  {
    /* Same chip as the homepage: shows once "Our approach" scrolls into
       view, hides once "Selected projects" (further down) does. */
  }
  <ScrollCta showSelector="[data-phases-scroll]" hideSelector="[data-selected-projects-section]" />

  {/* ---------- 5. Built for ---------- */}
  <BuiltForRotator phrases={builtForPhrases} backgroundImage={builtForBg} />

  {/* ---------- 6. Addons ---------- */}
  <SystemAddonsMarquee addons={addons} class="bg-surface pb-[var(--space-section-y)]" />

  {/* ---------- 7. Impact ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <SectionIntro eyebrow="Impact" eyebrowSize="text-body">
      An episode is never just an episode
      <div slot="aside" class="flex flex-col gap-6 text-balance text-lead text-ink">
        <p>This Blueprint creates a content base that keeps generating value long after publication.</p>
        <p>
          Every episode becomes reusable content that can support social media, campaigns, media relations, events,
          presentations and other communication initiatives — extending the impact of every recording.
        </p>
      </div>
    </SectionIntro>
  </section>

  {/* ---------- 8. Selected projects ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-selected-projects-section>
    <div class="flex flex-col gap-9">
      <Heading as="h2" indent={false} class="text-lead text-ink">
        Selected projects
      </Heading>
      <ul
        class="projects-strip -mx-[var(--space-gutter)] flex gap-7 overflow-x-auto px-[var(--space-gutter)] lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0"
        data-projects-row
      >
        {
          selectedProjects.map((project) => (
            <li class="w-[80vw] shrink-0 sm:w-[60vw] lg:w-auto" data-project-card>
              <div class="flex flex-col gap-6">
                <button
                  type="button"
                  aria-label={`Play ${project.title}`}
                  class="group relative flex aspect-[430/294] w-full items-center justify-center overflow-hidden rounded-[var(--radius-card)] bg-accent-tint"
                  data-youtube-facade
                  data-youtube-id={project.youtubeId}
                >
                  <img
                    src={`https://i.ytimg.com/vi/${project.youtubeId}/hqdefault.jpg`}
                    alt=""
                    loading="lazy"
                    class="absolute inset-0 size-full object-cover"
                  />
                  <span class="relative flex size-[6.25rem] shrink-0 items-center justify-center rounded-full bg-neutral-100 text-body text-neutral-950 transition-transform duration-200 group-hover:scale-105">
                    Play
                  </span>
                </button>
                <div class="flex flex-col gap-1">
                  <h3 class="text-body font-medium text-ink">{project.title}</h3>
                  <p class="text-body-sm font-normal text-ink-muted">{project.description}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- 9. Contact ---------- */}
  <DualCta
    leftHeading="Want to turn what you know into content?"
    leftHref="/contact/"
    leftLabel="Get in touch"
    rightHeading="Not sure Podcast & Video Series is the fit?"
    rightHref="/systems/creative-projects-blueprint/"
    rightLabel="See all Blueprints"
    rightImage={ourWorkCta}
  />
</BaseLayout>

<style>
  /* Hides the scrollbar on the mobile projects strip without disabling the
     scroll itself — same treatment as SystemProblemCards' fallback row. */
  .projects-strip {
    scrollbar-width: none;
  }
  .projects-strip::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Click-to-load YouTube facade: swaps the thumbnail + custom play button
  // for an iframe on click, so the red YouTube play button/branding never
  // shows and only the neutral-100 "Play" circle is visible up front.
  document.querySelectorAll<HTMLButtonElement>('[data-youtube-facade]').forEach((facade) => {
    facade.addEventListener(
      'click',
      () => {
        const youtubeId = facade.dataset.youtubeId
        const title = facade.getAttribute('aria-label')?.replace(/^Play /, '') ?? ''
        const iframe = document.createElement('iframe')
        iframe.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1&controls=0&rel=0&modestbranding=1`
        iframe.title = title
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
        iframe.allowFullscreen = true
        iframe.className = 'aspect-[430/294] w-full overflow-hidden rounded-[var(--radius-card)]'
        facade.replaceWith(iframe)
      },
      { once: true },
    )
  })

  // Staggered reveal for the projects row.
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../../../../lib/sectionMotion'

  bindSection('[data-projects-row]', ({ root, mm }) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'))
    if (cards.length === 0) return

    // fromTo, never from, for the opacity half of this reveal. A `from` tween
    // derives its END value by clearing the inline style and reading the
    // card's computed opacity straight back out of the DOM — and
    // ScrollTrigger.refresh() re-runs that revert-and-measure pass. If
    // anything in CSS transitions opacity on these cards, that read returns
    // the mid-transition value (i.e. the 0 the tween itself just wrote), the
    // reveal records 0 as its target, and the row animates 0 → 0: laid out,
    // moving, permanently invisible. That exact bug shipped once already —
    // see the [data-project-card] note in src/styles/global.css. Stating both
    // endpoints keeps the reveal correct no matter what CSS lands on them.
    mm.add(MOTION_FULL, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: { trigger: root, start: 'top 85%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.4,
          scrollTrigger: { trigger: root, start: 'top 90%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>
