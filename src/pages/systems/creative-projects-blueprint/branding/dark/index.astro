---
/**
 * Creative Projects Blueprint → Branding — DARK VARIANT.
 * The original "no photography yet" dark build of ../index.astro, preserved
 * here as-is once that page moved to a light theme — same copy, same data,
 * same section order, same `.dark-zone`/`.reveal-zone` mechanics. See
 * ../index.astro's header comment for the light rationale, and
 * src/pages/systems/influence-reputation/index.astro for the mechanics
 * shared across every dark variant on the site (custom-property re-theming,
 * SystemAddonsCarousel, Selected Projects arrows, dark→light reveal).
 *
 * ROUTING: lives under /systems/creative-projects-blueprint/branding/dark/,
 * mirroring Influence & Reputation's own light/dark pair.
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { navItems } from '../../../../../lib/nav'
import Heading from '../../../../../components/Heading.astro'
import SectionIntro from '../../../../../components/SectionIntro.astro'
import ProjectCard from '../../../../../components/ProjectCard.astro'
import SystemExpertiseRotator from '../../../../../components/SystemExpertiseRotator.astro'
import SystemProblemCards from '../../../../../components/SystemProblemCards.astro'
import PhasesScroll from '../../../../../components/PhasesScroll.astro'
import BuiltForRotator from '../../../../../components/BuiltForRotator.astro'
import SystemAddonsCarousel from '../../../../../components/SystemAddonsCarousel.astro'
import DualCta from '../../../../../components/DualCta.astro'

import ourWorkCta from '../../../../../assets/systems/our-work-cta.jpg'
import builtForBg from '../../../../../assets/systems/built-for-bg.webp'
import dashlaneThumb from '../../../../../assets/projects/dashlane.png'
import weWantYouThumb from '../../../../../assets/projects/we-want-you.png'
import coverflexThumb from '../../../../../assets/projects/coverflex.png'

const expertiseWords = ['Identity', 'Perception', 'Recognition', 'Preference']

// Card titles are the source doc's four "O desafio" bullets; each bullet's
// own description (not a separate ideal-for list, unlike Podcast/Events)
// becomes that card's "ideal for" statement, reframed as an action.
const problemCards = [
  {
    title: "The brand doesn't exist as a system yet",
    label: 'Ideal for those who want to:',
    statement: 'Launch a brand for a new company, a pre-launch, or a merger that made the old one obsolete.',
  },
  {
    title: "You're entering a market where you don't stand out",
    label: 'Ideal for those who want to:',
    statement: "Differentiate from a competitor's rebrand, or a category that changed its rules.",
  },
  {
    title: 'The brand has gotten too small for the company',
    label: 'Ideal for those who want to:',
    statement: 'Prepare for a funding round, accelerated growth, or a move into enterprise or institutional sales.',
  },
  {
    title: 'The team grew faster than the rules did',
    label: 'Ideal for those who want to:',
    statement: 'Bring consistency to a growing team producing decks, websites, print and signage independently.',
  },
]

// Fed to PhasesScroll only — bullet lists from the source doc's "Como
// implementamos" condensed into one sentence per phase.
//
// LENGTH BUDGET: PhasesScroll's pinned rows are a FIXED height by design
// (--phase-row-h keeps the active row parked in a constant slot), which
// leaves descriptions ~3 rendered lines — about 125 characters at the
// desktop column width — before `overflow: hidden` shears the last line.
// Titles get 2 lines in a ~317px column. Measured against the Influence &
// Reputation page, whose longest description is 122 chars. Keep new copy
// inside that budget rather than growing the row: the fixed height is what
// the whole slide mechanic depends on.
const approachSteps = [
  {
    number: '— 01',
    title: 'Diagnosis',
    description: "A structured conversation about the business, the market, and what isn't working.",
  },
  {
    number: '— 02',
    title: 'Strategy',
    description:
      'A competitive positioning map — where competitors sit and what space is left — plus the narrative, tone and visual vocabulary.',
  },
  {
    number: '— 03',
    title: 'Implementation',
    description:
      'Identity directions explored, with logo and application proposals, presented in a dedicated session with the reasoning behind each direction.',
  },
  {
    number: '— 04',
    title: 'Delivery & Activation',
    description:
      'A brand manual, an application library and organised final files. The project ends with a system ready to implement.',
  },
]

// Straight from the source doc's "O que entregamos" — condensed to short
// phrases for the rotator, one per bullet.
const builtForPhrases = [
  'Diagnostic document',
  'Approved visual direction',
  'Narrative, tone & vocabulary',
  'Identity directions',
  'Presentation sessions',
  'Refined identity',
  'Brand manual',
  'Application library',
  'Final files',
]

const addons = [
  {
    title: 'Website / Digital Product',
    description: 'The brand applied to the surface where the market meets it first — a project with its own scope and budget.',
  },
  {
    title: 'Naming',
    description:
      'The brand or product name, with evaluation criteria defined before exploration, name territories, and a justified final recommendation.',
  },
  {
    title: 'Implementation Support',
    description:
      "In the brand's first months, we review materials before they ship and correct drift while it's still cheap — for teams that inherited the system and haven't built the reflexes yet.",
  },
  {
    title: 'Periodic Review',
    description:
      "A brand audit at 6 or 12 months — where it's being applied outside the rules, what's changed in the market, and what the system no longer covers.",
  },
]

// Page-local, same reasoning as the other two System pages: reuse whichever
// real project thumbnails already exist and fit the subject matter, rather
// than inventing new case studies for a Blueprint with none shot yet.
const selectedProjects = [
  {
    href: '/projects/dashlane/',
    title: 'Dashlane',
    description: "A concept creation, dedicated website and campaigns built around Dashlane's identity.",
    thumbnail: dashlaneThumb,
  },
  {
    href: '/projects/we-want-you/',
    title: 'We Want You',
    description: 'A concept creation, dedicated website and campaigns.',
    thumbnail: weWantYouThumb,
  },
  {
    href: '/projects/coverflex/',
    title: 'Coverflex',
    description: 'A brand film built to carry a single identity across every touchpoint.',
    thumbnail: coverflexThumb,
  },
]
---

<BaseLayout
  title="Branding — Creative Projects Blueprint — Dark"
  description="Build a brand people remember, trust and choose. An 8-to-10-week Blueprint that aligns strategy, visual identity and communication into one consistent direction."
  hideHeader
  noindex
>
  <div class="dark-zone">
    {/* ---------- 1. Hero ---------- */}
    <section
      class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-surface px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-16 lg:pb-[var(--space-gutter)] supports-[height:100dvh]:min-h-dvh"
    >
      {
        /* No background photo shot for this Blueprint yet — the gradient
           scrim still runs on the plain dark surface so the section reads
           with the same depth once one lands, no layout change needed. */
      }
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[rgba(15,15,15,0)] from-[37%] to-[#0f0f0f] to-[92%]"
      >
      </div>

      <nav aria-label="Primary" class="relative z-10">
        <div class="flex items-start justify-between gap-6">
          <a href="/" class="shrink-0">
            <img src="/fes-logo-white.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
          </a>
          <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
            data-nav-toggle
          >
            Menu
          </button>
        </div>
      </nav>

      <p class="relative z-10 mt-16 max-w-[48ch] text-lead text-ink" data-anim="reveal">
        A brand is the set of decisions a company no longer has to keep making.
      </p>

      <div class="relative z-10 flex flex-col gap-9 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <div class="flex flex-col gap-9">
          <Heading as="h1" indent={false} class="text-display text-balance text-ink" data-anim="split-text">
            Turn brand decisions into a system
          </Heading>
          <p class="text-body text-ink" data-anim="reveal">Creative Projects Blueprint · Branding</p>
        </div>
        <p class="shrink-0 text-body text-ink lg:text-right" data-anim="reveal">Duration: 8–10 weeks</p>
      </div>
    </section>

    {/* ---------- 2. Expertise ---------- */}
    <SystemExpertiseRotator words={expertiseWords} />

    {/* ---------- 3. Introduction ---------- */}
    <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
      <div class="flex flex-col gap-10 lg:flex-row lg:gap-7">
        <Heading as="p" indent={false} class="text-h2 text-ink lg:w-1/2">
          This Blueprint fixes those decisions — narrative first, visual second, always in that order.
        </Heading>
        <div class="flex flex-col gap-6 text-lead text-ink lg:w-1/2">
          <p>
            How it presents itself, what it says first, what it refuses to say, how it's recognised when no one from
            the team is there to explain it. Until those decisions exist, every deck, every website and every new
            hire reopens the discussion from zero.
          </p>
          <p>
            What comes out of it is a system — narrative, identity, application rules — usable by people who weren't
            part of the process. The brand becomes decision infrastructure, not standalone aesthetics.
          </p>
        </div>
      </div>
    </section>

    {/* ---------- 3b. Sound familiar ---------- */}
    <SystemProblemCards cards={problemCards} class="bg-surface" />

    {/* ---------- 4. Our approach ---------- */}
    <PhasesScroll steps={approachSteps} class="bg-surface" />

    {/* ---------- 5. Built for ---------- */}
    <BuiltForRotator phrases={builtForPhrases} backgroundImage={builtForBg} />

    {/* ---------- 6. Addons ---------- */}
    <SystemAddonsCarousel
      addons={addons}
      ctaLabel="Talk to us"
      ctaHref="/contact/"
      class="bg-surface pt-[var(--space-section-y)] pb-[var(--space-section-y)]"
    />
  </div>

  {/* ---------- 7. Impact + 8. Selected projects — one reveal-zone ---------- */}
  <div class="reveal-zone" data-reveal-zone>
    <section class="w-full px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
      <SectionIntro eyebrow="Impact" eyebrowSize="text-body">
        The result isn't just a brand that looks better
        <div slot="aside" class="flex flex-col gap-6 text-balance text-lead text-ink">
          <p>
            It's less repeated work and internal friction over brand decisions, because the criteria are fixed and
            taste stops being the argument. It's a defensible position in front of different stakeholders, and
            consistency across every touchpoint even as the team grows — rules written down, not held in two
            people's heads.
          </p>
          <p>
            And it's a system built with room to hold proof — perception data, results, use cases — as the company
            produces them.
          </p>
        </div>
      </SectionIntro>
    </section>

    <section class="w-full px-[var(--space-gutter)] pb-[var(--space-section-y)]">
      <div class="flex flex-col gap-9">
        <div class="flex items-start justify-between gap-6 border-t border-line pt-4">
          <Heading as="h2" indent={false} class="text-lead text-ink">
            Selected projects
          </Heading>
          <div class="flex shrink-0 gap-2">
            <button
              type="button"
              data-projects-prev
              aria-label="Previous project"
              class="flex size-10 items-center justify-center rounded-[var(--radius-control)] border border-line transition-colors hover:bg-surface-hover"
            >
              <span class="reveal-arrow size-4 rotate-180 bg-ink" aria-hidden="true"></span>
            </button>
            <button
              type="button"
              data-projects-next
              aria-label="Next project"
              class="flex size-10 items-center justify-center rounded-[var(--radius-control)] border border-line transition-colors hover:bg-surface-hover"
            >
              <span class="reveal-arrow size-4 bg-ink" aria-hidden="true"></span>
            </button>
          </div>
        </div>
        <ul
          class="projects-strip -mx-[var(--space-gutter)] flex gap-7 overflow-x-auto px-[var(--space-gutter)] lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0"
          data-projects-row
        >
          {
            selectedProjects.map((project) => (
              <li class="w-[80vw] shrink-0 sm:w-[60vw] lg:w-auto" data-project-card>
                <ProjectCard
                  href={project.href}
                  title={project.title}
                  description={project.description}
                  variant="featured"
                  size="sm"
                  image={project.thumbnail}
                  imageAspect="aspect-[430/294]"
                  imageWidth={430}
                  imageHeight={294}
                  imageSizes="(min-width: 1024px) 30vw, 80vw"
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  {/* ---------- 9. Contact ---------- */}
  <DualCta
    leftHeading="Want to talk about your brand?"
    leftHref="/contact/"
    leftLabel="Get in touch"
    rightHeading="Not sure Branding is the fit?"
    rightHref="/systems/creative-projects-blueprint/"
    rightLabel="See all Blueprints"
    rightImage={ourWorkCta}
  />
</BaseLayout>

<style>
  /* Static dark palette for Hero → Addons — identical values to the other
     two System pages' dark variants, so all pages agree on what "dark" means. */
  .dark-zone {
    --color-surface: var(--color-neutral-950);
    --color-ink: var(--color-white);
    --color-ink-secondary: var(--color-neutral-300);
    --color-ink-muted: var(--color-neutral-400);
    --color-line: var(--color-neutral-800);
    --color-accent-tint: var(--color-neutral-900);
    /* SystemExpertiseRotator's rest/fill pair — same "barely there at rest,
       fully arrived once filled" logic as the light default, mirrored for a
       near-black surface. accent-700 (the light default's fill — see
       global.css) is a light-surface color: ~9:1 against white, but only
       ~2:1 against this near-black, well under WCAG minimums — so this
       branch keeps a neutral instead of following that value down. */
    --rotator-rest: var(--color-neutral-800);
    --rotator-fill: var(--color-neutral-100);
    background-color: var(--color-surface);
  }

  .projects-strip {
    scrollbar-width: none;
  }
  .projects-strip::-webkit-scrollbar {
    display: none;
  }

  .reveal-arrow {
    mask-image: url('/icons/icon-arrow-white.svg');
    -webkit-mask-image: url('/icons/icon-arrow-white.svg');
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
    mask-size: contain;
    -webkit-mask-size: contain;
  }

  /* Dark → light reveal, driven by --light-progress (0 or 1, set by the
     script below via ScrollTrigger) — same mechanism as the other two
     System pages' dark variants. Wraps Impact AND Selected Projects together
     so the two sections can never be caught mid-scroll half-dark/half-light. */
  .reveal-zone {
    --light-progress: 0;

    --color-surface: color-mix(in srgb, var(--color-white) calc(var(--light-progress) * 100%), var(--color-neutral-950));
    --color-ink: color-mix(in srgb, var(--color-neutral-950) calc(var(--light-progress) * 100%), var(--color-white));
    --color-ink-secondary: color-mix(in srgb, var(--color-neutral-700) calc(var(--light-progress) * 100%), var(--color-neutral-300));
    --color-ink-muted: color-mix(in srgb, var(--color-neutral-500) calc(var(--light-progress) * 100%), var(--color-neutral-400));
    --color-line: color-mix(in srgb, var(--color-neutral-200) calc(var(--light-progress) * 100%), var(--color-neutral-800));
    --color-accent-tint: color-mix(in srgb, var(--color-accent-50) calc(var(--light-progress) * 100%), var(--color-neutral-900));

    background-color: var(--color-surface);
    transition: background-color 200ms ease-out;
  }
  .reveal-zone :global(*) {
    transition:
      color 200ms ease-out,
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-zone,
    .reveal-zone :global(*) {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  // Staggered reveal for the projects row.
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../../../../../lib/sectionMotion'

  bindSection('[data-projects-row]', ({ root, mm }) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'))
    if (cards.length === 0) return

    // fromTo, never from, for the opacity half of this reveal. A `from` tween
    // derives its END value by clearing the inline style and reading the
    // card's computed opacity straight back out of the DOM — and
    // ScrollTrigger.refresh() re-runs that revert-and-measure pass. If
    // anything in CSS transitions opacity on these cards, that read returns
    // the mid-transition value (i.e. the 0 the tween itself just wrote), the
    // reveal records 0 as its target, and the row animates 0 → 0: laid out,
    // moving, permanently invisible. That exact bug shipped once already —
    // see the [data-project-card] note in src/styles/global.css. Stating both
    // endpoints keeps the reveal correct no matter what CSS lands on them.
    mm.add(MOTION_FULL, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: { trigger: root, start: 'top 85%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.4,
          scrollTrigger: { trigger: root, start: 'top 90%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>

<script>
  // Selected Projects arrows — scroll the mobile/tablet strip by one card.
  let cardStepCleanup: (() => void) | null = null

  function setupProjectsNav() {
    const strip = document.querySelector<HTMLElement>('[data-projects-row]')
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-projects-prev]')
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-projects-next]')
    if (!strip || !prevBtn || !nextBtn) return

    function cardStep() {
      const first = strip!.firstElementChild as HTMLElement | null
      const gap = parseFloat(getComputedStyle(strip!).columnGap || '0')
      return first ? first.getBoundingClientRect().width + gap : strip!.clientWidth
    }

    const onPrev = () => strip!.scrollBy({ left: -cardStep(), behavior: 'smooth' })
    const onNext = () => strip!.scrollBy({ left: cardStep(), behavior: 'smooth' })
    prevBtn.addEventListener('click', onPrev)
    nextBtn.addEventListener('click', onNext)

    cardStepCleanup = () => {
      prevBtn.removeEventListener('click', onPrev)
      nextBtn.removeEventListener('click', onNext)
    }
  }

  function teardownProjectsNav() {
    cardStepCleanup?.()
    cardStepCleanup = null
  }

  document.addEventListener('astro:page-load', setupProjectsNav)
  document.addEventListener('astro:before-swap', teardownProjectsNav)
</script>

<script>
  // Dark → light reveal on Impact + Selected Projects — identical mechanics
  // to the other two System pages' dark variants.
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  let revealTrigger: ScrollTrigger | null = null

  function setupReveal() {
    const zone = document.querySelector<HTMLElement>('[data-reveal-zone]')
    if (!zone) return

    const setLight = (on: boolean) => zone.style.setProperty('--light-progress', on ? '1' : '0')

    revealTrigger = ScrollTrigger.create({
      trigger: zone,
      start: 'top top',
      onEnter: () => setLight(true),
      onLeaveBack: () => setLight(false),
      onRefresh: (self) => setLight(self.progress > 0),
    })
  }

  function teardownReveal() {
    revealTrigger?.kill()
    revealTrigger = null
  }

  document.addEventListener('astro:page-load', setupReveal)
  document.addEventListener('astro:before-swap', teardownReveal)
</script>
