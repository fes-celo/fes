  // Definição de Objetivos": PhasesScroll clamps titles to two lines in a
  // ~317px column, and "Strategy & Success Definition" ran to three — the
  // third was being cut off mid-word.
  {
    number: '— 01',
    title: 'Strategy & Objectives',
    description:
      "We start with the objective, not the stage: goals, priority audience, success indicators, budget and timeline.",
  },
  {
    number: '— 02',
    title: 'Experience Design',
    description:
      'We turn the objective into an experience — creative concept, narrative, format, agenda, moments of interaction, activations, attendee journeys and a plan for collecting data and feedback.',
  },
  // NOTE: the source doc's caveat that supplier services (venue, AV,
  // catering, furniture, decor) are coordinated by FES but budgeted
  // separately does not fit this row's length budget and is dropped here.
  // TODO(marcelo): that's a commercial disclaimer — confirm where it should
  // live instead (proposal, or a footnote under this section).
  {
    number: '— 03',
    title: 'Production & Planning',
    description:
      'We manage the full build — venue, technical visits, suppliers, audiovisual, catering and signage — into one operational plan.',
  },
  {
