]

// No explicit "O que entregamos" list in this doc (unlike Branding/
// Podcast) — phrases here are drawn from "Como implementamos" instead.
const builtForPhrases = [
  'Strategy & objectives',
  'Experience design',
  'Venue & supplier coordination',
  'Audiovisual & technology',
  'On-site coordination',
  'Impact report',
]

const addons = [
