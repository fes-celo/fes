    description: "Identifying, selecting and inviting speakers and guests aligned with the event's objectives and the organisation's positioning.",
  },
]

// Client-supplied list of real events, grouped by category. Image-and-title
// only (no description/case study exists per project) and not linked — see
// findSelectedProjectImage above for how the thumbnail is resolved. A
// project with no matching dropped file yet renders PlaceholderBlock
// instead of a photo (see the render loop below) rather than being hidden.
const eventCategories = [
  {
    label: 'Conferences & Congresses',
    projects: [
      { title: 'C-DAYS', file: 'C-DAYS' },
      {
        title: '18th Council of Europe — Conference of Ministers Responsible for Sport',
        file: '18th Council of Europe - Conference of Ministers Responsible for Sport',
      },
      { title: 'Data Makers Fest', file: 'Data Makers Fest' },
      { title: 'NDC Conferences', file: 'NDC' },
      { title: 'KCD', file: 'KCD' },
    ],
  },
  {
    label: 'Corporate Events',
    projects: [{ title: 'ERS Conference — 20th Anniversary Celebration', file: 'ERS Conference' }],
  },
  {
    label: 'Dinners, Galas & Celebrations',
    projects: [
      { title: 'PWIT Awards', file: 'PWIT Awards' },
      { title: 'Dashlane — Office Inauguration', file: 'Dashlane' },
      { title: 'New Work — Office Inauguration', file: 'New Work' },
    ],
  },
  {
    label: 'Innovation & Technology',
    projects: [
      { title: 'BIT Hackathon by MC', file: 'BIT Hackathon by MC' },
      { title: 'Sogrape Impact Hack', file: 'Sogrape Impact Hack' },
      { title: 'Hack For Good Gulbenkian', file: 'Hack For Good Gulbenkian' },
      { title: 'ICPC Porto World Finals', file: 'ICPC Porto World Finals' },
      { title: 'NEXO Summit', file: 'NEXO Summit' },
      { title: 'IFM — Infraspeak', file: 'IFM' },
      { title: 'Porto Tech — Câmara Municipal do Porto', file: 'Porto Tech' },
      { title: 'Start & Scale Week — Câmara Municipal do Porto', file: 'Start & Scale Week' },
    ],
  },
  {
    label: 'Brand Activations',
    projects: [
      { title: 'TEDx — Blip', file: 'Blip_TedX' },
      { title: 'Web Summit Activation — Dashlane', file: 'Dashlane_Websummit' },
      { title: 'Web Summit Activation — ScaleUp Porto', file: 'ScaleUp Porto' },
      { title: 'Scale Up Porto', file: 'Scaleup' },
      { title: 'Web Summit 2025 — Community Event', file: 'Natixis Moves You' },
    ],
  },
]

// Reshaped for SelectedProjectsRotator, which takes an `images` array per
// project (0 renders its placeholder, 1 a static frame) rather than this
// page's own file-lookup shape.
const selectedProjectCategories = await Promise.all(
  eventCategories.map(async (category) => ({
    label: category.label,
    projects: await Promise.all(
      category.projects.map(async (project) => {
        const image = await findSelectedProjectImage(project.file)
        return { title: project.title, images: image ? [image] : [] }
      }),
    ),
  })),
)
---

<BaseLayout
  title="Events & Brand Activations"
  ogImage={heroBg}
  description="Create experiences that move people, and business. A Blueprint that aligns strategy, experience design and production to generate real impact around the right audience."
  hideHeader
>
  {/* ---------- 1. Hero ---------- */}
  <section
    class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-white px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-16 lg:pb-[var(--space-gutter)] supports-[height:100dvh]:min-h-dvh"
  >
    <Image
      src={heroBg}
      alt=""
      width={2560}
      height={1440}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <nav aria-label="Primary" class="relative z-10">
      <div class="flex items-start justify-between gap-6">
        <a href="/" class="shrink-0">
          <Logo class="h-[var(--nav-logo-h)] w-auto" />
        </a>
        <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(Astro.url.pathname, item.href) ? 'page' : undefined}
                  class:list={[
                    'text-body',
                    isNavActive(Astro.url.pathname, item.href) ? 'text-ink' : 'text-ink-secondary hover:text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg transition-transform active:scale-[0.97] lg:hidden"
          data-nav-toggle
        >
          Menu
        </button>
      </div>
    </nav>

    <div class="hero-copy relative z-10 mt-16 grid gap-x-4 gap-y-6 lg:flex-1 lg:gap-x-16 lg:gap-y-9">
      <Heading as="h1" indent={false} class="hero-copy__title text-display text-balance text-ink" data-anim="split-text">
        Create experiences that bring people closer and generate value
      </Heading>
      <p class="hero-copy__desc max-w-[48ch] text-lead text-ink" data-anim="reveal">
        When organisations invest in events without clearly defining what they want to achieve, the results can fall
        short.
      </p>
      <p class="hero-copy__name text-body-sm text-ink lg:text-body" data-anim="reveal">Creative Projects Blueprint · Events & Brand Activations</p>
      <p class="hero-copy__duration text-right text-body-sm text-ink lg:text-body" data-anim="reveal">Duration: 3 months (minimum)</p>
    </div>
  </section>

  <style>
    /* Mobile: title, then description, then a two-column name/duration row.
       Desktop keeps the original layout — description floating mid-hero,
       title pinned to the bottom with the name/duration row beneath it —
       via two flexible spacer rows standing in for the old justify-between. */
    .hero-copy {
      justify-content: space-between;
      grid-template-areas:
        'title title'
        'desc desc'
        'name duration';
    }
    .hero-copy__title {
      grid-area: title;
    }
    .hero-copy__desc {
      grid-area: desc;
    }
    .hero-copy__name {
      grid-area: name;
    }
    .hero-copy__duration {
      grid-area: duration;
    }

    @media (min-width: 1024px) {
      .hero-copy {
        grid-template-rows: 1fr auto 1fr auto auto;
        grid-template-areas:
          '. .'
          'desc desc'
          '. .'
          'title .'
          'name duration';
      }
    }
  </style>

  {/* ---------- 2. Expertise ---------- */}
  <SystemExpertiseRotator words={expertiseWords} />

  {/* ---------- 3. Introduction ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-7">
      <Heading as="p" indent={false} class="text-h2 text-ink lg:w-1/2">
        Design and run events and activations with a clear purpose, aligned with each organisation's goals and
        built to create impact with the right audience.
      </Heading>
      <div class="flex flex-col gap-6 text-lead text-ink lg:w-1/2">
        <p>
          That's why we create experiences with a clear purpose — aligned with each organisation's objectives and
          designed to generate real impact.
        </p>
        <p>
          Whether to strengthen brand positioning, increase visibility, create business opportunities, attract
          talent, or strengthen a community's ties, every project is built to achieve concrete results.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- 3b. Sound familiar ---------- */}
  <SystemProblemCards cards={problemCards} class="bg-surface" />

  {/* ---------- 4. Our approach ---------- */}
  <PhasesScroll steps={approachSteps} class="bg-surface" />

  {
    /* Same chip as the homepage: shows once "Our approach" scrolls into
       view, hides once "Selected projects" (further down) does. */
  }
  <ScrollCta showSelector="[data-phases-scroll]" hideSelector="[data-selected-projects-section]" />

  {/* ---------- 5. Built for ---------- */}
  <BuiltForRotator phrases={builtForPhrases} backgroundImage={builtForBg} />

  {/* ---------- 6. Addons ---------- */}
  <SystemAddonsMarquee
    addons={addons}
    class="bg-surface pt-[var(--space-section-y)] pb-[var(--space-section-y)]"
  />

  {/* ---------- 7. Impact ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <SectionIntro eyebrow="Impact" eyebrowSize="text-body">
      An event isn't a moment in isolation
      <div slot="aside" class="flex flex-col gap-6 text-balance text-lead text-ink">
        <p>It's an accelerator for relationships, reputation and growth.</p>
        <p>
          By the end of this Blueprint, the organisation has built an experience that generates impact before,
          during and after the event — turning every interaction into an opportunity to strengthen the brand,
          bring people closer and create value for the business.
        </p>
      </div>
    </SectionIntro>
  </section>

  {/* ---------- 8. Selected projects ---------- */}
  <SelectedProjectsRotator categories={selectedProjectCategories} fixedAspect="886 / 580" />

  {/* ---------- 9. Contact ---------- */}
  <DualCta
    leftHeading="Have an event in mind?"
    leftHref="/contact/"
    leftLabel="Get in touch"
    rightHeading="Want to see more of our work?"
    rightHref="https://drive.google.com/file/d/17LpSFfD04wwv1nHCLklP3WyVXEQsDeB6/view"
    rightLabel="See our detailed portfolio"
    rightVariant="outline"
  />
</BaseLayout>
