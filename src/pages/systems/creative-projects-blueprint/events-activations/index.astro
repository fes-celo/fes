      { title: 'Hack For Good Gulbenkian', file: 'Hack For Good Gulbenkian Large' },
      { title: 'ICPC Porto World Finals', file: 'ICPC Porto World Finals' },
      { title: 'Demium Startups Lisbon', file: 'Demium Startups Lisbon' },
      { title: 'NEXO Summit', file: 'NEXO Summit' },
    ],
  },
  {
    label: 'Launches & Brand Activations',
    projects: [
      { title: 'TEDx — Blip', file: 'TedX - Blip' },
      { title: 'Web Summit Activation — Dashlane', file: 'Ativação Web Summit - Dashlane' },
      { title: 'Web Summit Activation — ScaleUp Porto', file: 'Ativação Web Summit - ScaleUp Porto' },
      { title: 'We Want You — Natixis', file: 'We Want You Ativação- Natixis- Large' },
