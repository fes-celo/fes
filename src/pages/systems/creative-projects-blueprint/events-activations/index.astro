import SystemExpertiseRotator from '../../../../components/SystemExpertiseRotator.astro'
import SystemProblemCards from '../../../../components/SystemProblemCards.astro'
import PhasesScroll from '../../../../components/PhasesScroll.astro'
import ScrollCta from '../../../../components/ScrollCta.astro'
import BuiltForRotator from '../../../../components/BuiltForRotator.astro'
import SystemAddonsMarquee from '../../../../components/SystemAddonsMarquee.astro'
import DualCta from '../../../../components/DualCta.astro'
import SelectedProjectsRotator from '../../../../components/SelectedProjectsRotator.astro'

import heroBg from '../../../../assets/systems/creative-projects-blueprint/events-activations/hero-bg.jpg'
import builtForBg from '../../../../assets/systems/built-for-bg.webp'
import Logo from '../../../../components/Logo.astro'

// Selected projects thumbnails — dropped flat (no subfolders) into
// src/assets/systems/creative-projects-blueprint/events-activations/selected-projects/,
// keeping their original client-supplied filenames. Matched below by a
// whitespace-normalised filename per project (see `eventCategories`), so
// adding/renaming an image never needs a matching import line here.
// Projects with no matching file yet render PlaceholderBlock's flat colour
// tile instead of being dropped from the section — several of the events
// below don't have photography selected yet.
type ImageModule = { default: ImageMetadata }
// NOT eager. An eager glob imports every file in the folder whether or not a
// project below names it, and Vite then emits each unmatched original into
// dist/ as-is — four unused PNGs, one of them 2MB, were shipping that way.
// A lazy glob only imports what `findSelectedProjectImage` actually awaits,
// so a file dropped into the folder ahead of its project costs nothing until
// the project exists.
const selectedProjectImages = import.meta.glob<ImageModule>(
  '../../../../assets/systems/creative-projects-blueprint/events-activations/selected-projects/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
)

// Collapses repeated whitespace, trims, and normalises to NFC — several of
// the dropped files have stray double spaces / trailing spaces before the
// extension (e.g. "C-DAYS .jpg", "European Innovation Academy  Large.jpeg"),
// and macOS decomposes accented filenames to NFD on disk (e.g. "Ativação"),
// which otherwise fails a strict === against the NFC string literals below.
const normalizeFilename = (name: string) => name.normalize('NFC').replace(/\s+/g, ' ').trim()

async function findSelectedProjectImage(file: string) {
  const target = normalizeFilename(file)
  const match = Object.entries(selectedProjectImages).find(([path]) => {
    const base = path.split('/').pop() ?? ''
    return normalizeFilename(base.replace(/\.[^.]+$/, '')) === target
  })
  return match ? (await match[1]()).default : undefined
}

const expertiseWords = ['Experience', 'Engagement', 'Relationships', 'Opportunity']

const problemCards = [
