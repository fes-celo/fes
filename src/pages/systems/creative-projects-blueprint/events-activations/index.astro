// Client-supplied list of real events, grouped by category. Image-and-title
// only (no description/case study exists per project) and not linked — see
// findSelectedProjectImage above for how the thumbnail is resolved. Some
// projects (the CoE conference, We Want You — Natixis) appear under two
// categories on purpose, per the client's own list.
const eventCategories = [
  {
    label: 'Conferences & Congresses',
    projects: [
      { title: 'European Innovation Academy', file: 'European Innovation Academy Large' },
      { title: 'C-DAYS', file: 'C-DAYS' },
      {
        title: '18th Council of Europe — Conference of Ministers Responsible for Sport',
        file: '18th Council of Europe - Conference of Ministers Responsible for Sport Large',
