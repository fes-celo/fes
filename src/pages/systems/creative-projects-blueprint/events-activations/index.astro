---

<BaseLayout
  title="Events & Brand Activations — Creative Projects Blueprint"
  description="Create experiences that move people, and business. A Blueprint that aligns strategy, experience design and production to generate real impact around the right audience."
  hideHeader
>
  {/* ---------- 1. Hero ---------- */}
  <section
    class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-white px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-[var(--space-section-y)] supports-[height:100dvh]:min-h-dvh"
  >
    <Image
      src={heroBg}
      alt=""
      width={2560}
      height={1440}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="pointer-events-none absolute inset-0 size-full object-cover"
    />

    <nav aria-label="Primary" class="relative z-10">
      <div class="flex items-center justify-between gap-6">
        <a href="/" class="shrink-0">
          <img src="/fes-logo-dark.svg" alt="FES Agency" width="106" height="60" class="h-[var(--nav-logo-h)] w-auto" />
        </a>
        <ul class="hidden items-center lg:flex lg:gap-[var(--space-gutter)]">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-body text-ink-secondary hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/30 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg lg:hidden"
          data-nav-toggle
        >
          Menu
        </button>
      </div>
    </nav>

    <p class="relative z-10 mt-16 max-w-[48ch] text-lead text-ink" data-anim="reveal">
      When organisations invest in events without clearly defining what they want to achieve, the results can fall
      short.
    </p>

    <div class="relative z-10 flex flex-col gap-9 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div class="flex flex-col gap-9">
        <Heading as="h1" indent={false} class="max-w-[20ch] text-display text-ink lg:max-w-[50vw]" data-anim="split-text">
          Create experiences that bring people closer and generate value
        </Heading>
        <p class="text-body text-ink" data-anim="reveal">Creative Projects Blueprint · Events & Brand Activations</p>
      </div>
      <p class="shrink-0 text-body text-ink lg:text-right" data-anim="reveal">Duration: 3 months (minimum)</p>
    </div>
  </section>

  {/* ---------- 2. Expertise ---------- */}
  <SystemExpertiseRotator words={expertiseWords} />

  {/* ---------- 3. Introduction ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-7">
      <Heading as="p" class="text-h2 text-ink lg:w-1/2">
        Design and run events and activations with a clear purpose, aligned with each organisation's goals and
        built to create impact with the right audience.
      </Heading>
      <div class="flex flex-col gap-6 text-lead text-ink lg:w-1/2">
        <p>
          That's why we create experiences with a clear purpose — aligned with each organisation's objectives and
          designed to generate real impact.
        </p>
        <p>
          Whether to strengthen brand positioning, increase visibility, create business opportunities, attract
          talent, or strengthen a community's ties, every project is built to achieve concrete results.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- 3b. Sound familiar ---------- */}
  <SystemProblemCards cards={problemCards} class="bg-surface" />

  {/* ---------- 4. Our approach ---------- */}
  <PhasesScroll steps={approachSteps} class="bg-surface" />

  {
    /* Same chip as the homepage: shows once "Our approach" scrolls into
       view, hides once "Selected projects" (further down) does. */
  }
  <ScrollCta showSelector="[data-phases-scroll]" hideSelector="[data-selected-projects-section]" />

  {/* ---------- 5. Built for ---------- */}
  <BuiltForRotator phrases={builtForPhrases} backgroundImage={builtForBg} />

  {/* ---------- 6. Addons ---------- */}
  <SystemAddonsMarquee addons={addons} class="bg-surface pb-[var(--space-section-y)]" />

  {/* ---------- 7. Impact ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
    <SectionIntro eyebrow="Impact" eyebrowSize="text-body">
      An event isn't a moment in isolation
      <div slot="aside" class="flex flex-col gap-6 text-balance text-lead text-ink">
        <p>It's an accelerator for relationships, reputation and growth.</p>
        <p>
          By the end of this Blueprint, the organisation has built an experience that generates impact before,
          during and after the event — turning every interaction into an opportunity to strengthen the brand,
          bring people closer and create value for the business.
        </p>
      </div>
    </SectionIntro>
  </section>

  {/* ---------- 8. Selected projects ---------- */}
  <section class="w-full bg-surface px-[var(--space-gutter)] pb-[var(--space-section-y)]" data-selected-projects-section>
    <div class="flex flex-col gap-14" data-projects-row>
      <Heading as="h2" indent={false} class="text-lead text-ink">
        Selected projects
      </Heading>
      {
        eventCategories.map((category) => {
          // Only projects with a matching dropped file render — a project
          // with no photo yet is left out of the section entirely rather
          // than showing as an empty placeholder.
          const projectsWithImages = category.projects
            .map((project) => ({ ...project, image: findSelectedProjectImage(project.file) }))
            .filter((project) => project.image)
          if (projectsWithImages.length === 0) return null

          return (
            <div class="flex flex-col gap-6">
              <p class="text-body-sm font-medium uppercase tracking-wide text-ink-secondary">{category.label}</p>
              <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
                {projectsWithImages.map((project) => (
                  <li class="flex flex-col gap-4" data-project-card>
                    <div class="relative aspect-[430/294] overflow-hidden rounded-[var(--radius-card)] bg-accent-tint">
                      <Image
                        src={project.image!}
                        alt=""
                        width={860}
                        height={588}
                        widths={[430, 645, 860]}
                        sizes="(min-width: 1024px) 22vw, 45vw"
                        class="size-full object-cover"
                      />
                    </div>
                    <p class="text-body-sm font-medium text-ink">{project.title}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        })
      }
    </div>
  </section>

  {/* ---------- 9. Contact ---------- */}
  <DualCta
    leftHeading="Have an event in mind?"
    leftHref="/contact/"
    leftLabel="Get in touch"
    rightHeading="Want to see more of our work?"
    rightHref="/fes-agency-portfolio.pdf"
    rightLabel="See our portfolio"
    rightImage={ourWorkCta}
  />
</BaseLayout>

<script>
  // Staggered reveal for the projects row.
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../../../../lib/sectionMotion'

  bindSection('[data-projects-row]', ({ root, mm }) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'))
    if (cards.length === 0) return

    mm.add(MOTION_FULL, () => {
      const tween = gsap.from(cards, {
        opacity: 0,
        y: 24,
        duration: 0.8,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: { trigger: root, start: 'top 85%', once: true },
      })
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      const tween = gsap.from(cards, {
        opacity: 0,
        duration: 0.4,
        scrollTrigger: { trigger: root, start: 'top 90%', once: true },
      })
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>
