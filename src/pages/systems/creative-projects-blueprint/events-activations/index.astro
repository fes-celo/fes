    description:
      "The event ends; the impact doesn't. We analyse results, gather feedback, and turn the learnings into recommendations.",
  },
]

// No explicit "O que entregamos" list in this doc (unlike Branding/
// Podcast) — phrases here are drawn from "Como implementamos" instead.
const builtForPhrases = [
  'Strategy & objectives',
  'Experience design',
  'Venue & supplier coordination',
  'Audiovisual & technology',
  'On-site coordination',
  'Impact report',
]

const addons = [
  {
    title: 'Event Branding',
    description: 'Naming, visual identity, graphic system and exclusive materials for the event.',
  },
  {
    title: 'Design Application',
    description:
      'Applying an existing visual identity across all event materials — merchandising, signage, decor, presentations, credentials and other graphic elements.',
  },
  {
    title: 'Communication Plan',
    description:
      "Developing the event's communication plan and its materials, including invitations, email marketing, social media content, internal and external communications, presentations and other supporting materials.",
  },
  {
