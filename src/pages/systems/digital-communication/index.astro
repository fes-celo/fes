---
/**
 * Systems → Digital Communication System.
 *
 * Built on the same template as Influence & Reputation
 * (../influence-reputation/index.astro) — same `.dark-zone`/`.reveal-zone`
 * color strategy, same SystemAddonsCarousel (adds autoplay) instead of the
 * plain marquee, same Selected Projects prev/next arrows and dark→light
 * reveal. See that file's header comment for the mechanics; not repeated
 * here.
 *
 * "Our approach" renders PhasesScroll (the pinned phase list,
 * src/components/PhasesScroll.astro), which every Systems page now uses —
 * the older horizontal-carousel stepper was retired so each page has exactly
 * one approach section. It consumes the `{ number, title, description }[]`
 * shape from src/lib/phases.ts, which is what `approachSteps` below builds.
 *
 * COPY: adapted from the "Digital Communication System" source doc, using
 * the same content-to-slot mapping worked out on Influence & Reputation —
 * see conversation history / docs/parked-decisions.md if that mapping needs
 * revisiting. Two sections from the source doc have no slot on this
 * template yet and are intentionally NOT rendered: "How we measure
 * success" (parked) and a category breakdown on Selected Projects (this
 * template's grid has no sub-heading slot, same as Influence & Reputation's).
 *
 * PHOTOGRAPHY: none shot yet for this System. Hero ships without its
 * background photo (dark surface + the same gradient scrim, so the section
 * still reads with depth), the five problem cards ship without images
 * (SystemProblemCards' `image` is now optional — see that component's
 * placeholder branch, added here rather than duplicated), and Built For
 * ships without `backgroundImage` (already optional; falls back to its own
 * documented accent-950 fallback). Selected Projects reuses whichever real
 * project thumbnails already exist (We Want You, Blip, Startup Portugal);
 * the rest render ProjectCard's own no-image tint, same as Influence &
 * Reputation's Anchorage Digital / Bridge In entries.
 * TODO(marcelo): swap in real photography for hero, problem cards and
 * Built For once shot; confirm which 8 Selected Projects should ship (the
 * source doc lists 8 across 3 categories vs. this template's usual 4).
 */
import { Image } from 'astro:assets'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { navItems, isNavActive } from '../../../lib/nav'
import Heading from '../../../components/Heading.astro'
import SectionIntro from '../../../components/SectionIntro.astro'
import SelectedProjectsRotator from '../../../components/SelectedProjectsRotator.astro'
import SystemExpertiseRotator from '../../../components/SystemExpertiseRotator.astro'
import SystemProblemCards from '../../../components/SystemProblemCards.astro'
import PhasesScroll from '../../../components/PhasesScroll.astro'
import ScrollCta from '../../../components/ScrollCta.astro'
import BuiltForRotator from '../../../components/BuiltForRotator.astro'
import SystemAddonsCarousel from '../../../components/SystemAddonsCarousel.astro'
import DualCta from '../../../components/DualCta.astro'

import ourWorkCta from '../../../assets/systems/our-work-cta.jpg'
import heroBg from '../../../assets/systems/digital-communication/hero-bg.jpg'
import builtForBg from '../../../assets/systems/built-for-bg.webp'
import weWantYouThumb from '../../../assets/projects/we-want-you.png'
