    description: 'Organic search strategy to increase visibility and capture qualified demand.',
  },
  {
    title: 'Marketing Automation',
    description: 'Automation of lead nurturing processes, email marketing and conversion flows.',
  },
  {
    title: 'Analytics Dashboard',
    description: 'A custom dashboard for real-time tracking of key indicators.',
  },
]

// Page-local, same reasoning as Influence & Reputation's own list: the
// source doc's 8 projects span 3 categories with no shared taxonomy entry
// for most of them. Only three (We Want You, Blip, Startup Portugal) have a
// real thumbnail today; the rest render SelectedProjectsRotator's own
// placeholder tint. `href` is kept as a record of the intended destination
// but isn't passed to the rotator below — none of these have a dedicated
// case-study page live yet, so the panel isn't a link.
const selectedProjects = [
  {
