---

<BaseLayout
  title="Digital Communication System"
  ogImage={heroBg}
  description="Turn communication into measurable growth. A six-month system that aligns strategy, content, channels and continuous optimisation to generate demand, leads and opportunities."
  hideHeader
>
  <div class="dark-zone">
    {/* ---------- 1. Hero ---------- */}
    <section
      class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-surface px-[var(--space-gutter)] pt-[var(--space-gutter)] pb-16 lg:pb-[var(--space-gutter)] supports-[height:100dvh]:min-h-dvh"
    >
      <Image
        src={heroBg}
        alt=""
        width={2560}
        height={1440}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 size-full object-cover"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[rgba(15,15,15,0)] from-[37%] to-[#0f0f0f] to-[92%]"
      >
      </div>

      <nav aria-label="Primary" class="relative z-10">
        <div class="flex items-start justify-between gap-6">
          <a href="/" class="shrink-0">
            <Logo variant="light" class="h-[var(--nav-logo-h)] w-auto" />
          </a>
          <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isNavActive(Astro.url.pathname, item.href) ? 'page' : undefined}
                    class:list={[
                      'text-body',
                      isNavActive(Astro.url.pathname, item.href) ? 'text-ink' : 'text-ink-secondary hover:text-ink',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg transition-transform active:scale-[0.97] lg:hidden"
            data-nav-toggle
          >
            Menu
          </button>
        </div>
      </nav>

      <div class="hero-copy relative z-10 mt-16 grid gap-x-4 gap-y-6 lg:flex-1 lg:gap-x-16 lg:gap-y-9">
        <Heading as="h1" indent={false} class="hero-copy__title text-display text-balance text-ink" data-anim="split-text">
          Turn communication into measurable growth
        </Heading>
        <p class="hero-copy__desc max-w-[48ch] text-lead text-ink" data-anim="reveal">
          Posting doesn't create growth. Neither does communicating more.
        </p>
        <p class="hero-copy__name text-body-sm text-ink lg:text-body" data-anim="reveal">Digital Communication System</p>
        <p class="hero-copy__duration text-right text-body-sm text-ink lg:text-body" data-anim="reveal">Duration: 6 months (minimum)</p>
      </div>
    </section>

    <style>
      /* Mobile: title, then description, then a two-column name/duration row.
         Desktop keeps the original layout — description floating mid-hero,
         title pinned to the bottom with the name/duration row beneath it —
         via two flexible spacer rows standing in for the old justify-between. */
      .hero-copy {
        justify-content: space-between;
        grid-template-areas:
          'title title'
          'desc desc'
          'name duration';
      }
      .hero-copy__title {
        grid-area: title;
      }
      .hero-copy__desc {
        grid-area: desc;
      }
      .hero-copy__name {
        grid-area: name;
      }
      .hero-copy__duration {
        grid-area: duration;
      }

      @media (min-width: 1024px) {
        .hero-copy {
          grid-template-rows: 1fr auto 1fr auto auto;
          grid-template-areas:
            '. .'
            'desc desc'
            '. .'
            'title .'
            'name duration';
        }
      }
    </style>

    {/* ---------- 2. Expertise ---------- */}
    <SystemExpertiseRotator words={expertiseWords} />

    {/* ---------- 3. Introduction ---------- */}
    <section class="w-full bg-surface px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
      <div class="flex flex-col gap-10 lg:flex-row lg:gap-7">
        <Heading as="p" indent={false} class="text-h2 text-ink lg:w-1/2">
          A communication engine that connects content, channels and continuous optimisation to the organisation's
          growth goals.
        </Heading>
        <div class="flex flex-col gap-6 text-lead text-ink lg:w-1/2">
