// git history): adding them there would put untagged projects into the
// /projects/ filter. SelectedProjectsRotator's own no-image state renders
// the tinted placeholder until real thumbnails and case-study pages exist.
// TODO(marcelo): real thumbnails + case-study pages for Anchorage Digital,
// Bridge In, New Work and the AI & History study.
// `href` is kept as a record of the intended destination but isn't passed to
// the rotator below — none of these have a dedicated case-study page live
// yet, so the panel isn't a link.
const selectedProjects = [
  {
