<style>
  /* Static dark palette for Hero → Addons — see the file-level comment for
     why one scoped rule is enough to re-theme every shared component
     nested inside it. Values mirror the homepage invert-zone's dark
     endpoint (src/pages/index.astro) so both pages agree on what "dark"
     means. Impact and Selected Projects are NOT in here — see
     `.reveal-zone` below. */
  .dark-zone {
    --color-surface: var(--color-neutral-950);
    --color-ink: var(--color-white);
    --color-ink-secondary: var(--color-neutral-300);
    --color-ink-muted: var(--color-neutral-400);
    --color-line: var(--color-neutral-800);
    --color-accent-tint: var(--color-neutral-900);
    /* SystemExpertiseRotator's rest/fill pair — same "barely there at rest,
       fully arrived once filled" logic as the light default, mirrored for a
       near-black surface. accent-700 (the light default's fill — see
       global.css) is a light-surface color: ~9:1 against white, but only
       ~2:1 against this near-black, well under WCAG minimums — so this
       branch keeps a neutral instead of following that value down. */
    --rotator-rest: var(--color-neutral-800);
    --rotator-fill: var(--color-neutral-100);
    background-color: var(--color-surface);
  }

  .projects-strip {
    scrollbar-width: none;
  }
  .projects-strip::-webkit-scrollbar {
    display: none;
  }

  .reveal-arrow {
    mask-image: url('/icons/icon-arrow-white.svg');
    -webkit-mask-image: url('/icons/icon-arrow-white.svg');
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
    mask-size: contain;
    -webkit-mask-size: contain;
  }

  /* Dark → light reveal, driven by --light-progress (0 or 1, set by the
     script below via ScrollTrigger). Both endpoints of every color-mix are
     fully opaque, high-contrast palettes — the 0 default is a safe, fully
     readable resting state with no JS (matches Addons directly above,
     inside .dark-zone), not a transitional half-state. Wraps Impact AND
     Selected Projects together — one shared background-color, so the two
     sections can never be caught mid-scroll with one dark and one light. */
  .reveal-zone {
    --light-progress: 0;

    --color-surface: color-mix(in srgb, var(--color-white) calc(var(--light-progress) * 100%), var(--color-neutral-950));
    --color-ink: color-mix(in srgb, var(--color-neutral-950) calc(var(--light-progress) * 100%), var(--color-white));
    --color-ink-secondary: color-mix(in srgb, var(--color-neutral-700) calc(var(--light-progress) * 100%), var(--color-neutral-300));
    --color-ink-muted: color-mix(in srgb, var(--color-neutral-500) calc(var(--light-progress) * 100%), var(--color-neutral-400));
    --color-line: color-mix(in srgb, var(--color-neutral-200) calc(var(--light-progress) * 100%), var(--color-neutral-800));
    /* Anchorage Digital / Bridge In's no-thumbnail placeholder tint. */
    --color-accent-tint: color-mix(in srgb, var(--color-accent-50) calc(var(--light-progress) * 100%), var(--color-neutral-900));

    background-color: var(--color-surface);
    transition: background-color 200ms ease-out;
  }
  /* :global() — ProjectCard's title/description/placeholder-tint live in a
     component with its own scope hash, same reasoning as the homepage
     invert-zone's identical rule. */
  .reveal-zone :global(*) {
    transition:
      color 200ms ease-out,
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal-zone,
    .reveal-zone :global(*) {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  // Staggered reveal for the projects row.
  import { bindSection, gsap, MOTION_FULL, MOTION_FALLBACK } from '../../../lib/sectionMotion'

  bindSection('[data-projects-row]', ({ root, mm }) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'))
    if (cards.length === 0) return

    // fromTo, never from, for the opacity half of this reveal. A `from` tween
    // derives its END value by clearing the inline style and reading the
    // card's computed opacity straight back out of the DOM — and
    // ScrollTrigger.refresh() re-runs that revert-and-measure pass. If
    // anything in CSS transitions opacity on these cards, that read returns
    // the mid-transition value (i.e. the 0 the tween itself just wrote), the
    // reveal records 0 as its target, and the row animates 0 → 0: laid out,
    // moving, permanently invisible. That exact bug shipped once already —
    // see the [data-project-card] note in src/styles/global.css. Stating both
    // endpoints keeps the reveal correct no matter what CSS lands on them.
    mm.add(MOTION_FULL, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: { trigger: root, start: 'top 85%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })

    mm.add(MOTION_FALLBACK, () => {
      const tween = gsap.fromTo(
        cards,
        { opacity: 0 },
        {
          opacity: 1,
          duration: 0.4,
          scrollTrigger: { trigger: root, start: 'top 90%', once: true },
        },
      )
      return () => {
        tween.scrollTrigger?.kill()
        tween.kill()
        gsap.set(cards, { clearProps: 'opacity,transform' })
      }
    })
  })
</script>

<script>
  // Selected Projects arrows — scroll the mobile/tablet strip by one card
  // (matches homepage's testimonial prev/next: src/pages/index.astro).
  // Hidden at lg via the button wrapper's own `lg:hidden`, since the grid
  // there doesn't overflow.
  let cardStepCleanup: (() => void) | null = null

  function setupProjectsNav() {
    const strip = document.querySelector<HTMLElement>('[data-projects-row]')
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-projects-prev]')
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-projects-next]')
    if (!strip || !prevBtn || !nextBtn) return

    function cardStep() {
      const first = strip!.firstElementChild as HTMLElement | null
      const gap = parseFloat(getComputedStyle(strip!).columnGap || '0')
      return first ? first.getBoundingClientRect().width + gap : strip!.clientWidth
    }

    const onPrev = () => strip!.scrollBy({ left: -cardStep(), behavior: 'smooth' })
    const onNext = () => strip!.scrollBy({ left: cardStep(), behavior: 'smooth' })
    prevBtn.addEventListener('click', onPrev)
    nextBtn.addEventListener('click', onNext)

    cardStepCleanup = () => {
      prevBtn.removeEventListener('click', onPrev)
      nextBtn.removeEventListener('click', onNext)
    }
  }

  function teardownProjectsNav() {
    cardStepCleanup?.()
    cardStepCleanup = null
  }

  document.addEventListener('astro:page-load', setupProjectsNav)
  document.addEventListener('astro:before-swap', teardownProjectsNav)
</script>

<script>
  // Dark → light reveal on Impact + Selected Projects. Not gated through
  // sectionMotion's MOTION_FULL/MOTION_FALLBACK matchMedia pair — like the
  // homepage's identical inversion, this is a plain color toggle, not a
  // travel effect, so it runs the same way at every viewport width and
  // only reduced motion (handled in CSS above) shortens the transition.
  //
  // `start: 'top top'` — matches the homepage's own trigger point exactly
  // (src/pages/index.astro's setupDarkInversion): while Impact is still
  // arriving from below (any part of it below the viewport's top edge,
  // even if the whole section is already visible), the zone stays dark.
  // The flip fires the instant the zone's (=Impact's) own top edge
  // reaches the top of the screen — not sooner, not "the middle."
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  let revealTrigger: ScrollTrigger | null = null

  function setupReveal() {
    const zone = document.querySelector<HTMLElement>('[data-reveal-zone]')
    if (!zone) return

    const setLight = (on: boolean) => zone.style.setProperty('--light-progress', on ? '1' : '0')

    revealTrigger = ScrollTrigger.create({
      trigger: zone,
      start: 'top top',
      onEnter: () => setLight(true),
      onLeaveBack: () => setLight(false),
      // A reload (or resize) partway down the page doesn't replay onEnter —
      // seed from wherever scroll actually is, same as the homepage.
      onRefresh: (self) => setLight(self.progress > 0),
    })
  }

  function teardownReveal() {
    revealTrigger?.kill()
    revealTrigger = null
  }

  document.addEventListener('astro:page-load', setupReveal)
  document.addEventListener('astro:before-swap', teardownReveal)
</script>
