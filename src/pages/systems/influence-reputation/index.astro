  {
    /* ---------- 7. Impact + 8. Selected projects — merged into ONE
       `.reveal-zone`, per feedback: the dark→light flip needs to be a
       single continuous background covering BOTH sections (never a part-
       dark/part-light split visible at once), and it has to fire when
       IMPACT's own top edge reaches the top of the viewport — while Impact
       is still arriving on screen it stays dark, matching everything
       above it inside .dark-zone; only once scrolled past does the whole
       zone (Impact's tail + Selected Projects) repaint light together.
       Same `--light-progress` mechanism as the homepage's invert-zone,
       just the other direction and with `start: 'top top'` instead of
       'top center' — see the <style>/<script> blocks below. ---------- */
  }
  <div class="reveal-zone" data-reveal-zone>
    <section class="w-full px-[var(--space-gutter)] py-[var(--space-section-y)]" data-anim="reveal">
      <SectionIntro eyebrow="Impact" eyebrowSize="text-body">
