---
/**
 * Plain text legal page — white canvas, no header/footer dividers (see
 * BaseLayout's `bordered` prop). Nav is the same hideHeader + inline <nav>
 * pattern as the Projects page (same padding/margins), not BaseLayout's
 * default bordered header.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { navItems, isNavActive } from '../../lib/nav'
import Logo from '../../components/Logo.astro'
---

<BaseLayout
  title="Privacy Policy"
  description="How FES Agency collects, uses and protects personal data of users of this website."
  hideHeader
>
  <nav aria-label="Primary" class="relative z-10 bg-surface px-[var(--space-gutter)] pt-[var(--space-gutter)]">
    <div class="flex items-start justify-between gap-6">
      <a href="/" class="shrink-0">
        <Logo class="h-[var(--nav-logo-h)] w-auto" />
      </a>
      <ul class="hidden items-center lg:flex lg:gap-[var(--space-nav-gap)]">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isNavActive(Astro.url.pathname, item.href) ? 'page' : undefined}
                class:list={[
                  'text-body',
                  isNavActive(Astro.url.pathname, item.href) ? 'text-ink' : 'text-ink-secondary hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex shrink-0 items-center rounded-[var(--radius-button)] bg-neutral-950/60 px-3.5 py-3 text-[1.0625rem] font-medium text-white backdrop-blur-lg transition-transform active:scale-[0.97] lg:hidden"
        data-nav-toggle
      >
        Menu
      </button>
    </div>
  </nav>

  <section class="bg-surface px-[var(--space-gutter)] pt-10 pb-[var(--space-section-y)]">
    <div class="mx-auto flex max-w-[47.5rem] flex-col gap-10">
      <h1 class="text-h1 text-ink">Privacy Policy</h1>

      {/* Every statement below describes something the site actually does
          (worker/index.ts, contact/index.astro, the embeds, the footer
          links). Change the code, change this page — see
          parked-decisions §55. */}
      <div class="flex flex-col gap-10 text-body text-ink-secondary [&_a]:text-ink [&_a]:underline [&_a:hover]:text-ink-secondary">
        <div class="flex flex-col gap-4">
          <p>
            This Privacy Policy explains how personal data is processed when you use the website
            https://fesagency.pt/ (the "Website"), in accordance with Regulation (EU) 2016/679, the General Data
            Protection Regulation ("GDPR"), and Law no. 58/2019 of 8 August, which ensures its implementation in
            Portugal.
          </p>
          <p>
            You can browse the Website without giving us any personal information. Personal data is only processed
            in the situations described below.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Data Controller</h2>
          <p>
            The controller of your personal data is Press Play, Unipessoal, Lda., trading as FES Agency, with
            headquarters at Praça das Flores, 91, 4.º D, 4300-401 Porto, Portugal, with a share capital of € 500,
            registered at the Commercial Registry Office under the sole registration and tax identification number
            513 906 169 ("FES Agency", "we").
          </p>
          <p>
            For any question about this policy or your personal data, write to
            <a href="mailto:hello@fesagency.pt">hello@fesagency.pt</a>.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">What we process, why, and for how long</h2>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Operating and securing the Website</h3>
            <p>
              When you visit the Website, your browser necessarily sends technical data such as your IP address,
              browser and device type, and the page requested. The Website is hosted on Cloudflare, which processes
              this data to deliver pages and protect the Website against abuse. When a contact message is sent, we
              also keep a counter linked to the sender's IP address for one hour, to limit repeated submissions.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> our legitimate interest in running a
              secure and working website (Article 6(1)(f) GDPR).
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Website statistics</h3>
            <p>
              We use Cloudflare Web Analytics to count page views. It does not use cookies, does not store anything
              on your device and does not track you across websites; we only see aggregated figures, such as how
              many times a page was visited.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> our legitimate interest in understanding
              how the Website is used (Article 6(1)(f) GDPR).
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2" id="contact-requests">
            <h3 class="text-h4 text-ink">Contact requests</h3>
            <p>
              When you use the contact form, we process your name, e-mail address and message to reply to you.
              Before the message is accepted, Cloudflare Turnstile checks that it was sent by a person and not an
              automated program; this check uses technical information about your browser and does not set
              advertising or tracking cookies. The message is delivered to our mailbox by our e-mail provider,
              Resend, and a copy is kept in a log stored on Cloudflare.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> steps taken at your request before a
              possible contract (Article 6(1)(b) GDPR) and, for the spam check, our legitimate interest in keeping
              the form free of abuse (Article 6(1)(f) GDPR).
            </p>
            <p>
              <strong class="font-medium text-ink">Retention:</strong> up to two years from the date you contact
              us, after which the log entry is deleted automatically and the e-mail is deleted from our mailbox. If
              the conversation leads to a working relationship, the data then follows the retention periods of
              that relationship, including those required by tax and accounting law.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2" id="newsletter">
            <h3 class="text-h4 text-ink">Newsletter</h3>
            <p>
              If you subscribe to our newsletter, we process your e-mail address (and any other details you choose
              to give in the signup form) to send you our newsletter and news about our work. The signup form and
              the mailing list are managed by Brevo, which also tells us whether e-mails are delivered and opened,
              so we can improve them.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> your consent (Article 6(1)(a) GDPR), which
              you can withdraw at any time through the unsubscribe link in every e-mail or by writing to us.
              Withdrawing it does not affect the lawfulness of what was sent before.
              <strong class="font-medium text-ink">Retention:</strong> until you unsubscribe, after which your
              address is removed from the list and kept only on a suppression list, so that we never write to you
              again by mistake.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Booking a call</h3>
            <p>
              The "book a call" links take you to a Google Calendar booking page, where you enter your name and
              e-mail address to schedule a meeting with us. That data is processed by Google on our behalf and
              added to our calendar.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> steps taken at your request before a
              possible contract (Article 6(1)(b) GDPR). <strong class="font-medium text-ink">Retention:</strong> up
              to two years from the meeting, under the same rule as contact requests.
            </p>
          </div>

          <div class="flex flex-col gap-2 pt-2">
            <h3 class="text-h4 text-ink">Job applications</h3>
            <p>
              Applications are submitted through a Google Form linked from our Careers page. We process the
              information you choose to send (such as your name, contact details, CV and portfolio) to assess your
              application.
            </p>
            <p>
              <strong class="font-medium text-ink">Lawful basis:</strong> steps taken at your request before a
              possible employment contract (Article 6(1)(b) GDPR).
              <strong class="font-medium text-ink">Retention:</strong> up to twelve months from the date of your
              application, so we can consider you for roles that fit your profile. You can ask us to delete it
              sooner at any time.
            </p>
          </div>

          <p class="pt-2">
            Apart from the newsletter you choose to subscribe to, we do not use your data for marketing. We do not sell it, and we do not make decisions about you based
            solely on automated processing, including profiling. We do not ask for, and ask you not to send, special
            categories of data (such as health data or data revealing racial or ethnic origin, political opinions or
            religious beliefs).
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Who receives your data</h2>
          <p>
            Your data is accessed only by FES Agency staff who need it for the purposes above. We use the following
            service providers ("processors"), bound by data processing agreements that require them to protect your
            data and use it only on our instructions:
          </p>
          <ul class="list-disc pl-6">
            <li>Cloudflare — website hosting, security, spam checks (Turnstile), statistics and storage of contact requests;</li>
            <li>Resend — delivery of contact-form messages to our mailbox;</li>
            <li>Brevo (Sendinblue SAS, France) — newsletter signup form, mailing list and sending;</li>
            <li>Google — call booking (Google Calendar) and job applications (Google Forms).</li>
          </ul>
          <p>
            Some of these providers are established in, or may access data from, the United States. Those transfers
            rely on the EU–US Data Privacy Framework where the provider is certified under it, or otherwise on the
            Standard Contractual Clauses approved by the European Commission (Articles 45 and 46 GDPR).
          </p>
          <p>
            We may also disclose data where required by law, by a decision of the Comissão Nacional de Proteção de
            Dados ("CNPD") or another competent authority, or by a court order.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Third-party content and social networks</h2>
          <p>
            Some pages offer videos and podcasts hosted by YouTube and Spotify. These players are not loaded until
            you click on them; once loaded, the provider processes your data under its own privacy policy. The same
            applies when you follow a link to our social network profiles or to other websites: we are not
            responsible for their privacy practices and recommend that you read their policies.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Your rights</h2>
          <p>
            You have the right to access, rectify and erase your personal data, to restrict or object to its
            processing (including processing based on our legitimate interests), and to data portability, under the
            conditions set out in Articles 15 to 22 GDPR.
          </p>
          <p>
            To exercise any of these rights, write to <a href="mailto:hello@fesagency.pt">hello@fesagency.pt</a>. We
            will reply within one month, which may be extended by two further months for complex requests, in which
            case we will tell you why. We may ask you to confirm your identity before acting on a request.
          </p>
          <p>
            You also have the right to lodge a complaint with the Portuguese supervisory authority, the CNPD
            (<a href="https://www.cnpd.pt/" target="_blank" rel="noopener noreferrer">www.cnpd.pt</a>), without
            prejudice to any other administrative or judicial remedy.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Cookies</h2>
          <p>
            This Website does not use advertising or analytics cookies. Read our <a href="/cookies-policy/">Cookies Policy</a>
            for the details of what is, and is not, stored on your device.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Security</h2>
          <p>
            We apply technical and organisational measures appropriate to the risk to protect your personal data
            against loss, misuse, unauthorised access, disclosure or alteration, including encrypted connections
            (HTTPS) across the whole Website, access to personal data restricted to the people who need it, and the
            automatic deletion of contact requests at the end of their retention period.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-h3 text-ink">Updates to this Privacy Policy</h2>
          <p>
            We may update this Privacy Policy to reflect changes to the Website or to the law. The current version
            is always published on this page, with the date of its last update.
          </p>
          <p class="text-ink-muted">Date of last update: 28/09/2026</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
