{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fes-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "fes-preview-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "dist"
      ],
      "port": 4173
    },
    {
      "name": "fes-preview-gzip",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "dist",
        "-l",
        "4174",
        "--no-clipboard"
      ],
      "port": 4174
    }
  ]
}
