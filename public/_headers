# Cloudflare Pages headers. Two concerns live here: the security baseline
# every response carries, and the cache policy for files served under the
# name they were authored with (nothing hashed).

# ---------- Security baseline, every response ----------
#
# frame-ancestors 'none' + X-Frame-Options DENY: nothing embeds this site,
# so nothing may frame it (the older header is for browsers that predate
# CSP's directive). A full Content-Security-Policy is deliberately NOT set
# yet: the hero's viewport-measuring script and the JSON-LD blocks are
# inline, and the analytics beacon is a third-party script, so a real policy
# needs nonces or hashes wired through the layout first — a half-strict CSP
# that has to allow 'unsafe-inline' buys nothing.
#
# HSTS is max-age only, no includeSubDomains: other fesagency.pt subdomains
# are not this project's to commit to HTTPS. Bump to a year + preload once
# the zone has run on HTTPS long enough to be sure.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# ---------- Cache policy ----------
#
# Everything under /_astro/ is content-hashed by Astro, so a year + immutable
# is free there. (The Cloudflare adapter used to append this rule at build
# time; with the adapter gone it lives here.)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The paths below are public/ files served under the exact name they were
# authored with. That rules out `immutable` for anything that can be
# re-exported in place, because a client that cached it has no way to learn
# it changed. Without any rule at all the platform serves them
# `max-age=0, must-revalidate`, so every navigation pays a conditional
# request per font, icon and photo — which is the actual cost being fixed
# here, not the transfer.
#
# Two tiers:
#   - fonts: a year, immutable. A font file is replaced by shipping a new
#     name, never by overwriting this one (the @font-face src in global.css
#     has to change either way).
#   - everything else: a week, plus a month of stale-while-revalidate, so a
#     re-baked hero still reaches people within days without any navigation
#     ever blocking on revalidation.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/hero/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/fes-logo-white.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/fes-logo-dark.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og-default.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
